@model AutoRepairERD.Models.Customer
@{
    ViewData["Title"] = "Edit Customer";
    ViewData["ActiveNav"] = "customers";
}

@section TopbarActions {
    <a asp-action="Details" asp-route-id="@Model.CustomerId" class="btn-outline btn-sm">← Back</a>
}

<div class="card" style="max-width:640px">
  <div class="card-header"><span class="card-title">Edit — @Model.FirstName @Model.LastName</span></div>
  <form asp-action="Edit" method="post">
    <input type="hidden" asp-for="CustomerId" />
    <input type="hidden" asp-for="CreatedByUserId" />
    <input type="hidden" asp-for="CreatedAt" />
    <div asp-validation-summary="ModelOnly" class="td-muted" style="font-size:13px;color:var(--red);margin-bottom:10px"></div>
    <div class="form-row-2">
      <div class="form-group"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control" /><span asp-validation-for="FirstName" class="td-muted" style="color:var(--red);font-size:12px"></span></div>
      <div class="form-group"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control" /></div>
    </div>
    <div class="form-row-2">
      <div class="form-group"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" type="tel" /><span asp-validation-for="Phone" class="td-muted" style="color:var(--red);font-size:12px"></span></div>
      <div class="form-group"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" type="email" /><span asp-validation-for="Email" class="td-muted" style="color:var(--red);font-size:12px"></span></div>
    </div>
    <div class="form-group"><label asp-for="City" class="form-label"></label><input asp-for="City" class="form-control" /></div>
    <div class="form-group"><label asp-for="Address" class="form-label"></label><textarea asp-for="Address" class="form-control" rows="2"></textarea></div>
    <div style="display:flex;gap:10px;margin-top:6px">
      <button type="submit" class="btn-gold">Save Changes</button>
      <a asp-action="Details" asp-route-id="@Model.CustomerId" class="btn-outline btn-sm">Cancel</a>
    </div>
  </form>
</div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
