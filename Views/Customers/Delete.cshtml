@model AutoRepairERD.Models.Customer

@{
    ViewData["Title"] = "Delete Customer";
}

<div class="container py-4">
  <div class="card">
    <div class="card-header">
      <h2>Delete Customer</h2>
    </div>
    <div class="card-body">
      <p class="text-danger">Are you sure you want to delete this customer?</p>

      <dl class="row mb-3">
        <dt class="col-sm-3">Full Name</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.FirstName) @Html.DisplayFor(m => m.LastName)</dd>

        <dt class="col-sm-3">Contact</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.Phone) <br /> @Html.DisplayFor(m => m.Email)</dd>

        <dt class="col-sm-3">Address</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.Address) @if(!string.IsNullOrWhiteSpace(Model?.City)){<span>, @Html.DisplayFor(m => m.City)</span>}</dd>

        <dt class="col-sm-3">Created At</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.CreatedAt)</dd>

        <dt class="col-sm-3">Created By</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.CreatedByUser)</dd>
      </dl>

      <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="CustomerId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
      </form>
    </div>
  </div>
</div>
