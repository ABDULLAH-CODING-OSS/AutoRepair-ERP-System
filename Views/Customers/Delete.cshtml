@model AutoRepairERD.Models.Customer
@{
    ViewData["Title"] = "Delete Customer";
    ViewData["ActiveNav"] = "customers";
}

<div class="card" style="max-width:500px;margin:0 auto;text-align:center;padding:32px">
  <div style="width:56px;height:56px;border-radius:50%;background:var(--red-dim);display:flex;align-items:center;justify-content:center;margin:0 auto 16px">
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--red)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6l-1 14H6L5 6"></path><path d="M10 11v6"></path><path d="M14 11v6"></path></svg>
  </div>
  <div class="card-title" style="font-size:18px;margin-bottom:6px">Delete Customer?</div>
  <p style="color:var(--text2);font-size:13px;margin-bottom:6px"><strong style="color:var(--text)">@Model.FirstName @Model.LastName</strong></p>
  <p style="color:var(--red);font-size:12px;margin-bottom:24px">This will permanently delete the customer record. This cannot be undone.</p>
  <form asp-action="Delete" method="post" style="display:flex;gap:10px;justify-content:center">
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="CustomerId" />
    <button type="submit" class="btn-danger">Yes, Delete</button>
    <a asp-action="Index" class="btn-outline btn-sm">Cancel</a>
  </form>
</div>
