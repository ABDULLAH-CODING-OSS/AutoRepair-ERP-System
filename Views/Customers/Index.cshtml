@model IEnumerable<AutoRepairERD.Models.Customer>

@{
    ViewData["Title"] = "Customers";
}

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Customers</h1>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
  </div>

  <div class="card">
    <div class="card-body p-0">
      <table class="table mb-0 table-striped">
        <thead class="table-light">
          <tr>
            <th>Full Name</th>
            <th>@Html.DisplayNameFor(model => model.Phone)</th>
            <th>@Html.DisplayNameFor(model => model.Email)</th>
            <th>@Html.DisplayNameFor(model => model.City)</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
@foreach (var item in Model) {
          <tr>
            <td>@item.FirstName @item.LastName</td>
            <td>@Html.DisplayFor(_ => item.Phone)</td>
            <td>@Html.DisplayFor(_ => item.Email)</td>
            <td>@Html.DisplayFor(_ => item.City)</td>
            <td class="text-end">
              <a asp-action="Edit" asp-route-id="@item.CustomerId" class="btn btn-sm btn-outline-primary me-1">Edit</a>
              <a asp-action="Details" asp-route-id="@item.CustomerId" class="btn btn-sm btn-outline-secondary me-1">Details</a>
              <a asp-action="Delete" asp-route-id="@item.CustomerId" class="btn btn-sm btn-outline-danger">Delete</a>
            </td>
          </tr>
}
        </tbody>
      </table>
    </div>
  </div>
</div>
