@model IEnumerable<AutoRepairERD.Models.Customer>
@{
    ViewData["Title"] = "Customers";
    ViewData["ActiveNav"] = "customers";
}

@section TopbarActions {
    <a asp-action="Create" class="btn-gold btn-sm">+ Add Customer</a>
}

<div class="card">
  <div class="card-header">
    <span class="card-title">All Customers (@Model.Count())</span>
    <form method="get" style="margin-left:auto;display:flex;gap:8px;align-items:center">
      <input type="search" name="q" value="@(ViewBag.SearchQuery ?? "")" placeholder="Search name, phone or email" class="form-control" style="width:260px;padding:8px 10px">
      <button type="submit" class="btn-outline btn-sm">Search</button>
    </form>
  </div>
  <div class="table-wrap"><table class="erp-table">
    <thead>
      <tr><th>Name</th><th>Phone</th><th>Email</th><th>City</th><th>Vehicles</th><th>Registered</th><th></th></tr>
    </thead>
    <tbody>
      @if (!Model.Any())
      {
          <tr><td colspan="7" class="td-muted" style="text-align:center;padding:24px">No customers registered yet.</td></tr>
      }
      @foreach (var c in Model)
      {
          <tr onclick="carTransition('/Customers/Details/@c.CustomerId','CUSTOMER DETAIL')">
            <td class="td-gold">@c.FirstName @c.LastName</td>
            <td>@c.Phone</td>
            <td class="td-muted">@c.Email</td>
            <td>@c.City</td>
            <td><span class="badge badge-neutral">@c.Vehicles.Count</span></td>
            <td class="td-muted">@(c.CreatedAt?.ToString("MMM d, yyyy"))</td>
            <td style="white-space:nowrap">
              <a asp-action="Details" asp-route-id="@c.CustomerId" class="btn-outline btn-sm">View</a>
              <a asp-action="Edit" asp-route-id="@c.CustomerId" class="btn-outline btn-sm">Edit</a>
              <a asp-action="Delete" asp-route-id="@c.CustomerId" class="btn-outline btn-sm" style="color:var(--red)">Delete</a>
            </td>
          </tr>
      }
    </tbody>
  </table></div>
</div>
