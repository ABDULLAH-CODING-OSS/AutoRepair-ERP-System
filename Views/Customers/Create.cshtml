@model AutoRepairERD.Models.Customer

@{
    ViewData["Title"] = "Create Customer";
}

<div class="container py-4">
  <div class="card">
    <div class="card-header">
      <h2>Create Customer</h2>
    </div>
    <div class="card-body">
      <form asp-action="Create" method="post">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="row g-3">
          <div class="col-md-6">
            <label asp-for="FirstName" class="form-label"></label><span class="text-danger">*</span>
            <input asp-for="FirstName" class="form-control" placeholder="Given name (required)" />
            <div class="text-danger"><span asp-validation-for="FirstName"></span></div>
          </div>
          <div class="col-md-6">
            <label asp-for="LastName" class="form-label"></label>
            <input asp-for="LastName" class="form-control" placeholder="Family name (optional)" />
            <div class="text-danger"><span asp-validation-for="LastName"></span></div>
          </div>
        </div>

        <div class="row g-3 mt-2">
          <div class="col-md-4">
            <label asp-for="Phone" class="form-label"></label><span class="text-danger">*</span>
            <input asp-for="Phone" class="form-control" type="tel" placeholder="e.g. +1-555-555-5555" />
            <div class="text-danger"><span asp-validation-for="Phone"></span></div>
          </div>
          <div class="col-md-8">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" type="email" placeholder="name@example.com" />
            <div class="text-danger"><span asp-validation-for="Email"></span></div>
          </div>
        </div>

        <div class="mt-3">
          <label asp-for="Address" class="form-label"></label>
          <textarea asp-for="Address" class="form-control" rows="2" placeholder="Street address, apartment, suite, unit..."></textarea>
          <div class="text-danger"><span asp-validation-for="Address"></span></div>
        </div>

        <div class="mt-3">
          <label asp-for="City" class="form-label"></label>
          <input asp-for="City" class="form-control" placeholder="City or locality" />
          <div class="text-danger"><span asp-validation-for="City"></span></div>
        </div>

        <div class="mt-4 d-flex gap-2">
          <button type="submit" class="btn btn-primary">Create</button>
          <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
      </form>

    </div>
  </div>
</div>

@{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
