@model AutoRepairERD.Models.Customer
@{
    ViewData["Title"] = "Customer — " + Model.FirstName + " " + Model.LastName;
    ViewData["ActiveNav"] = "customers";
}

@section TopbarActions {
    <a asp-action="Edit" asp-route-id="@Model.CustomerId" class="btn-gold btn-sm">Edit</a>
    <a asp-action="Delete" asp-route-id="@Model.CustomerId" class="btn-outline btn-sm" style="color:var(--red)">Delete</a>
    <a asp-action="Index" class="btn-outline btn-sm">← Back</a>
}

<div class="grid-2" style="margin-bottom:20px">
  <div class="card">
    <div class="card-header"><span class="card-title">Customer Info</span></div>
    <div style="display:flex;flex-direction:column;gap:10px;padding-top:6px">
      <div><label class="form-label">Full Name</label><p style="font-size:14px;font-weight:600">@Model.FirstName @Model.LastName</p></div>
      <div><label class="form-label">Phone</label><p style="font-size:14px">@Model.Phone</p></div>
      <div><label class="form-label">Email</label><p style="font-size:14px">@(Model.Email ?? "—")</p></div>
      <div><label class="form-label">City</label><p style="font-size:14px">@(Model.City ?? "—")</p></div>
      <div><label class="form-label">Address</label><p style="font-size:14px;color:var(--text2)">@(Model.Address ?? "—")</p></div>
      <div><label class="form-label">Registered</label><p style="font-size:13px;color:var(--text2)">@(Model.CreatedAt?.ToString("MMM d, yyyy h:mm tt"))</p></div>
    </div>
  </div>
  <div class="card">
    <div class="card-header"><span class="card-title">Vehicles (@Model.Vehicles.Count)</span>
    <a asp-controller="Vehicles" asp-action="Create" class="btn-gold btn-sm">+ Add Vehicle</a></div>
    @if (!Model.Vehicles.Any())
    {
        <p class="td-muted" style="padding:16px;font-size:13px">No vehicles registered for this customer.</p>
    }
    <div class="table-wrap"><table class="erp-table">
      <thead><tr><th>Make</th><th>Model</th><th>Year</th><th>Plate</th></tr></thead>
      <tbody>
        @foreach (var v in Model.Vehicles)
        {
            <tr onclick="carTransition('/Vehicles/Details/@v.VehicleId','VEHICLE DETAIL')">
                            <td class="td-gold">@v.Make</td>
                            <td>@v.Model</td>
                            <td>@v.ManufacturingYear</td>
                            <td>@v.LicensePlate</td>
            </tr>
        }
      </tbody>
    </table></div>
  </div>
</div>

<div class="card">
  <div class="card-header"><span class="card-title">Job Orders</span><a asp-controller="JobOrders" asp-action="Create" class="btn-gold btn-sm">+ New Job</a></div>
  <div class="table-wrap"><table class="erp-table">
    <thead><tr><th>Job #</th><th>Vehicle</th><th>Status</th><th>Final Cost</th><th>Date</th></tr></thead>
    <tbody>
      @if (!Model.JobOrders.Any())
      {
          <tr><td colspan="5" class="td-muted" style="text-align:center;padding:20px">No job orders yet.</td></tr>
      }
      @foreach (var j in Model.JobOrders)
      {
          <tr onclick="carTransition('/JobOrders/Details/@j.JobOrderId','JOB DETAIL')">
            <td class="td-gold">@j.JobNumber</td>
            <td>@j.Vehicle?.Make @j.Vehicle?.Model</td>
            <td><span class="badge @BadgeHelper.Css(j.Status)">@j.Status</span></td>
            <td>PKR @((j.FinalCost ?? j.EstimatedCost ?? 0).ToString("N0"))</td>
            <td class="td-muted">@(j.CreatedAt?.ToString("MMM d, yyyy"))</td>
          </tr>
      }
    </tbody>
  </table></div>
</div>
