@model AutoRepairERD.Models.Invoice

@{
    ViewData["Title"] = "Create Invoice";
}

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Generate Invoice</h5>
    </div>
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label class="form-label">Job Order <span class="text-danger">*</span></label>
                <select asp-for="JobOrderId" class="form-select" asp-items="ViewBag.JobOrders"></select>
                <span asp-validation-for="JobOrderId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TaxAmount" class="form-label">Tax Amount</label>
                <input asp-for="TaxAmount" class="form-control" />
                <span asp-validation-for="TaxAmount" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DiscountAmount" class="form-label">Discount Amount</label>
                <input asp-for="DiscountAmount" class="form-control" />
                <span asp-validation-for="DiscountAmount" class="text-danger"></span>
            </div>

            <div>
                <button type="submit" class="btn btn-primary">Create Invoice</button>
                <a class="btn btn-secondary ms-2" asp-action="Index">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
