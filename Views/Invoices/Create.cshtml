@model AutoRepairERD.Models.Invoice

@{
    ViewData["Title"] = "Create Invoice";
}

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Generate Invoice</h5>
    </div>
    <div style="padding:4px 0">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div style="margin-bottom:12px">
                <label class="form-label">Job Order <span style="color:var(--red)">*</span></label>
                <select asp-for="JobOrderId" class="form-control" asp-items="ViewBag.JobOrders"></select>
                <span asp-validation-for="JobOrderId" style="color:var(--red)"></span>
            </div>

            <div style="margin-bottom:12px">
                <label asp-for="TaxAmount" class="form-label">Tax Amount</label>
                <input asp-for="TaxAmount" class="form-control" />
                <span asp-validation-for="TaxAmount" style="color:var(--red)"></span>
            </div>

            <div style="margin-bottom:12px">
                <label asp-for="DiscountAmount" class="form-label">Discount Amount</label>
                <input asp-for="DiscountAmount" class="form-control" />
                <span asp-validation-for="DiscountAmount" style="color:var(--red)"></span>
            </div>

            <div>
                <button type="submit" class="btn-gold btn-sm">Create Invoice</button>
                <a class="btn btn-secondary ms-2" asp-action="Index">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
