@model IEnumerable<AutoRepairERD.Models.Invoice>
@{ ViewData["Title"] = "Invoices"; ViewData["ActiveNav"] = "invoices"; }

@section TopbarActions { <a asp-action="Create" class="btn-gold btn-sm">+ New Invoice</a> }

<div class="card">
  <div class="card-header"><span class="card-title">All Invoices (@Model.Count())</span>
    <form method="get" style="margin-left:auto;display:flex;gap:8px;align-items:center">
      <input type="search" name="q" value="@(ViewBag.SearchQuery ?? "")" placeholder="Search invoice, job #, customer, status" class="form-control" style="width:360px;padding:8px 10px">
      <button type="submit" class="btn-outline btn-sm">Search</button>
    </form>
  </div>
  <div class="table-wrap"><table class="erp-table">
    <thead><tr><th>Invoice #</th><th>Job #</th><th>Customer</th><th>Date</th><th>Total</th><th>Paid</th><th>Remaining</th><th>Payment</th><th></th></tr></thead>
    <tbody>
      @if (!Model.Any()) { <tr><td colspan="9" class="td-muted" style="text-align:center;padding:24px">No invoices yet.</td></tr> }
      @foreach (var inv in Model)
      {
          <tr onclick="carTransition('/Invoices/Details/@inv.InvoiceId','INVOICE DETAIL')">
            <td class="td-gold">@inv.InvoiceNumber</td>
            <td>@inv.JobOrder?.JobNumber</td>
            <td>@inv.JobOrder?.Customer?.FirstName @inv.JobOrder?.Customer?.LastName</td>
            <td class="td-muted">@(inv.InvoiceDate?.ToString("MMM d, yyyy"))</td>
            <td><strong>PKR @inv.GrandTotal.ToString("N0")</strong></td>
            <td>PKR @inv.AmountPaid.ToString("N2")</td>
            <td>PKR @inv.RemainingBalance.ToString("N2")</td>
            <td><span class="badge @BadgeHelper.Css(inv.PaymentStatus)">@(inv.PaymentStatus ?? "Unpaid")</span></td>
            <td style="white-space:nowrap">
              <a asp-action="Details" asp-route-id="@inv.InvoiceId" class="btn-outline btn-sm">View</a>
              <a asp-action="Edit" asp-route-id="@inv.InvoiceId" class="btn-outline btn-sm">Edit</a>
            </td>
          </tr>
      }
    </tbody>
  </table></div>
</div>
