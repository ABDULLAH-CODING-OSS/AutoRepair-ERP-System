@model IEnumerable<AutoRepairERD.Models.Invoice>

@{
    ViewData["Title"] = "Invoices";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">Invoices</h1>
    <a class="btn btn-success" asp-action="Create">Create Invoice</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-light">
            <tr>
                <th>Job #</th>
                <th>Invoice #</th>
                <th>Invoice Date</th>
                <th class="text-end">Subtotal</th>
                <th class="text-end">Tax</th>
                <th class="text-end">Discount</th>
                <th class="text-end">Grand Total</th>
                <th>Status</th>
                <th>Payment</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@(item.JobOrder?.JobNumber ?? "-")</td>
                <td>@item.InvoiceNumber</td>
                <td>@(item.InvoiceDate != null ? (item.InvoiceDate is System.DateTime dt ? dt.ToString("d") : item.InvoiceDate.ToString()) : "-")</td>
                <td class="text-end">@((item.SubTotal != null) ? string.Format(System.Globalization.CultureInfo.CurrentCulture, "{0:C}", item.SubTotal) : "-")</td>
                <td class="text-end">@((item.TaxAmount != null) ? string.Format(System.Globalization.CultureInfo.CurrentCulture, "{0:C}", item.TaxAmount) : "-")</td>
                <td class="text-end">@((item.DiscountAmount != null) ? string.Format(System.Globalization.CultureInfo.CurrentCulture, "{0:C}", item.DiscountAmount) : "-")</td>
                <td class="text-end">@((item.GrandTotal != null) ? string.Format(System.Globalization.CultureInfo.CurrentCulture, "{0:C}", item.GrandTotal) : "-")</td>
                <td>
                    @if (!string.IsNullOrEmpty(item.InvoiceStatus))
                    {
                        <span class="badge bg-info text-dark">@item.InvoiceStatus</span>
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </td>
                <td>
                    @if (!string.IsNullOrEmpty(item.PaymentStatus))
                    {
                        <span class="badge bg-secondary">@item.PaymentStatus</span>
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </td>
                <td>
                    <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@item.InvoiceId">Edit</a>
                    <a class="btn btn-sm btn-info text-white ms-1" asp-action="Details" asp-route-id="@item.InvoiceId">Details</a>
                    <a class="btn btn-sm btn-danger ms-1" asp-action="Delete" asp-route-id="@item.InvoiceId">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
