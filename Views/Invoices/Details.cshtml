@model AutoRepairERD.Models.Invoice

@{
    ViewData["Title"] = "Details";
}

<div class="card">
    <div class="card-header">
        <h4>Invoice @Model?.InvoiceNumber</h4>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <p><strong>Job Order:</strong> @Html.DisplayFor(m => m.JobOrderId)</p>
                <p><strong>Invoice Date:</strong> @Html.DisplayFor(m => m.InvoiceDate)</p>
                <p><strong>Status:</strong> @Html.DisplayFor(m => m.InvoiceStatus)</p>
                <p><strong>Payment Status:</strong> @Html.DisplayFor(m => m.PaymentStatus)</p>
            </div>
            <div class="col-md-6 text-end">
                <p><strong>Parts Total:</strong> @(ViewBag.PartsTotal != null ? ((decimal)ViewBag.PartsTotal).ToString("C") : "-")</p>
                <p><strong>Services Total:</strong> @(ViewBag.ServicesTotal != null ? ((decimal)ViewBag.ServicesTotal).ToString("C") : "-")</p>
                <p><strong>Subtotal:</strong> @(Model.SubTotal.HasValue ? Model.SubTotal.Value.ToString("C") : "-")</p>
                <p><strong>Tax:</strong> @(Model.TaxAmount.HasValue ? Model.TaxAmount.Value.ToString("C") : "-")</p>
                <p><strong>Discount:</strong> @(Model.DiscountAmount.HasValue ? Model.DiscountAmount.Value.ToString("C") : "-")</p>
                <h5><strong>Grand Total:</strong> @Model.GrandTotal.ToString("C")</h5>
            </div>
        </div>
    </div>
    <div class="card-footer">
        <a asp-action="Edit" asp-route-id="@Model?.InvoiceId" class="btn btn-primary">Edit</a>
        <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
    </div>
</div>
