@model AutoRepairERD.Models.Invoice

@{
    ViewData["Title"] = "Details";
}

<div class="card">
    <div class="card-header">
        <h4>Invoice @Model?.InvoiceNumber</h4>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <p><strong>Job Number:</strong> @(Model?.JobOrder?.JobNumber ?? "-")</p>
                <p><strong>Customer:</strong> @(Model?.JobOrder?.Customer != null ? Model.JobOrder.Customer.FirstName + " " + Model.JobOrder.Customer.LastName : "-")</p>
                <p><strong>Vehicle:</strong> @(Model?.JobOrder?.Vehicle != null ? Model.JobOrder.Vehicle.Make + " " + Model.JobOrder.Vehicle.Model + " - " + Model.JobOrder.Vehicle.LicensePlate : "-")</p>
                <p><strong>Invoice Date:</strong> @((Model != null && Model.InvoiceDate.HasValue) ? Model.InvoiceDate.Value.ToString("g") : "-")</p>
                <p><strong>Status:</strong> @(Model?.InvoiceStatus ?? "-")</p>
                <p><strong>Payment Status:</strong> @(Model?.PaymentStatus ?? "-")</p>
            </div>
            <div class="col-md-6 text-end">
                <p><strong>Parts Total:</strong> @(ViewBag.PartsTotal != null ? ((decimal)ViewBag.PartsTotal).ToString("C") : "-")</p>
                <p><strong>Services Total:</strong> @(ViewBag.ServicesTotal != null ? ((decimal)ViewBag.ServicesTotal).ToString("C") : "-")</p>
                <p><strong>Subtotal:</strong> @(Model.SubTotal.HasValue ? Model.SubTotal.Value.ToString("C") : "-")</p>
                <p><strong>Tax:</strong> @(Model.TaxAmount.HasValue ? Model.TaxAmount.Value.ToString("C") : "-")</p>
                <p><strong>Discount:</strong> @(Model.DiscountAmount.HasValue ? Model.DiscountAmount.Value.ToString("C") : "-")</p>
                <h5><strong>Grand Total:</strong> @Model.GrandTotal.ToString("C")</h5>
            </div>
        </div>
    </div>
    <div class="card-footer">
        <a asp-action="Edit" asp-route-id="@Model?.InvoiceId" class="btn btn-primary">Edit</a>
        <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
    </div>
</div>
