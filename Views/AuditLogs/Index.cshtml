@model IEnumerable<AutoRepairERD.Models.AuditLog>
@{ ViewData["Title"] = "Audit Log"; ViewData["ActiveNav"] = "audit"; }

<div class="card">
  <div class="card-header"><span class="card-title">Audit Log (@Model.Count())</span>
    <form method="get" style="margin-left:auto;display:flex;gap:8px;align-items:center">
      <input type="search" name="q" value="@(ViewBag.SearchQuery ?? "")" placeholder="Search table, action or user" class="form-control" style="width:320px;padding:8px 10px">
      <button type="submit" class="btn-outline btn-sm">Search</button>
    </form>
  </div>
  <div class="table-wrap"><table class="erp-table">
    <thead><tr><th>Date</th><th>User</th><th>Table</th><th>Action</th><th>Record ID</th><th>IP</th><th></th></tr></thead>
    <tbody>
      @if (!Model.Any()) { <tr><td colspan="7" class="td-muted" style="text-align:center;padding:24px">No audit events recorded.</td></tr> }
      @foreach (var a in Model)
      {
          <tr>
            <td class="td-muted">@(a.ActionDate?.ToString("MMM d, yyyy HH:mm"))</td>
            <td>@(a.User?.Username ?? "System")</td>
            <td class="td-gold">@a.TableName</td>
            <td><span class="badge badge-neutral">@a.ActionType</span></td>
            <td class="td-muted">#@a.RecordId</td>
            <td class="td-muted" style="font-size:11px">@a.Ipaddress</td>
            <td><a asp-action="Details" asp-route-auditlogid="@a.AuditLogId" class="btn-outline btn-sm">View</a></td>
          </tr>
      }
    </tbody>
  </table></div>
</div>
