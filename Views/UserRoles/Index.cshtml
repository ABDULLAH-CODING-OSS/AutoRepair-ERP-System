@model IEnumerable<AutoRepairERD.Models.UserRole>

@{
    ViewData["Title"] = "User Role Assignments";
}

<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between mb-3">
            <h4 class="card-title mb-0">User Role Assignments <small class="text-muted">(@ViewBag.Count)</small></h4>
            <div>
                <a class="btn btn-primary btn-sm" asp-action="Create">Assign Role</a>
            </div>
        </div>

        <form method="get" class="row g-2 mb-3">
            <div class="col-auto">
                <input name="username" value="@(ViewBag.SearchUsername ?? "")" class="form-control form-control-sm" placeholder="Search username" />
            </div>
            <div class="col-auto">
                <input name="fullname" value="@(ViewBag.SearchFullName ?? "")" class="form-control form-control-sm" placeholder="Search full name" />
            </div>
            <div class="col-auto">
                @if (ViewBag.Roles != null)
                {
                    var _roles = (SelectList)ViewBag.Roles;
                    <select name="roleId" class="form-select form-select-sm">
                        <option value="">All Roles</option>
                        @foreach (var r in _roles)
                        {
                            if (r.Selected)
                            {
                                <option value="@r.Value" selected>@r.Text</option>
                            }
                            else
                            {
                                <option value="@r.Value">@r.Text</option>
                            }
                        }
                    </select>
                }
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-secondary btn-sm">Filter</button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-striped table-sm">
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Full Name</th>
                        <th>Role</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.User?.Username</td>
                            <td>@item.User?.FullName</td>
                            <td>@item.Role?.RoleName</td>
                            <td>
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.UserRoleId">Edit</a>
                                <a class="btn btn-sm btn-outline-secondary ms-1" asp-action="Details" asp-route-id="@item.UserRoleId">Details</a>
                                <a class="btn btn-sm btn-outline-danger ms-1" asp-action="Delete" asp-route-id="@item.UserRoleId">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
