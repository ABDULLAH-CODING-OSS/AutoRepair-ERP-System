@model IEnumerable<AutoRepairERD.Models.UserRole>
@{ ViewData["Title"] = "User Role Assignments"; ViewData["ActiveNav"] = "roles"; }

@section TopbarActions { <a asp-action="Create" class="btn-gold btn-sm">+ Assign Role</a> }

<div class="card">
  <div class="card-header"><span class="card-title">User Role Assignments (@ViewBag.Count)</span></div>
  <div class="table-wrap">
    <form method="get" style="display:flex;gap:8px;align-items:center;padding:10px">
      <input name="username" value="@(ViewBag.SearchUsername ?? "")" class="form-control" placeholder="Username" style="width:180px" />
      <input name="fullname" value="@(ViewBag.SearchFullName ?? "")" class="form-control" placeholder="Full name" style="width:220px" />
      @if (ViewBag.Roles != null)
      {
        var _roles = (SelectList)ViewBag.Roles;
        <select name="roleId" class="form-control" style="width:180px">
          <option value="">All Roles</option>
          @foreach (var r in _roles)
          {
            if (r.Selected)
            {
                <option value="@r.Value" selected="selected">@r.Text</option>
            }
            else
            {
                <option value="@r.Value">@r.Text</option>
            }
          }
        </select>
      }
      <button type="submit" class="btn-outline btn-sm">Filter</button>
      <a asp-action="Index" class="btn-outline btn-sm">Reset</a>
    </form>

    <table class="erp-table">
      <thead><tr><th>Username</th><th>Full Name</th><th>Role</th><th></th></tr></thead>
      <tbody>
        @if (!Model.Any()) { <tr><td colspan="4" class="td-muted" style="text-align:center;padding:24px">No role assignments.</td></tr> }
        @foreach (var item in Model)
        {
          <tr>
            <td class="td-gold">@item.User?.Username</td>
            <td>@item.User?.FullName</td>
            <td>@item.Role?.RoleName</td>
            <td style="white-space:nowrap">
              <a asp-action="Edit" asp-route-id="@item.UserRoleId" class="btn-outline btn-sm">Edit</a>
              <a asp-action="Details" asp-route-id="@item.UserRoleId" class="btn-outline btn-sm">View</a>
              <a asp-action="Delete" asp-route-id="@item.UserRoleId" class="btn-outline btn-sm" style="color:var(--red)">Delete</a>
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>
