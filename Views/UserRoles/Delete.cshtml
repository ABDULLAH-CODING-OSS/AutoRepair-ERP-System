@model AutoRepairERD.Models.UserRole

@{
    ViewData["Title"] = "Remove Assignment";
}

<div class="card">
    <div style="padding:4px 0">
        <h4 class="card-title">Remove Role Assignment</h4>
        <p>Are you sure you want to remove this role assignment?</p>

        <dl class="row">
            <dt class="col-sm-3">Username</dt>
            <dd class="col-sm-9">@Model.User?.Username</dd>

            <dt class="col-sm-3">Full Name</dt>
            <dd class="col-sm-9">@Model.User?.FullName</dd>

            <dt class="col-sm-3">Role</dt>
            <dd class="col-sm-9">@Model.Role?.RoleName</dd>
        </dl>

        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="UserRoleId" />
            <button type="submit" class="btn-danger btn-sm">Remove Assignment</button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>
