@model AutoRepairERD.Models.UserRole

@{
    ViewData["Title"] = "Assign Role to User";
}

<div class="card">
    <div class="card-body">
        <h4 class="card-title">Assign Role</h4>
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label class="form-label">User</label>
                <select asp-for="UserId" class="form-select" asp-items="ViewBag.Users">
                    <option value="">-- Select user --</option>
                </select>
                <span asp-validation-for="UserId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Role</label>
                <select asp-for="RoleId" class="form-select" asp-items="ViewBag.Roles">
                    <option value="">-- Select role --</option>
                </select>
                <span asp-validation-for="RoleId" class="text-danger"></span>
            </div>

            <div class="d-flex">
                <button type="submit" class="btn btn-primary">Assign Role</button>
                <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
            </div>
        </form>
    </div>
</div>
