@model AutoRepairERD.Models.UserRole

@{
    ViewData["Title"] = "Assignment Details";
}

<div class="card">
    <div class="card-body">
        <h4 class="card-title">Assignment Details</h4>
        <div class="row">
            <div class="col-md-6">
                <h6>User</h6>
                <p><strong>Username:</strong> @Model.User?.Username</p>
                <p><strong>Full Name:</strong> @Model.User?.FullName</p>
                <p><strong>Email:</strong> @Model.User?.Email</p>
                <p><strong>Status:</strong> @(Model.User?.IsActive == true ? "Active" : "Inactive")</p>
            </div>
            <div class="col-md-6">
                <h6>Role</h6>
                <p><strong>Role Name:</strong> @Model.Role?.RoleName</p>
                <p><strong>Description:</strong> @Model.Role?.Description</p>
            </div>
        </div>

        <div class="mt-3">
            <a asp-action="Edit" asp-route-id="@Model?.UserRoleId" class="btn btn-primary">Edit</a>
            <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
        </div>
    </div>
</div>
