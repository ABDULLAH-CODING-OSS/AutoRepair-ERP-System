@model AutoRepairERD.Models.PurchaseOrder

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>PurchaseOrder</h4>
<hr />
@if (TempData["Error"] != null)
{
    <div style="background:var(--red-dim);border:1px solid rgba(240,79,79,0.3);border-radius:8px;padding:12px;color:var(--red);font-size:13px;margin-bottom:12px">@TempData["Error"]</div>
}
<div style="display:flex;gap:16px;flex-wrap:wrap">
    <div style="flex:1;min-width:240px">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" style="color:var(--red)"></div>
            <input type="hidden" asp-for="PurchaseOrderId" />
            <div class="form-group">
                @* <label asp-for="SupplierId" class="control-label"></label>
                <input asp-for="SupplierId" class="form-control" />
                <span asp-validation-for="SupplierId" style="color:var(--red)"></span> *@
                <label class="control-label">Supplier</label>
                <select asp-for="SupplierId"
                        class="form-control"
                        asp-items="ViewBag.Suppliers">
                </select>
                <span asp-validation-for="SupplierId" style="color:var(--red)"></span>
            </div>
            @* <div class="form-group">
                <label asp-for="CreatedByUserId" class="control-label"></label>
                <input asp-for="CreatedByUserId" class="form-control" />
                <span asp-validation-for="CreatedByUserId" style="color:var(--red)"></span>
            </div>
            <div class="form-group">
                <label asp-for="OrderDate" class="control-label"></label>
                <input asp-for="OrderDate" class="form-control" />
                <span asp-validation-for="OrderDate" style="color:var(--red)"></span>
            </div> *@
            <div class="form-group">
                <label asp-for="ExpectedDeliveryDate" class="control-label"></label>
                @* <input asp-for="ExpectedDeliveryDate" class="form-control" /> *@
                <input asp-for="ExpectedDeliveryDate"
                       type="date"
                       class="form-control" />
                <span asp-validation-for="ExpectedDeliveryDate" style="color:var(--red)"></span>
            </div>
            <div class="form-group">
                <label asp-for="Status" class="control-label"></label>
                @* <input asp-for="Status" class="form-control" /> *@
                <select asp-for="Status" class="form-control">
                    <option value="Ordered">Ordered</option>
                    <option value="Received">Received</option>
                    <option value="Cancelled">Cancelled</option>
                </select>
                <span asp-validation-for="Status" style="color:var(--red)"></span>
            </div>
            @* TotalAmount is system-calculated and not editable here *@
            @* <div class="form-group">
                <label asp-for="CreatedByUser" class="control-label"></label>
                <input asp-for="CreatedByUser" class="form-control" />
                <span asp-validation-for="CreatedByUser" style="color:var(--red)"></span>
            </div>
            <div class="form-group">
                <label asp-for="PurchaseOrderItems" class="control-label"></label>
                <input asp-for="PurchaseOrderItems" class="form-control" />
                <span asp-validation-for="PurchaseOrderItems" style="color:var(--red)"></span>
            </div>
            <div class="form-group">
                <label asp-for="Supplier" class="control-label"></label>
                <input asp-for="Supplier" class="form-control" />
                <span asp-validation-for="Supplier" style="color:var(--red)"></span>
            </div> *@
            <div class="form-group">
                @if (ViewBag.Locked != null && (bool)ViewBag.Locked)
                {
                    <div style="background:var(--orange-dim);border:1px solid rgba(245,181,56,0.3);border-radius:8px;padding:12px;color:var(--orange);font-size:13px;margin-bottom:12px">This purchase order has been received and cannot be edited.</div>
                    <a asp-action="Index" class="btn-outline btn-sm">Back</a>
                }
                else
                {
                    <input type="submit" value="Save" class="btn-gold btn-sm" />
                }
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
