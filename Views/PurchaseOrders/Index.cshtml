@model IEnumerable<AutoRepairERD.Models.PurchaseOrder>
@{ ViewData["Title"] = "Purchase Orders"; ViewData["ActiveNav"] = "purchase-orders"; }

@section TopbarActions { <a asp-action="Create" class="btn-gold btn-sm">+ New PO</a> }

<div class="card">
  <div class="card-header"><span class="card-title">Purchase Orders (@Model.Count())</span></div>
  <div class="table-wrap"><table class="erp-table">
    <thead><tr><th>PO #</th><th>Supplier</th><th>Order Date</th><th>Expected</th><th>Items</th><th>Total</th><th>Status</th><th></th></tr></thead>
    <tbody>
      @if (!Model.Any()) { <tr><td colspan="8" class="td-muted" style="text-align:center;padding:24px">No purchase orders yet.</td></tr> }
      @foreach (var po in Model)
      {
          <tr onclick="carTransition('/PurchaseOrders/Details/@po.PurchaseOrderId','PO DETAIL')">
            <td class="td-gold">#@po.PurchaseOrderId</td>
            <td>@po.Supplier?.CompanyName</td>
            <td class="td-muted">@(po.OrderDate?.ToString("MMM d, yyyy"))</td>
            <td class="td-muted">@(po.ExpectedDeliveryDate?.ToString("MMM d, yyyy"))</td>
            <td><span class="badge badge-neutral">@po.PurchaseOrderItems.Count</span></td>
            <td>PKR @(po.TotalAmount?.ToString("N0") ?? "—")</td>
            <td><span class="badge @BadgeHelper.Css(po.Status)">@(po.Status ?? "Ordered")</span></td>
            <td style="white-space:nowrap">
              <a asp-action="Details" asp-route-id="@po.PurchaseOrderId" class="btn-outline btn-sm">View</a>
              @if (po.Status != "Received" && po.Status != "Cancelled")
              {
                  <a asp-action="Receive" asp-route-id="@po.PurchaseOrderId" class="btn-gold btn-sm">Receive</a>
              }
            </td>
          </tr>
      }
    </tbody>
  </table></div>
</div>
