@model AutoRepairERD.Models.PurchaseOrder
@{ ViewData["Title"] = "PO #" + Model.PurchaseOrderId; ViewData["ActiveNav"] = "purchase-orders"; }

@section TopbarActions {
  <a asp-action="Edit" asp-route-id="@Model.PurchaseOrderId" class="btn-outline btn-sm">Edit</a>
  @if (Model.Status != "Received" && Model.Status != "Cancelled")
  {
      <a asp-action="Receive" asp-route-id="@Model.PurchaseOrderId" class="btn-gold btn-sm">Receive Goods</a>
      <a href="/PurchaseOrderItems/Create?purchaseOrderId=@Model.PurchaseOrderId" class="btn-gold btn-sm">+ Add Item</a>
  }
  <a asp-action="Index" class="btn-outline btn-sm">← Back</a>
}

<div class="grid-2" style="margin-bottom:20px">
  <div class="card">
    <div class="card-header"><span class="card-title">PO Details</span><span class="badge @BadgeHelper.Css(Model.Status)">@(Model.Status ?? "Ordered")</span></div>
    <div style="display:flex;flex-direction:column;gap:10px;padding-top:6px">
      <div><label class="form-label">Supplier</label><p style="font-size:15px;font-weight:700">@Model.Supplier?.CompanyName</p></div>
      <div><label class="form-label">Contact</label><p style="color:var(--text2);font-size:13px">@Model.Supplier?.ContactPerson — @Model.Supplier?.Phone</p></div>
      <div><label class="form-label">Order Date</label><p>@(Model.OrderDate?.ToString("MMM d, yyyy") ?? "—")</p></div>
      <div><label class="form-label">Expected Delivery</label><p>@(Model.ExpectedDeliveryDate?.ToString("MMM d, yyyy") ?? "—")</p></div>
      <div><label class="form-label">Total Amount</label><p style="font-size:18px;font-weight:800;font-family:'Syne',sans-serif;color:var(--gold)">PKR @(Model.TotalAmount?.ToString("N0") ?? "—")</p></div>
      <div><label class="form-label">Created By</label><p class="td-muted">@(Model.CreatedByUser?.Username ?? "—")</p></div>
    </div>
  </div>
  <div class="card">
    <div class="card-header"><span class="card-title">Line Items (@Model.PurchaseOrderItems.Count)</span></div>
    <div class="table-wrap"><table class="erp-table">
      <thead><tr><th>Part</th><th>Qty</th><th>Unit Cost</th><th>Total</th></tr></thead>
      <tbody>
        @foreach (var item in Model.PurchaseOrderItems)
        {
            <tr>
              <td>@item.Part?.PartName</td>
              <td>@item.Quantity</td>
              <td>PKR @(item.UnitCost?.ToString("N2") ?? "—")</td>
              <td>PKR @(item.TotalCost?.ToString("N0") ?? "—")</td>
              <td style="white-space:nowrap">
                @if (Model.Status != "Received")
                {
                    <a asp-controller="PurchaseOrderItems" asp-action="Edit" asp-route-id="@item.PoitemId" class="btn-outline btn-sm">Edit</a>
                    <a asp-controller="PurchaseOrderItems" asp-action="Delete" asp-route-id="@item.PoitemId" class="btn-outline btn-sm" style="color:var(--red)">Delete</a>
                }
              </td>
            </tr>
        }
      </tbody>
    </table></div>
  </div>
</div>
