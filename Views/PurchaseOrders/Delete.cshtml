@model AutoRepairERD.Models.PurchaseOrder

@{
    ViewData["Title"] = "Delete Purchase Order";
}

<div class="card">
    <div class="card-body">
        <h4 class="card-title">Delete Purchase Order</h4>

        @* Priority warnings: Received first, then has items. Only one warning shown. *@
        @if (Model?.Status == "Received")
        {
            <div class="alert alert-warning">This purchase order has already been received and cannot be deleted.</div>
        }
        else if (Model?.PurchaseOrderItems != null && Model.PurchaseOrderItems.Any())
        {
            <div class="alert alert-warning">This purchase order contains items. Please remove all items before deleting the order.</div>
        }

        <div class="mb-3">
            <h5>Purchase Order Summary</h5>
            <dl class="row">
                <dt class="col-sm-3">Supplier</dt>
                <dd class="col-sm-9">@Model.Supplier?.CompanyName</dd>

                <dt class="col-sm-3">Order Date</dt>
                <dd class="col-sm-9">@(Model.OrderDate?.ToString("dd-MMM-yyyy") ?? "-")</dd>

                <dt class="col-sm-3">Expected Delivery</dt>
                <dd class="col-sm-9">@(Model.ExpectedDeliveryDate?.ToString("dd-MMM-yyyy") ?? "-")</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@Model.Status</dd>

                <dt class="col-sm-3">Purchase Total</dt>
                <dd class="col-sm-9">@String.Format("{0:C}", Model.TotalAmount ?? 0m)</dd>

                <dt class="col-sm-3">Items</dt>
                <dd class="col-sm-9">@(Model.PurchaseOrderItems?.Count() ?? 0)</dd>
            </dl>
        </div>

        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="PurchaseOrderId" />

            <div class="d-flex">
                @* Only allow delete when not received and has no items *@
                @if (Model?.Status != "Received" && (Model?.PurchaseOrderItems == null || !Model.PurchaseOrderItems.Any()))
                {
                    <button type="submit" class="btn btn-danger">Delete Purchase Order</button>
                }
                else
                {
                    <button type="button" class="btn btn-danger" disabled>Delete Purchase Order</button>
                }

                <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
            </div>
        </form>
    </div>
</div>
