@using Microsoft.EntityFrameworkCore
@inject AutoRepairERD.Models.ApplicationDbContext DbContext
@{
    var role = ViewData["UserRole"]?.ToString() ?? "Owner";
    var current = ViewData["ActiveNav"]?.ToString() ?? "";

    var sessionUserId = Context.Session.GetInt32("UserID");
    var unreadNotifCount = sessionUserId.HasValue
        ? await DbContext.Notifications.CountAsync(n => n.UserId == sessionUserId.Value && n.IsRead != true)
        : 0;
    var activeJobOrdersCount = await DbContext.JobOrders.CountAsync(j => j.Status != "Completed" && j.Status != "Cancelled");
}
@functions {
    string Active(string key, string current) => key == current ? "active" : "";
}

