  <div class="theme-dot theme-dot-green"          id="td-green"  onclick="setTheme('green')"  title="Emerald"></div>
  <div class="theme-dot theme-dot-purple"         id="td-purple" onclick="setTheme('purple')" title="Purple"></div>
