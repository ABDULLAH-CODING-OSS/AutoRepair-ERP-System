@model IEnumerable<AutoRepairERD.Models.Payment>

@{
    ViewData["Title"] = "Payments";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">Payments</h1>
    <a class="btn btn-success" asp-action="Create">Add Payment</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-light">
            <tr>
                <th>Invoice #</th>
                <th>Payment Date</th>
                <th class="text-end">Amount</th>
                <th>Method</th>
                <th>Reference</th>
                <th>Notes</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@(item.Invoice?.InvoiceNumber ?? "-")</td>
                <td>@(item.PaymentDate.HasValue ? item.PaymentDate.Value.ToString("d") : "-")</td>
                <td class="text-end">@item.AmountPaid.ToString("C")</td>
                <td>@(item.PaymentMethod ?? "-")</td>
                <td>@(item.TransactionReference ?? "-")</td>
                <td>@(item.Notes ?? "-")</td>
                <td>
                    <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@item.PaymentId">Details</a>
                    <a class="btn btn-sm btn-danger ms-1" asp-action="Delete" asp-route-id="@item.PaymentId">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
