@model IEnumerable<AutoRepairERD.Models.Payment>

@{
    ViewData["Title"] = "Payments";
}

<div class="card-header" style="display:flex;align-items:center;gap:12px">
    <h1 class="h3">Payments</h1>
    <a class="btn-gold btn-sm" asp-action="Create">Add Payment</a>
    <form method="get" style="margin-left:auto;display:flex;gap:8px;align-items:center">
      <input type="search" name="q" value="@(ViewBag.SearchQuery ?? "")" placeholder="Search invoice #, reference or method" class="form-control" style="width:320px;padding:8px 10px">
      <button type="submit" class="btn-outline btn-sm">Search</button>
    </form>
</div>

<div class="table-wrap">
    <table class="erp-table">
        <thead >
            <tr>
                <th>Invoice #</th>
                <th>Payment Date</th>
                <th style="text-align:right">Amount</th>
                <th>Method</th>
                <th>Reference</th>
                <th>Notes</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@(item.Invoice?.InvoiceNumber ?? "-")</td>
                <td>@(item.PaymentDate.HasValue ? item.PaymentDate.Value.ToString("d") : "-")</td>
                <td style="text-align:right">@item.AmountPaid.ToString("C")</td>
                <td>@(item.PaymentMethod ?? "-")</td>
                <td>@(item.TransactionReference ?? "-")</td>
                <td>@(item.Notes ?? "-")</td>
                <td>
                    <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@item.PaymentId">Details</a>
                    <a class="btn btn-sm btn-danger ms-1" asp-action="Delete" asp-route-id="@item.PaymentId">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
