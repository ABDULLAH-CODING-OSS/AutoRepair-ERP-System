@model IEnumerable<AutoRepairERD.Models.Payment>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            @* <th>
                @Html.DisplayNameFor(model => model.InvoiceId)
            </th> *@
            <th>Invoice Number</th>
            <th>
                @Html.DisplayNameFor(model => model.PaymentDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AmountPaid)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PaymentMethod)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TransactionReference)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Notes)
            </th>
          
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            @* <td>
                @Html.DisplayFor(model => item.InvoiceId)
            </td> *@
                <td>
                    @item.Invoice?.InvoiceNumber
                </td>
            <td>
                @Html.DisplayFor(model => item.PaymentDate)
            </td>
            <td>
                @Html.DisplayFor(model => item.AmountPaid)
            </td>
            <td>
                @Html.DisplayFor(model => item.PaymentMethod)
            </td>
            <td>
                @Html.DisplayFor(model => item.TransactionReference)
            </td>
            <td>
                @Html.DisplayFor(model => item.Notes)
            </td>
          
            <td>
                @* <a asp-action="Edit" asp-route-id="@item.PaymentId">Edit</a> | *@
                <a asp-action="Details" asp-route-id="@item.PaymentId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.PaymentId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
