@model AutoRepairERD.Models.Payment

@{
    ViewData["Title"] = "Payment Details";
}

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Payment #@Model?.PaymentId</h5>
    </div>
    <div style="padding:4px 0">
        <div style="display:flex;gap:16px;flex-wrap:wrap">
            <div style="flex:1;min-width:240px">
                <p><strong>Invoice:</strong> @(Model?.Invoice?.InvoiceNumber ?? Model?.InvoiceId.ToString())</p>
                <p><strong>Job Number:</strong> @(Model?.Invoice?.JobOrder?.JobNumber ?? "-")</p>
                <p><strong>Customer:</strong> @(Model?.Invoice?.JobOrder?.Customer != null ? Model.Invoice.JobOrder.Customer.FirstName + " " + Model.Invoice.JobOrder.Customer.LastName : "-")</p>
                <p><strong>Payment Date:</strong> @((Model != null && Model.PaymentDate.HasValue) ? Model.PaymentDate.Value.ToString("g") : "-")</p>
                <p><strong>Payment Method:</strong> @(Model?.PaymentMethod ?? "-")</p>
            </div>
            <div style="flex:1;min-width:240px">
                <p><strong>Amount Paid:</strong> @(Model != null ? Model.AmountPaid.ToString("C") : "-")</p>
            </div>
        </div>
        <hr />
        <p><strong>Reference:</strong> @Model?.TransactionReference</p>
        <p><strong>Notes:</strong> @Model?.Notes</p>
    </div>
    <div class="card-footer">
        <a class="btn-gold btn-sm" asp-action="Edit" asp-route-id="@Model?.PaymentId">Edit</a>
        <a class="btn btn-secondary ms-2" asp-action="Index">Back to List</a>
    </div>
</div>
