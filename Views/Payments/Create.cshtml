@model AutoRepairERD.Models.Payment

@{
    ViewData["Title"] = "Add Payment";
}

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Record Payment</h5>
    </div>
    <div style="padding:4px 0">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div style="margin-bottom:12px">
                <label class="form-label">Invoice <span style="color:var(--red)">*</span></label>
                <select asp-for="InvoiceId" class="form-control" asp-items="ViewBag.Invoices"></select>
                <span asp-validation-for="InvoiceId" style="color:var(--red)"></span>
            </div>

            <div style="margin-bottom:12px">
                <label asp-for="AmountPaid" class="form-label">Amount <span style="color:var(--red)">*</span></label>
                <input asp-for="AmountPaid" class="form-control" placeholder="Enter amount" />
                <span asp-validation-for="AmountPaid" style="color:var(--red)"></span>
            </div>

            <div style="margin-bottom:12px">
                <label class="form-label">Payment Method</label>
                <select asp-for="PaymentMethod" class="form-control">
                    <option value="Cash">Cash</option>
                    <option value="Card">Card</option>
                    <option value="Bank Transfer">Bank Transfer</option>
                </select>
                <span asp-validation-for="PaymentMethod" style="color:var(--red)"></span>
            </div>

            <div style="margin-bottom:12px">
                <label asp-for="TransactionReference" class="form-label">Transaction Reference</label>
                <input asp-for="TransactionReference" class="form-control" />
                <span asp-validation-for="TransactionReference" style="color:var(--red)"></span>
            </div>

            <div style="margin-bottom:12px">
                <label asp-for="Notes" class="form-label">Notes</label>
                <input asp-for="Notes" class="form-control" />
                <span asp-validation-for="Notes" style="color:var(--red)"></span>
            </div>

            <div>
                <button type="submit" class="btn-gold btn-sm">Save Payment</button>
                <a class="btn btn-secondary ms-2" asp-action="Index">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
