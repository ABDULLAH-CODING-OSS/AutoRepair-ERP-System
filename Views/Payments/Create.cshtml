@model AutoRepairERD.Models.Payment

@{
    ViewData["Title"] = "Add Payment";
}

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Record Payment</h5>
    </div>
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label class="form-label">Invoice <span class="text-danger">*</span></label>
                <select asp-for="InvoiceId" class="form-select" asp-items="ViewBag.Invoices"></select>
                <span asp-validation-for="InvoiceId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="AmountPaid" class="form-label">Amount <span class="text-danger">*</span></label>
                <input asp-for="AmountPaid" class="form-control" placeholder="Enter amount" />
                <span asp-validation-for="AmountPaid" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Payment Method</label>
                <select asp-for="PaymentMethod" class="form-select">
                    <option value="Cash">Cash</option>
                    <option value="Card">Card</option>
                    <option value="Bank Transfer">Bank Transfer</option>
                </select>
                <span asp-validation-for="PaymentMethod" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TransactionReference" class="form-label">Transaction Reference</label>
                <input asp-for="TransactionReference" class="form-control" />
                <span asp-validation-for="TransactionReference" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Notes" class="form-label">Notes</label>
                <input asp-for="Notes" class="form-control" />
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>

            <div>
                <button type="submit" class="btn btn-primary">Save Payment</button>
                <a class="btn btn-secondary ms-2" asp-action="Index">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
