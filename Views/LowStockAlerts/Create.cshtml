@model AutoRepairERD.Models.LowStockAlert

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>LowStockAlert</h4>
<hr />
<div style="display:flex;gap:16px;flex-wrap:wrap">
    <div style="flex:1;min-width:240px">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" style="color:var(--red)"></div>

            <div class="form-group">
                <label asp-for="PartId" class="control-label"></label>
                <input asp-for="PartId" class="form-control" />
                <span asp-validation-for="PartId" style="color:var(--red)"></span>
            </div>

            <div class="form-group">
                <label asp-for="CurrentQuantity" class="control-label"></label>
                <input asp-for="CurrentQuantity" class="form-control" />
                <span asp-validation-for="CurrentQuantity" style="color:var(--red)"></span>
            </div>

            <div class="form-group">
                <label asp-for="ReorderLevel" class="control-label"></label>
                <input asp-for="ReorderLevel" class="form-control" />
                <span asp-validation-for="ReorderLevel" style="color:var(--red)"></span>
            </div>

            <div class="form-group">
                <label asp-for="AlertDate" class="control-label"></label>
                <input asp-for="AlertDate" class="form-control" />
                <span asp-validation-for="AlertDate" style="color:var(--red)"></span>
            </div>

            <div class="form-group">
                <label asp-for="Status" class="control-label"></label>
                <input asp-for="Status" class="form-control" />
                <span asp-validation-for="Status" style="color:var(--red)"></span>
            </div>

            <div class="form-group">
                <label asp-for="Part" class="control-label"></label>
                <input asp-for="Part" class="form-control" />
                <span asp-validation-for="Part" style="color:var(--red)"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn-gold btn-sm" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
