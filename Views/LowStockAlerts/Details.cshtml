@model AutoRepairERD.Models.LowStockAlert

@{
    ViewData["Title"] = "Alert Details";
}

<div class="card">
    <div style="padding:4px 0">
        <h4 class="card-title">Alert Details</h4>
        <dl class="row">
            <dt class="col-sm-3">Part</dt>
            <dd class="col-sm-9">@Model.Part?.PartName</dd>

            <dt class="col-sm-3">SKU</dt>
            <dd class="col-sm-9">@Model.Part?.Sku</dd>

            <dt class="col-sm-3">Category</dt>
            <dd class="col-sm-9">@Model.Part?.Category?.CategoryName</dd>

            <dt class="col-sm-3">Current Stock</dt>
            <dd class="col-sm-9">@Model.CurrentQuantity</dd>

            <dt class="col-sm-3">Reorder Level</dt>
            <dd class="col-sm-9">@Model.ReorderLevel</dd>

            <dt class="col-sm-3">Alert Date</dt>
            <dd class="col-sm-9">@(Model.AlertDate?.ToString("dd-MMM-yyyy"))</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>
        </dl>

        <a asp-action="Edit" asp-route-alertid="@Model.AlertId" class="btn-gold btn-sm">Edit</a>
        <a asp-action="Index" class="btn btn-secondary ms-1">Back</a>
    </div>
</div>
