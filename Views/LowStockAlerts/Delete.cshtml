@model AutoRepairERD.Models.LowStockAlert

@{
    ViewData["Title"] = "Delete Alert";
}

<div class="card">
    <div class="card-body">
        <h4 class="card-title">Delete Alert</h4>
        <p class="text-danger">Are you sure you want to delete this low stock alert?</p>

        <dl class="row">
            <dt class="col-sm-3">Part</dt>
            <dd class="col-sm-9">@Model.Part?.PartName</dd>

            <dt class="col-sm-3">Current Stock</dt>
            <dd class="col-sm-9">@Model.CurrentQuantity</dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="AlertId" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>
