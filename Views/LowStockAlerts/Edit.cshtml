@model AutoRepairERD.Models.LowStockAlert

@{
    ViewData["Title"] = "Edit Alert";
}

<div class="card">
    <div style="padding:4px 0">
        <h4 class="card-title">Edit Alert</h4>

        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="AlertId" />

            <div class="mb-3 row">
                <label class="col-sm-3 col-form-label">Part</label>
                <div style="flex:1;min-width:200px">
                    <p class="form-control-plaintext">@Model.Part?.PartName</p>
                </div>
            </div>

            <div class="mb-3 row">
                <label class="col-sm-3 col-form-label">Current Stock</label>
                <div style="flex:1;min-width:200px">
                    <p class="form-control-plaintext">@Model.CurrentQuantity</p>
                </div>
            </div>

            <div class="mb-3 row">
                <label class="col-sm-3 col-form-label">Reorder Level</label>
                <div style="flex:1;min-width:200px">
                    <p class="form-control-plaintext">@Model.ReorderLevel</p>
                </div>
            </div>

            <div style="margin-bottom:12px">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-control">
                    <option value="Active" selected="@(Model.Status=="Active")">Active</option>
                    <option value="Resolved" selected="@(Model.Status=="Resolved")">Resolved</option>
                    <option value="Inactive" selected="@(Model.Status=="Inactive")">Inactive</option>
                </select>
                <span asp-validation-for="Status" style="color:var(--red)"></span>
            </div>

            <div style="display:flex;gap:8px;flex-wrap:wrap">
                <button type="submit" class="btn-gold btn-sm">Save</button>
                <a asp-action="Index" class="btn-outline btn-sm">Cancel</a>
            </div>
        </form>
    </div>
</div>
