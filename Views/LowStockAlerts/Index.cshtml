@model IEnumerable<AutoRepairERD.Models.LowStockAlert>

@{
    ViewData["Title"] = "Low Stock Alerts";
}

<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between mb-3">
            <h4 class="card-title">Low Stock Alerts</h4>
            @* No manual creation of alerts *@
        </div>

        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Part</th>
                        <th>SKU</th>
                        <th>Category</th>
                        <th>Current Stock</th>
                        <th>Reorder Level</th>
                        <th>Alert Date</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Part?.PartName</td>
                        <td>@item.Part?.Sku</td>
                        <td>@item.Part?.Category?.CategoryName</td>
                        <td>
                            @if ((item.CurrentQuantity ?? 0) == 0)
                            {
                                <span class="badge bg-danger">Out Of Stock</span>
                            }
                            @item.CurrentQuantity
                        </td>
                        <td>@item.ReorderLevel</td>
                        <td>@(item.AlertDate?.ToString("dd-MMM-yyyy"))</td>
                        <td>
                            @switch(item.Status)
                            {
                                case "Active":
                                    <span class="badge bg-warning">Active Alert</span>
                                    break;
                                case "Resolved":
                                    <span class="badge bg-success">Resolved</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary">@item.Status</span>
                                    break;
                            }
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-alertid="@item.AlertId" class="btn btn-sm btn-outline-secondary">Details</a>
                            <a asp-action="Edit" asp-route-alertid="@item.AlertId" class="btn btn-sm btn-outline-primary ms-1">Edit</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
