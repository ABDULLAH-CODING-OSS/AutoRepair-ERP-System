@model IEnumerable<AutoRepairERD.Models.LowStockAlert>
@{ ViewData["Title"] = "Low Stock Alerts"; ViewData["ActiveNav"] = "low-stock"; }

<div class="card">
  <div class="card-header"><span class="card-title">Low Stock Alerts (@Model.Count())</span></div>
  <div class="table-wrap"><table class="erp-table">
    <thead><tr><th>Part</th><th>Current Stock</th><th>Reorder Level</th><th>Alert Date</th><th>Status</th><th></th></tr></thead>
    <tbody>
      @if (!Model.Any()) { <tr><td colspan="6" class="td-muted" style="text-align:center;padding:24px">🎉 No low stock alerts — all parts are well stocked.</td></tr> }
      @foreach (var a in Model)
      {
          <tr onclick="carTransition('/Parts/Details/@a.PartId','PART DETAIL')">
            <td class="td-gold">@a.Part?.PartName</td>
            <td style="color:var(--red);font-weight:700">@a.CurrentQuantity</td>
            <td>@a.ReorderLevel</td>
            <td class="td-muted">@(a.AlertDate?.ToString("MMM d, yyyy"))</td>
            <td><span class="badge badge-low">@a.Status</span></td>
            <td><a asp-controller="PurchaseOrders" asp-action="Create" class="btn-gold btn-sm">Order Now</a></td>
          </tr>
      }
    </tbody>
  </table></div>
</div>
