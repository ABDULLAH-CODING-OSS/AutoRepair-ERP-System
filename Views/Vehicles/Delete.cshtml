@model AutoRepairERD.Models.Vehicle

@{
    ViewData["Title"] = "Delete Vehicle";
}

<div class="container py-4">
  <div class="card">
    <div class="card-header">
      <h2>Delete Vehicle</h2>
    </div>
    <div class="card-body">
      <p class="text-danger">Are you sure you want to delete this vehicle?</p>

      <dl class="row mb-3">
        <dt class="col-sm-3">Owner</dt>
        <dd class="col-sm-9">@((Model?.Customer != null) ? (Model.Customer.FirstName + " " + (Model.Customer.LastName ?? "")).Trim() : (Model?.CustomerId.ToString() ?? ""))</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.LicensePlate)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.LicensePlate)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Vin)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.Vin)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Make)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.Make)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Model)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.Model)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.ManufacturingYear)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.ManufacturingYear)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Color)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.Color)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Mileage)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.Mileage)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.EngineNumber)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.EngineNumber)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Notes)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.Notes)</dd>
      </dl>

      <!-- Navigation/collection displays removed: Customer, CreatedByUser, JobOrders are relationship properties and are not shown here. -->

      <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="VehicleId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
      </form>
    </div>
  </div>
</div>
