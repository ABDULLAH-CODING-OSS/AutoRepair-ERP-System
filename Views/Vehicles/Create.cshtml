@model AutoRepairERD.Models.Vehicle
@{ ViewData["Title"] = "Add Vehicle"; ViewData["ActiveNav"] = "vehicles"; }

@section TopbarActions { <a asp-action="Index" class="btn-outline btn-sm">← Back</a> }

<div class="card" style="max-width:640px">
  <div class="card-header"><span class="card-title">Register Vehicle</span></div>
  <form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" style="color:var(--red);font-size:13px;margin-bottom:10px"></div>
    <div class="form-group">
      <label class="form-label">Customer *</label>
      <select asp-for="CustomerId" class="form-control" asp-items="ViewBag.Customers"><option value="">-- Select Customer --</option></select>
      <span asp-validation-for="CustomerId" style="color:var(--red);font-size:12px"></span>
    </div>
    <div class="form-row-2">
      <div class="form-group"><label asp-for="LicensePlate" class="form-label"></label><input asp-for="LicensePlate" class="form-control" placeholder="ABC-123" /><span asp-validation-for="LicensePlate" style="color:var(--red);font-size:12px"></span></div>
      <div class="form-group"><label asp-for="Vin" class="form-label"></label><input asp-for="Vin" class="form-control" placeholder="17-char VIN (optional)" /></div>
    </div>
    <div class="form-row-3">
      <div class="form-group"><label asp-for="Make" class="form-label"></label><input asp-for="Make" class="form-control" placeholder="Toyota" /><span asp-validation-for="Make" style="color:var(--red);font-size:12px"></span></div>
      <div class="form-group"><label asp-for="Model" class="form-label"></label><input asp-for="Model" class="form-control" placeholder="Corolla" /><span asp-validation-for="Model" style="color:var(--red);font-size:12px"></span></div>
      <div class="form-group"><label asp-for="ManufacturingYear" class="form-label"></label><input asp-for="ManufacturingYear" class="form-control" type="number" min="1886" max="2100" placeholder="@DateTime.Now.Year" /></div>
    </div>
    <div class="form-row-2">
      <div class="form-group"><label asp-for="Color" class="form-label"></label><input asp-for="Color" class="form-control" placeholder="White" /></div>
      <div class="form-group"><label asp-for="Mileage" class="form-label"></label><input asp-for="Mileage" class="form-control" type="number" min="0" placeholder="km" /></div>
    </div>
    <div class="form-row-2">
      <div class="form-group"><label asp-for="EngineNumber" class="form-label"></label><input asp-for="EngineNumber" class="form-control" /></div>
    </div>
    <div class="form-group"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="2"></textarea></div>
    <div style="display:flex;gap:10px;margin-top:6px">
      <button type="submit" class="btn-gold">Save Vehicle</button>
      <a asp-action="Index" class="btn-outline btn-sm">Cancel</a>
    </div>
  </form>
</div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
