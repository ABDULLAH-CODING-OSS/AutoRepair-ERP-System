@model AutoRepairERD.Models.Vehicle
@{ ViewData["Title"] = "Edit Vehicle"; ViewData["ActiveNav"] = "vehicles"; }

@section TopbarActions { <a asp-action="Details" asp-route-id="@Model.VehicleId" class="btn-outline btn-sm">← Back</a> }

<div class="card" style="max-width:640px">
  <div class="card-header"><span class="card-title">Edit — @Model.Make @Model.Model (@Model.LicensePlate)</span></div>
  <form asp-action="Edit" method="post">
    <input type="hidden" asp-for="VehicleId" />
    <input type="hidden" asp-for="CreatedByUserId" />
    <div asp-validation-summary="ModelOnly" style="color:var(--red);font-size:13px;margin-bottom:10px"></div>
    <div class="form-group">
      <label class="form-label">Owner</label>
      <input type="hidden" asp-for="CustomerId" />
      <input class="form-control" type="text" value="@((Model.Customer != null) ? (Model.Customer.FirstName + (string.IsNullOrEmpty(Model.Customer.LastName) ? "" : " " + Model.Customer.LastName) + " (" + Model.Customer.Phone + ")") : "Unknown")" readonly />
    </div>
    <div class="form-row-2">
      <div class="form-group"><label asp-for="LicensePlate" class="form-label"></label><input asp-for="LicensePlate" class="form-control" /></div>
      <div class="form-group"><label asp-for="Vin" class="form-label"></label><input asp-for="Vin" class="form-control" /></div>
    </div>
    <div class="form-row-3">
      <div class="form-group"><label asp-for="Make" class="form-label"></label><input asp-for="Make" class="form-control" /></div>
      <div class="form-group"><label asp-for="Model" class="form-label"></label><input asp-for="Model" class="form-control" /></div>
      <div class="form-group"><label asp-for="ManufacturingYear" class="form-label"></label><input asp-for="ManufacturingYear" class="form-control" type="number" /></div>
    </div>
    <div class="form-row-2">
      <div class="form-group"><label asp-for="Color" class="form-label"></label><input asp-for="Color" class="form-control" /></div>
      <div class="form-group"><label asp-for="Mileage" class="form-label"></label><input asp-for="Mileage" class="form-control" type="number" /></div>
    </div>
    <div class="form-group"><label asp-for="EngineNumber" class="form-label"></label><input asp-for="EngineNumber" class="form-control" /></div>
    <div class="form-group"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="2"></textarea></div>
    <div style="display:flex;gap:10px;margin-top:6px">
      <button type="submit" class="btn-gold">Save Changes</button>
      <a asp-action="Details" asp-route-id="@Model.VehicleId" class="btn-outline btn-sm">Cancel</a>
    </div>
  </form>
</div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
