@model IEnumerable<AutoRepairERD.Models.Vehicle>

@{
    ViewData["Title"] = "Vehicles";
}

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Vehicles</h1>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
  </div>

  <div class="card">
    <div class="card-body p-0">
      <table class="table mb-0 table-striped">
        <thead class="table-light">
          <tr>
            <th>Registration Number</th>
            <th>@Html.DisplayNameFor(m => m.Make)</th>
            <th>@Html.DisplayNameFor(m => m.Model)</th>
            <th>@Html.DisplayNameFor(m => m.ManufacturingYear)</th>
            <th>Customer</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
        @foreach (var item in Model) {
          <tr>
            <td>@Html.DisplayFor(_ => item.LicensePlate)</td>
            <td>@Html.DisplayFor(_ => item.Make)</td>
            <td>@Html.DisplayFor(_ => item.Model)</td>
            <td>@Html.DisplayFor(_ => item.ManufacturingYear)</td>
            <td>@((item.Customer != null) ? (item.Customer.FirstName + " " + (item.Customer.LastName ?? "")).Trim() : item.CustomerId.ToString())</td>
            <td class="text-end">
              <a asp-action="Edit" asp-route-id="@item.VehicleId" class="btn btn-sm btn-outline-primary me-1">Edit</a>
              <a asp-action="Details" asp-route-id="@item.VehicleId" class="btn btn-sm btn-outline-secondary me-1">Details</a>
              <a asp-action="Delete" asp-route-id="@item.VehicleId" class="btn btn-sm btn-outline-danger">Delete</a>
            </td>
          </tr>
        }
        </tbody>
      </table>
    </div>
  </div>
</div>
