@model IEnumerable<AutoRepairERD.Models.Vehicle>
@{ ViewData["Title"] = "Vehicles"; ViewData["ActiveNav"] = "vehicles"; }

@section TopbarActions { <a asp-action="Create" class="btn-gold btn-sm">+ Add Vehicle</a> }

<div class="card">
  <div class="card-header"><span class="card-title">All Vehicles (@Model.Count())</span>
    <form method="get" style="margin-left:auto;display:flex;gap:8px;align-items:center">
      <input type="search" name="q" value="@(ViewBag.SearchQuery ?? "")" placeholder="Search plate, VIN, make, model, customer" class="form-control" style="width:320px;padding:8px 10px">
      <button type="submit" class="btn-outline btn-sm">Search</button>
    </form>
  </div>
  <div class="table-wrap"><table class="erp-table">
    <thead><tr><th>Plate</th><th>Customer</th><th>Make / Model</th><th>Year</th><th>Color</th><th>Mileage</th><th></th></tr></thead>
    <tbody>
      @if (!Model.Any()) { <tr><td colspan="7" class="td-muted" style="text-align:center;padding:24px">No vehicles registered yet.</td></tr> }
      @foreach (var v in Model)
      {
          <tr onclick="carTransition('/Vehicles/Details/@v.VehicleId','VEHICLE DETAIL')">
            <td class="td-gold">@v.LicensePlate</td>
            <td>@v.Customer?.FirstName @v.Customer?.LastName</td>
            <td>@v.Make @v.Model</td>
            <td>@v.ManufacturingYear</td>
            <td>@v.Color</td>
            <td class="td-muted">@(v.Mileage.HasValue ? $"{v.Mileage:N0} km" : "—")</td>
            <td style="white-space:nowrap">
              <a asp-action="Details" asp-route-id="@v.VehicleId" class="btn-outline btn-sm">View</a>
              <a asp-action="Edit" asp-route-id="@v.VehicleId" class="btn-outline btn-sm">Edit</a>
              <a asp-action="Delete" asp-route-id="@v.VehicleId" class="btn-outline btn-sm" style="color:var(--red)">Delete</a>
            </td>
          </tr>
      }
    </tbody>
  </table></div>
</div>
