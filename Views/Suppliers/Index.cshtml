@model IEnumerable<AutoRepairERD.Models.Supplier>
@{ ViewData["Title"] = "Suppliers"; ViewData["ActiveNav"] = "suppliers"; }

@section TopbarActions { <a asp-action="Create" class="btn-gold btn-sm">+ Add Supplier</a> }

<div class="card">
  <div class="card-header"><span class="card-title">Suppliers (@Model.Count())</span></div>
  <div class="table-wrap"><table class="erp-table">
    <thead><tr><th>Company</th><th>Contact Person</th><th>Phone</th><th>Email</th><th>Parts Supplied</th><th></th></tr></thead>
    <tbody>
      @if (!Model.Any()) { <tr><td colspan="6" class="td-muted" style="text-align:center;padding:24px">No suppliers yet.</td></tr> }
      @foreach (var s in Model)
      {
          <tr onclick="carTransition('/Suppliers/Details/@s.SupplierId','SUPPLIER DETAIL')">
            <td class="td-gold">@s.CompanyName</td>
            <td>@s.ContactPerson</td>
            <td>@s.Phone</td>
            <td class="td-muted">@s.Email</td>
            <td><span class="badge badge-neutral">@s.Parts.Count</span></td>
            <td style="white-space:nowrap">
              <a asp-action="Details" asp-route-id="@s.SupplierId" class="btn-outline btn-sm">View</a>
              <a asp-action="Edit" asp-route-id="@s.SupplierId" class="btn-outline btn-sm">Edit</a>
              <a asp-action="Delete" asp-route-id="@s.SupplierId" class="btn-outline btn-sm" style="color:var(--red)">Delete</a>
            </td>
          </tr>
      }
    </tbody>
  </table></div>
</div>
