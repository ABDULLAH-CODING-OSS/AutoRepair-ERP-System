@model AutoRepairERD.Models.Supplier

@{
    ViewData["Title"] = "Supplier Details";
}

<div class="container py-4">
  <div class="card">
    <div class="card-header">
      <h2>Supplier Details</h2>
    </div>
    <div class="card-body">
      <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.CompanyName)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.CompanyName)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.ContactPerson)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.ContactPerson)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Phone)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.Phone)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Email)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.Email)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Address)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.Address)</dd>
      </dl>

      <!-- Navigation/collection displays removed: Parts and PurchaseOrders are navigation properties and are not shown here. -->

      <div class="mt-3">
        <a asp-action="Edit" asp-route-id="@Model?.SupplierId" class="btn btn-primary">Edit</a>
        <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
      </div>
    </div>
  </div>
</div>
