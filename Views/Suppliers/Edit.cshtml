@model AutoRepairERD.Models.Supplier

@{
    ViewData["Title"] = "Edit Supplier";
}

<div style="max-width:960px">
  <div class="card">
    <div class="card-header">
      <h2>Edit Supplier</h2>
    </div>
    <div style="padding:4px 0">
      <form asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <input type="hidden" asp-for="SupplierId" />

        <div style="margin-bottom:12px">
          <label asp-for="CompanyName" class="form-label"></label>
          <input asp-for="CompanyName" class="form-control" />
          <div style="color:var(--red)"><span asp-validation-for="CompanyName"></span></div>
        </div>

        <div style="margin-bottom:12px">
          <label asp-for="ContactPerson" class="form-label"></label>
          <input asp-for="ContactPerson" class="form-control" />
          <div style="color:var(--red)"><span asp-validation-for="ContactPerson"></span></div>
        </div>

        <div style="display:flex;gap:16px;flex-wrap:wrap">
          <div style="flex:1;min-width:240px">
            <label asp-for="Phone" class="form-label"></label>
            <input asp-for="Phone" class="form-control" />
            <div style="color:var(--red)"><span asp-validation-for="Phone"></span></div>
          </div>
          <div style="flex:1;min-width:240px">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" />
            <div style="color:var(--red)"><span asp-validation-for="Email"></span></div>
          </div>
        </div>

        <div style="margin-bottom:12px">
          <label asp-for="Address" class="form-label"></label>
          <textarea asp-for="Address" class="form-control" rows="3"></textarea>
          <div style="color:var(--red)"><span asp-validation-for="Address"></span></div>
        </div>

        <!-- Navigation/collection fields removed: Parts and PurchaseOrders are navigation properties (ICollection) and are not editable here. -->

        <div style="display:flex;gap:8px;flex-wrap:wrap">
          <button type="submit" class="btn-gold btn-sm">Save</button>
          <a asp-action="Index" class="btn-outline btn-sm">Back to List</a>
        </div>
      </form>
    </div>
  </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
