@model AutoRepairERD.Models.Attendance

@{
    ViewData["Title"] = "Record Attendance";
}

<div class="container py-4">
  <div class="card">
    <div class="card-header"><h2>Record Attendance</h2></div>
    <div class="card-body">
      @{ var employees = (SelectList)(ViewData["EmployeeId"] ?? new SelectList(Enumerable.Empty<SelectListItem>())); 
         var statuses = (SelectList)(ViewData["StatusList"] ?? new SelectList(Enumerable.Empty<SelectListItem>())); }
      <form asp-action="Create" method="post">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="row g-3">
          <div class="col-md-6">
            <label asp-for="EmployeeId" class="form-label"></label><span class="text-danger">*</span>
            <select asp-for="EmployeeId" class="form-select" asp-items="@employees">
              <option value="">-- Select Employee --</option>
            </select>
            <input asp-for="EmployeeId" type="hidden" />
            <div class="text-danger"><span asp-validation-for="EmployeeId"></span></div>
          </div>

          <div class="col-md-6">
            <label asp-for="AttendanceDate" class="form-label"></label>
            <input asp-for="AttendanceDate" type="date" class="form-control" />
            <div class="text-danger"><span asp-validation-for="AttendanceDate"></span></div>
          </div>
        </div>

        <div class="row g-3 mt-3">
          <div class="col-md-6">
            <label asp-for="CheckInTime" class="form-label"></label>
            <input asp-for="CheckInTime" type="time" class="form-control" />
            <div class="text-danger"><span asp-validation-for="CheckInTime"></span></div>
          </div>
          <div class="col-md-6">
            <label asp-for="CheckOutTime" class="form-label"></label>
            <input asp-for="CheckOutTime" type="time" class="form-control" />
            <div class="text-danger"><span asp-validation-for="CheckOutTime"></span></div>
          </div>
        </div>

        <div class="row g-3 mt-3">
          <div class="col-md-6">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" class="form-select" asp-items="@statuses">
              <option value="">-- Select Status (optional) --</option>
            </select>
            <div class="text-danger"><span asp-validation-for="Status"></span></div>
          </div>
        </div>

        <div class="mt-3 d-flex gap-2">
          <button type="submit" class="btn btn-primary">Create</button>
          <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
      </form>
    </div>
  </div>
</div>

@{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
