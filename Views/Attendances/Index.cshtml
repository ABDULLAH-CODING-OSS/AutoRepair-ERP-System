@model IEnumerable<AutoRepairERD.Models.Attendance>

@{
    ViewData["Title"] = "Attendances";
}

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Attendances</h1>
    <a asp-action="Create" class="btn btn-primary">Record Attendance</a>
  </div>

  <div class="card">
    <div class="card-body p-0">
      <table class="table table-striped table-hover table-responsive mb-0">
        <thead class="table-light">
          <tr>
            <th>Employee</th>
            <th>Attendance Date</th>
            <th>Check In</th>
            <th>Check Out</th>
            <th class="text-center">Overtime</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
@foreach (var item in Model) {
          <tr>
            <td>@(item.Employee != null ? item.Employee.EmployeeCode + " - " + item.Employee.FirstName + " " + item.Employee.LastName : item.EmployeeId.ToString())</td>
            <td>@(item.AttendanceDate?.ToString("yyyy-MM-dd") ?? "-")</td>
            <td>@(item.CheckInTime?.ToString("HH:mm") ?? "-")</td>
            <td>@(item.CheckOutTime?.ToString("HH:mm") ?? "-")</td>
            <td class="text-center">@Html.DisplayFor(_ => item.OvertimeHours)</td>
            <td>@(string.IsNullOrWhiteSpace(item.Status) ? "-" : item.Status)</td>
            <td class="text-end">
              <a asp-action="Edit" asp-route-id="@item.AttendanceId" class="btn btn-sm btn-outline-primary me-1">Edit</a>
              <a asp-action="Details" asp-route-id="@item.AttendanceId" class="btn btn-sm btn-outline-secondary me-1">Details</a>
              <a asp-action="Delete" asp-route-id="@item.AttendanceId" class="btn btn-sm btn-outline-danger">Delete</a>
            </td>
          </tr>
}
        </tbody>
      </table>
    </div>
  </div>
</div>
