@model IEnumerable<AutoRepairERD.Models.Attendance>

@{
    ViewData["Title"] = "Attendances";
}

<div style="max-width:960px">
  <div class="card-header">
    <h1>Attendances</h1>
    <a asp-action="Create" class="btn-gold btn-sm">Record Attendance</a>
    <a asp-action="Management" class="btn-outline btn-sm ms-2">Manage Schedule</a>
  </div>

  <div class="card">
    @if (!Model.Any())
    {
      <div style="padding:20px;text-align:center;color:var(--text3)">
        <p>No attendance records found.</p>
        <a asp-action="Create" class="btn-gold btn-sm">Record First Attendance</a>
      </div>
    }
    else
    {
      <div style="padding:4px 0">
        <table class="erp-table">
          <thead>
            <tr>
              <th>Employee</th>
              <th>Attendance Date</th>
              <th>Check In</th>
              <th>Check Out</th>
              <th class="text-center">Overtime</th>
              <th>Status</th>
              <th style="text-align:right">Actions</th>
            </tr>
          </thead>
          <tbody>
          @foreach (var item in Model)
          {
            <tr>
              <td>@(item.Employee != null ? item.Employee.EmployeeCode + " - " + item.Employee.FirstName + " " + item.Employee.LastName : item.EmployeeId.ToString())</td>
              <td>@(item.AttendanceDate?.ToString("yyyy-MM-dd") ?? "-")</td>
              <td>@(item.CheckInTime?.ToString("HH:mm") ?? "-")</td>
              <td>@(item.CheckOutTime?.ToString("HH:mm") ?? "-")</td>
              <td class="text-center">@Html.DisplayFor(_ => item.OvertimeHours)</td>
              <td>@(string.IsNullOrWhiteSpace(item.Status) ? "-" : item.Status)</td>
              <td style="text-align:right">
                <a asp-action="Edit" asp-route-id="@item.AttendanceId" class="btn-outline btn-sm">Edit</a>
                <a asp-action="Details" asp-route-id="@item.AttendanceId" class="btn-outline btn-sm ms-1">Details</a>
                <a asp-action="Delete" asp-route-id="@item.AttendanceId" class="btn-outline btn-sm ms-1" style="color:var(--red)">Delete</a>
              </td>
            </tr>
          }
          </tbody>
        </table>
      </div>
    }
  </div>
</div>
