@model IEnumerable<AutoRepairERD.Models.SalaryAdjustment>

@{
    ViewData["Title"] = "Salary Adjustments";
}

@section TopbarActions {
  @if (ViewBag.PayrollId != null && ViewBag.PayrollId > 0)
  {
    <a asp-controller="Payrolls" asp-action="Details" asp-route-payrollid="@ViewBag.PayrollId" class="btn-outline btn-sm">← Back to Payroll</a>
  }
  <a asp-action="Create" asp-route-payrollId="@(ViewBag.PayrollId ?? 0)" class="btn-gold btn-sm">+ Add Adjustment</a>
  @if (ViewBag.PayrollId == null || ViewBag.PayrollId == 0)
  {
    <a asp-action="Index" class="btn-outline btn-sm">All Adjustments</a>
  }
}

<div class="card">
  <div class="card-header">
    <span class="card-title">Salary Adjustments (@Model.Count())</span>
    @if (ViewBag.PayrollLabel != null) { <span style="margin-left:12px" class="td-muted">@ViewBag.PayrollLabel</span> }
  </div>
  <div class="table-wrap"><table class="erp-table">
    <thead>
        <tr>
            <th>Payroll</th>
            <th>Type</th>
            <th>Amount</th>
            <th>Reason</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@if (!Model.Any())
{
    <tr><td colspan="5" class="td-muted" style="text-align:center;padding:20px">No salary adjustments found.</td></tr>
}
@foreach (var item in Model) {
        <tr>
            <td class="td-muted">@(item.Payroll != null ? item.Payroll.PayrollNumber : item.PayrollId.ToString())</td>
            <td class="td-gold">@item.AdjustmentType</td>
            <td>PKR @((item.Amount ?? 0m).ToString("N2"))</td>
            <td class="td-muted">@item.Reason</td>
            <td style="white-space:nowrap">
                <a asp-action="Edit" asp-route-adjustmentid="@item.AdjustmentId" class="btn-outline btn-sm">Edit</a>
                <a asp-action="Details" asp-route-adjustmentid="@item.AdjustmentId" class="btn-outline btn-sm">View</a>
                <a asp-action="Delete" asp-route-adjustmentid="@item.AdjustmentId" class="btn-outline btn-sm" style="color:var(--red)">Delete</a>
            </td>
        </tr>
}
    </tbody>
  </table></div>
</div>
