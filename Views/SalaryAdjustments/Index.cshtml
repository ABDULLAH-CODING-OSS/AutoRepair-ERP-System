@model IEnumerable<AutoRepairERD.Models.SalaryAdjustment>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.PayrollId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AdjustmentType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Amount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Reason)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Payroll)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.PayrollId)
            </td>
            <td>
                @Html.DisplayFor(model => item.AdjustmentType)
            </td>
            <td>
                @Html.DisplayFor(model => item.Amount)
            </td>
            <td>
                @Html.DisplayFor(model => item.Reason)
            </td>
            <td>
                @Html.DisplayFor(model => item.Payroll)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.AdjustmentId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.AdjustmentId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.AdjustmentId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
