@model AutoRepairERD.Models.SalaryAdjustment

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Salary Adjustment</h4>
    <hr />
    <div class="alert alert-warning">Are you sure you want to cancel this salary adjustment? This will mark it as Cancelled and it will no longer affect payroll calculations.</div>
    <div>
        <p><strong>Employee:</strong> @((Model?.Payroll?.Employee != null) ? ((Model?.Payroll?.Employee?.EmployeeCode ?? "") + " - " + ((Model?.Payroll?.Employee?.FirstName ?? "") + " " + (Model?.Payroll?.Employee?.LastName ?? "")).Trim()) : "-")</p>
        <p><strong>Payroll:</strong> @(Model?.Payroll?.PayrollNumber ?? "-")</p>
        <p><strong>Type:</strong> @(Model?.AdjustmentType ?? "-")</p>
        <p><strong>Amount:</strong> @String.Format("{0:C}", Model?.Amount ?? 0m)</p>
        <p><strong>Reason:</strong> @(Model?.Reason ?? "-")</p>
    </div>
    <form asp-action="Delete">
        <input type="hidden" asp-for="AdjustmentId" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
