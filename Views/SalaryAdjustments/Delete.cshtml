@model AutoRepairERD.Models.SalaryAdjustment

@{
    ViewData["Title"] = "Delete Salary Adjustment";
}

@section TopbarActions {
  @if (Model.PayrollId != 0)
  {
    <a asp-controller="Payrolls" asp-action="Details" asp-route-payrollid="@Model.PayrollId" class="btn-outline btn-sm">← Back to Payroll</a>
  }
  else
  {
    <a asp-action="Details" asp-route-adjustmentid="@Model.AdjustmentId" class="btn-outline btn-sm">← Back</a>
  }
}

<div class="card">
  <div class="card-header"><span class="card-title">Delete Salary Adjustment</span></div>
  <div style="padding:16px">
    <p style="margin-bottom:16px;color:var(--red)"><strong>⚠ Are you sure you want to delete this salary adjustment?</strong></p>
    <div style="display:flex;gap:16px;flex-wrap:wrap;margin-bottom:16px">
      <div style="flex:1;min-width:220px">
        <label class="form-label">Payroll</label>
        <div class="td-muted">@(Model.Payroll != null ? Model.Payroll.PayrollNumber : Model.PayrollId.ToString())</div>
      </div>
      <div style="flex:1;min-width:220px">
        <label class="form-label">Type</label>
        <div class="td-gold">@Model.AdjustmentType</div>
      </div>
      <div style="flex:1;min-width:220px">
        <label class="form-label">Amount</label>
        <div>PKR @((Model.Amount ?? 0m).ToString("N2"))</div>
      </div>
    </div>
    <form asp-action="Delete" asp-route-adjustmentid="@Model.AdjustmentId" method="post">
      @Html.AntiForgeryToken()
      <button type="submit" class="btn-outline btn-sm" style="color:var(--red);background:var(--red-dim)">Confirm Delete</button>
      <a asp-action="Details" asp-route-adjustmentid="@Model.AdjustmentId" class="btn-outline btn-sm" style="margin-left:8px">Cancel</a>
    </form>
  </div>
</div>
