@model AutoRepairERD.Models.SalaryAdjustment

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <div class="card mb-3">
        <div class="card-header">Employee Information</div>
        <div class="card-body">
            <p><strong>Employee Code:</strong> @(Model?.Payroll?.Employee?.EmployeeCode ?? "-")</p>
            <p><strong>Employee Name:</strong> @((Model?.Payroll?.Employee != null) ? ((Model?.Payroll?.Employee?.FirstName ?? "") + " " + (Model?.Payroll?.Employee?.LastName ?? "")).Trim() : "Unknown")</p>
            <p><strong>Payroll Number:</strong> @(Model?.Payroll?.PayrollNumber ?? "-")</p>
            <p><strong>Payroll Period:</strong> @(Model?.Payroll?.PayrollMonth != null ? System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(Model.Payroll.PayrollMonth ?? 0) + " " + (Model?.Payroll?.PayrollYear?.ToString() ?? "") : "-")</p>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Adjustment Information</div>
        <div class="card-body">
            <p><strong>Adjustment Type:</strong> @(Model?.AdjustmentType ?? "-")</p>
            <p><strong>Amount:</strong> @String.Format("{0:C}", Model?.Amount ?? 0m)</p>
            <p><strong>Reason:</strong> @(Model?.Reason ?? "-")</p>
            <p><strong>Status:</strong> @(Model.IsActive == false || Model.AdjustmentStatus == "Cancelled" ? "Cancelled" : (Model.AdjustmentStatus ?? "Active"))</p>
            <p><strong>Created At:</strong> @(Model.CreatedAt?.ToString("g") ?? "-")</p>
        </div>
    </div>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.AdjustmentId">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
