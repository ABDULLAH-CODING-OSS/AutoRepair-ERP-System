@model AutoRepairERD.Models.SalaryAdjustment

@{
    ViewData["Title"] = "Salary Adjustment Details";
}

@section TopbarActions {
  @if (Model.PayrollId != 0)
  {
    <a asp-controller="Payrolls" asp-action="Details" asp-route-payrollid="@Model.PayrollId" class="btn-outline btn-sm">← Back to Payroll</a>
  }
  else
  {
    <a asp-action="Index" class="btn-outline btn-sm">← Back</a>
  }
  <a asp-action="Edit" asp-route-adjustmentid="@Model.AdjustmentId" class="btn-gold btn-sm">Edit</a>
  <a asp-action="Delete" asp-route-adjustmentid="@Model.AdjustmentId" class="btn-outline btn-sm" style="color:var(--red)">Delete</a>
}

<div class="card">
  <div class="card-header"><span class="card-title">Salary Adjustment Details</span></div>
  <div style="padding:16px">
    <div style="display:flex;gap:16px;flex-wrap:wrap">
      <div style="flex:1;min-width:220px">
        <label class="form-label">Payroll</label>
        <div class="td-muted">@(Model.Payroll != null ? Model.Payroll.PayrollNumber : Model.PayrollId.ToString())</div>
      </div>
      <div style="flex:1;min-width:220px">
        <label class="form-label">Type</label>
        <div class="td-gold">
          <span style="background:var(--gold-dim);padding:4px 8px;border-radius:4px">@Model.AdjustmentType</span>
        </div>
      </div>
      <div style="flex:1;min-width:220px">
        <label class="form-label">Amount</label>
        <div>PKR @((Model.Amount ?? 0m).ToString("N2"))</div>
      </div>
      <div style="flex-basis:100%">
        <label class="form-label">Reason</label>
        <div class="td-muted">@Model.Reason</div>
      </div>
    </div>
  </div>
</div>
