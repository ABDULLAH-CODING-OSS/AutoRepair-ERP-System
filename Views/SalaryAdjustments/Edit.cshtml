@model AutoRepairERD.Models.SalaryAdjustment

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>SalaryAdjustment</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="AdjustmentId" />
            <div class="form-group">
                <label class="control-label">Payroll</label>
                <input class="form-control" value="@(Model?.Payroll?.PayrollNumber ?? "-") + " - " + (Model?.Payroll?.Employee?.EmployeeCode ?? "-") + " - " + ((Model?.Payroll?.Employee != null) ? ((Model?.Payroll?.Employee?.FirstName ?? "") + " " + (Model?.Payroll?.Employee?.LastName ?? "")).Trim() : "Unknown") + " - " + (Model?.Payroll?.PayrollMonth != null ? System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(Model.Payroll.PayrollMonth ?? 0) : "") + " " + (Model?.Payroll?.PayrollYear?.ToString() ?? "")" readonly />
            </div>
            <div class="form-group">
                <label asp-for="AdjustmentType" class="control-label">Adjustment Type</label>
                <select asp-for="AdjustmentType" class="form-control">
                    <option>Bonus</option>
                    <option>Allowance</option>
                    <option>Deduction</option>
                    <option>Penalty</option>
                </select>
                <span asp-validation-for="AdjustmentType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Amount" class="control-label"></label>
                <input asp-for="Amount" class="form-control" />
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Reason" class="control-label"></label>
                <input asp-for="Reason" class="form-control" />
                <span asp-validation-for="Reason" class="text-danger"></span>
            </div>
            <!-- Payroll navigation property is read-only and not editable -->
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
