@model AutoRepairERD.Models.SalaryAdjustment

@{
    ViewData["Title"] = "Edit Salary Adjustment";
}

@section TopbarActions {
  @if (ViewBag.PayrollId != null && ViewBag.PayrollId > 0)
  {
    <a asp-controller="Payrolls" asp-action="Details" asp-route-payrollid="@ViewBag.PayrollId" class="btn-outline btn-sm">← Back to Payroll</a>
  }
  else
  {
    <a asp-action="Details" asp-route-adjustmentid="@Model.AdjustmentId" class="btn-outline btn-sm">← Back</a>
  }
}

<div class="card">
  <div class="card-header"><span class="card-title">Edit Salary Adjustment</span></div>
  <div style="padding:16px">
    <form asp-action="Edit">
      <div asp-validation-summary="ModelOnly" style="color:var(--red);margin-bottom:12px"></div>
      <input type="hidden" asp-for="AdjustmentId" />
      <input type="hidden" asp-for="PayrollId" />

      <div style="display:flex;gap:16px;flex-wrap:wrap">
        <div style="flex:1;min-width:240px">
          <div class="form-group">
            <label asp-for="AdjustmentType" class="form-label">Adjustment Type</label>
            <select asp-for="AdjustmentType" class="form-control">
              <option value="">-- Select Adjustment Type --</option>
              @if (ViewBag.AdjustmentTypes != null)
              {
                @foreach (var type in ViewBag.AdjustmentTypes)
                {
                  @if (Model.AdjustmentType == type)
                  {
                    <option value="@type" selected>@type</option>
                  }
                  else
                  {
                    <option value="@type">@type</option>
                  }
                }
              }
            </select>
            <span asp-validation-for="AdjustmentType" style="color:var(--red);font-size:12px"></span>
          </div>

          <div class="form-group">
            <label asp-for="Amount" class="form-label">Amount (PKR)</label>
            <input asp-for="Amount" class="form-control" placeholder="0.00" />
            <span asp-validation-for="Amount" style="color:var(--red);font-size:12px"></span>
          </div>

          <div class="form-group">
            <label asp-for="Reason" class="form-label">Reason</label>
            <input asp-for="Reason" class="form-control" placeholder="Brief reason for adjustment" />
            <span asp-validation-for="Reason" style="color:var(--red);font-size:12px"></span>
          </div>

          <div style="margin-top:18px;display:flex;gap:8px">
            <button type="submit" class="btn-gold btn-sm">Save Changes</button>
            @if (ViewBag.PayrollId != null && ViewBag.PayrollId > 0)
            {
              <a asp-controller="Payrolls" asp-action="Details" asp-route-payrollid="@ViewBag.PayrollId" class="btn-outline btn-sm">Cancel</a>
            }
            else
            {
              <a asp-action="Details" asp-route-adjustmentid="@Model.AdjustmentId" class="btn-outline btn-sm">Cancel</a>
            }
          </div>
        </div>
      </div>
    </form>
  </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

