
@model AutoRepairERD.Models.Part

@{
    ViewData["Title"] = "Delete Part";
}

<div class="container py-4">
  <div class="card">
    <div class="card-header"><h2>Delete Part</h2></div>
    <div class="card-body">
      <p class="text-danger">Are you sure you want to delete this part?</p>

      <dl class="row mb-3">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.PartName)</dd>

        <dt class="col-sm-3">SKU</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.Sku)</dd>

        <dt class="col-sm-3">Current Stock</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.CurrentStock)</dd>

        <dt class="col-sm-3">Sale Price</dt>
        <dd class="col-sm-9">@String.Format("{0:C}", Model.SalePrice)</dd>

        <dt class="col-sm-3">Supplier</dt>
                <dd class="col-sm-9">@(Model.Supplier?.CompanyName ?? Model.SupplierId.ToString())</dd>
      </dl>

      <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="PartId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
      </form>
    </div>
  </div>
</div>
