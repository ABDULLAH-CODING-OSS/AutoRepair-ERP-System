@model AutoRepairERD.Models.Part

@{
    ViewData["Title"] = "Part Details";
}

<div class="container py-4">
  <div class="card">
    <div class="card-header"><h2>Part Details</h2></div>
    <div class="card-body">
      <dl class="row">
        <dt class="col-sm-3">Category</dt>
        <dd class="col-sm-9">@(Model.Category?.CategoryName ?? Model.CategoryId.ToString())</dd>

        <dt class="col-sm-3">Supplier</dt>
                <dd class="col-sm-9">@(Model.Supplier?.CompanyName ?? Model.SupplierId.ToString())</dd>

        <dt class="col-sm-3">SKU</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.Sku)</dd>

        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.PartName)</dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.Description)</dd>

        <dt class="col-sm-3">Cost Price</dt>
        <dd class="col-sm-9">@String.Format("{0:C}", Model.CostPrice)</dd>

        <dt class="col-sm-3">Sale Price</dt>
        <dd class="col-sm-9">@String.Format("{0:C}", Model.SalePrice)</dd>

        <dt class="col-sm-3">Current Stock</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.CurrentStock)</dd>

        <dt class="col-sm-3">Reorder Level</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.ReorderLevel)</dd>

        <dt class="col-sm-3">Unit</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.Unit)</dd>

        <dt class="col-sm-3">Rack Location</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.RackLocation)</dd>

        <dt class="col-sm-3">Active</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.IsActive)</dd>
      </dl>

      <div class="mt-3">
        <a asp-action="Edit" asp-route-id="@Model?.PartId" class="btn btn-primary">Edit</a>
        <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
      </div>
    </div>
  </div>
</div>
