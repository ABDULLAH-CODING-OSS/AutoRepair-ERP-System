@model AutoRepairERD.Models.Part
@{ ViewData["Title"] = Model.PartName; ViewData["ActiveNav"] = "parts"; }

@section TopbarActions {
  <a asp-action="Edit" asp-route-id="@Model.PartId" class="btn-gold btn-sm">Edit</a>
  <a asp-action="Index" class="btn-outline btn-sm">← Back</a>
}

<div class="grid-2">
  <div class="card">
    <div class="card-header"><span class="card-title">Part Info</span><span class="badge @BadgeHelper.Css(Model.IsActive)">@BadgeHelper.Text(Model.IsActive)</span></div>
    <div style="display:flex;flex-direction:column;gap:10px;padding-top:6px">
      <div><label class="form-label">Part Name</label><p style="font-size:15px;font-weight:700">@Model.PartName</p></div>
      <div><label class="form-label">SKU</label><p style="font-size:13px;color:var(--text2)">@(Model.Sku ?? "—")</p></div>
      <div><label class="form-label">Category</label><p>@(Model.Category?.CategoryName ?? "—")</p></div>
      <div><label class="form-label">Supplier</label><p>@(Model.Supplier?.SupplierName ?? "—")</p></div>
      <div><label class="form-label">Description</label><p style="font-size:13px;color:var(--text2)">@(Model.Description ?? "—")</p></div>
    </div>
  </div>
  <div class="card">
    <div class="card-header"><span class="card-title">Stock &amp; Pricing</span></div>
    <div style="display:flex;flex-direction:column;gap:10px;padding-top:6px">
      <div><label class="form-label">Current Stock</label><p style="font-size:22px;font-weight:800;font-family:'Syne',sans-serif;color:@((Model.CurrentStock <= Model.ReorderLevel) ? "var(--red)" : "var(--green)")">@Model.CurrentStock @Model.Unit</p></div>
      <div><label class="form-label">Reorder Level</label><p>@(Model.ReorderLevel ?? 0) @Model.Unit</p></div>
      <div><label class="form-label">Rack Location</label><p>@(Model.RackLocation ?? "—")</p></div>
      <div><label class="form-label">Cost Price</label><p>PKR @Model.CostPrice.ToString("N2")</p></div>
      <div><label class="form-label">Sale Price</label><p style="font-weight:600;color:var(--gold)">PKR @Model.SalePrice.ToString("N2")</p></div>
    </div>
  </div>
</div>
