
@model AutoRepairERD.Models.Part

@{
    ViewData["Title"] = "Create Part";
}

<div class="container py-4">
  <div class="card">
    <div class="card-header"><h2>Create Part</h2></div>
    <div class="card-body">
      @{ var catItems = ViewBag.Categories ?? ViewData["CategoryId"] ?? new SelectList(Enumerable.Empty<SelectListItem>()); var supItems = ViewBag.Suppliers ?? ViewData["SupplierId"] ?? new SelectList(Enumerable.Empty<SelectListItem>()); }
      <form asp-action="Create" method="post">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label">Category</label>
            <select asp-for="CategoryId" class="form-select" asp-items="@catItems">
              <option value="">-- Select Category --</option>
            </select>
            <div class="text-danger"><span asp-validation-for="CategoryId"></span></div>
          </div>
          <div class="col-md-6">
            <label class="form-label">Supplier</label>
            <select asp-for="SupplierId" class="form-select" asp-items="@supItems">
              <option value="">-- Select Supplier --</option>
            </select>
            <div class="text-danger"><span asp-validation-for="SupplierId"></span></div>
          </div>
        </div>

        <div class="row g-3 mt-2">
          <div class="col-md-4">
            <label asp-for="Sku" class="form-label"></label>
            <input asp-for="Sku" class="form-control" placeholder="SKU or part code" />
            <div class="text-danger"><span asp-validation-for="Sku"></span></div>
          </div>
          <div class="col-md-8">
            <label asp-for="PartName" class="form-label"></label>
            <input asp-for="PartName" class="form-control" placeholder="Descriptive name" />
            <div class="text-danger"><span asp-validation-for="PartName"></span></div>
          </div>
        </div>

        <div class="mt-3">
          <label asp-for="Description" class="form-label"></label>
          <textarea asp-for="Description" class="form-control" rows="2" placeholder="Optional description or notes"></textarea>
          <div class="text-danger"><span asp-validation-for="Description"></span></div>
        </div>

        <div class="row g-3 mt-3">
          <div class="col-md-4">
            <label asp-for="CostPrice" class="form-label"></label>
            <input asp-for="CostPrice" class="form-control" type="number" step="0.01" placeholder="0.00" />
            <div class="text-danger"><span asp-validation-for="CostPrice"></span></div>
          </div>
          <div class="col-md-4">
            <label asp-for="SalePrice" class="form-label"></label>
            <input asp-for="SalePrice" class="form-control" type="number" step="0.01" placeholder="0.00" />
            <div class="text-danger"><span asp-validation-for="SalePrice"></span></div>
          </div>
          <div class="col-md-4">
            <label asp-for="Unit" class="form-label"></label>
            <input asp-for="Unit" class="form-control" placeholder="e.g. pcs, set" />
            <div class="text-danger"><span asp-validation-for="Unit"></span></div>
          </div>
        </div>

        <div class="row g-3 mt-3">
          <div class="col-md-4">
            <label asp-for="CurrentStock" class="form-label"></label>
            <input asp-for="CurrentStock" class="form-control" type="number" placeholder="0" />
            <div class="text-danger"><span asp-validation-for="CurrentStock"></span></div>
          </div>
          <div class="col-md-4">
            <label asp-for="ReorderLevel" class="form-label"></label>
            <input asp-for="ReorderLevel" class="form-control" type="number" placeholder="Reorder threshold" />
            <div class="text-danger"><span asp-validation-for="ReorderLevel"></span></div>
          </div>
          <div class="col-md-4">
            <label asp-for="RackLocation" class="form-label"></label>
            <input asp-for="RackLocation" class="form-control" placeholder="Shelf / rack location" />
            <div class="text-danger"><span asp-validation-for="RackLocation"></span></div>
          </div>
        </div>

        <div class="form-check form-switch mt-3">
          <input asp-for="IsActive" class="form-check-input" />
          <label asp-for="IsActive" class="form-check-label"></label>
          <div class="text-danger"><span asp-validation-for="IsActive"></span></div>
        </div>

        <div class="mt-4">
          <button type="submit" class="btn btn-primary">Create</button>
          <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
        </div>
      </form>
    </div>
  </div>
</div>

@{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

