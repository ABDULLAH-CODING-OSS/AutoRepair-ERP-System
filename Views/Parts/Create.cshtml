@model AutoRepairERD.Models.Part
@{ ViewData["Title"] = "Add Part"; ViewData["ActiveNav"] = "parts";
   var catItems = ViewBag.Categories as Microsoft.AspNetCore.Mvc.Rendering.SelectList ?? new Microsoft.AspNetCore.Mvc.Rendering.SelectList(Enumerable.Empty<object>());
   var supItems = ViewBag.Suppliers  as Microsoft.AspNetCore.Mvc.Rendering.SelectList ?? new Microsoft.AspNetCore.Mvc.Rendering.SelectList(Enumerable.Empty<object>()); }

@section TopbarActions { <a asp-action="Index" class="btn-outline btn-sm">← Back</a> }

<div class="card" style="max-width:680px">
  <div class="card-header"><span class="card-title">New Part</span></div>
  <form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" style="color:var(--red);font-size:13px;margin-bottom:10px"></div>
    <div class="form-row-2">
      <div class="form-group"><label class="form-label">Category</label><select asp-for="CategoryId" class="form-control" asp-items="catItems"><option value="">-- None --</option></select><div style="color:var(--red)"><span asp-validation-for="CategoryId"></span></div></div>
      <div class="form-group"><label class="form-label">Supplier</label><select asp-for="SupplierId" class="form-control" asp-items="supItems"><option value="">-- None --</option></select><div style="color:var(--red)"><span asp-validation-for="SupplierId"></span></div></div>
    </div>
    <div class="form-row-2">
      <div class="form-group"><label asp-for="Sku" class="form-label"></label><input asp-for="Sku" class="form-control" placeholder="SKU / Part Code" /></div>
      <div class="form-group"><label asp-for="PartName" class="form-label"></label><input asp-for="PartName" class="form-control" placeholder="Descriptive part name" /><span asp-validation-for="PartName" style="color:var(--red);font-size:12px"></span></div>
    </div>
    <div class="form-group"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="2"></textarea></div>
    <div class="form-row-3">
      <div class="form-group"><label asp-for="CostPrice" class="form-label"></label><input asp-for="CostPrice" class="form-control" type="number" step="0.01" placeholder="0.00" /><span asp-validation-for="CostPrice" style="color:var(--red);font-size:12px"></span></div>
      <div class="form-group"><label asp-for="SalePrice" class="form-label"></label><input asp-for="SalePrice" class="form-control" type="number" step="0.01" placeholder="0.00" /><span asp-validation-for="SalePrice" style="color:var(--red);font-size:12px"></span></div>
      <div class="form-group"><label asp-for="Unit" class="form-label"></label><input asp-for="Unit" class="form-control" placeholder="pcs, set, litre…" /></div>
    </div>
    <div class="form-row-3">
      <div class="form-group"><label asp-for="CurrentStock" class="form-label"></label><input asp-for="CurrentStock" class="form-control" type="number" placeholder="0" /></div>
      <div class="form-group"><label asp-for="ReorderLevel" class="form-label"></label><input asp-for="ReorderLevel" class="form-control" type="number" placeholder="Reorder threshold" /></div>
      <div class="form-group"><label asp-for="RackLocation" class="form-label"></label><input asp-for="RackLocation" class="form-control" placeholder="e.g. A-12" /></div>
    </div>
    <div class="form-group">
      <label class="form-label">Active</label>
      <div style="display:flex;align-items:center;gap:8px;padding-top:6px">
        <input type="hidden" name="IsActive" value="false" />
        <input name="IsActive" type="checkbox" value="true" @(Model?.IsActive == true ? "checked" : "") style="width:16px;height:16px;accent-color:var(--gold)" />
        <span style="font-size:13px;color:var(--text2)">Part is active and available for use in job orders</span>
      </div>
    </div>
    <div style="display:flex;gap:10px;margin-top:6px">
      <button type="submit" class="btn-gold">Save Part</button>
      <a asp-action="Index" class="btn-outline btn-sm">Cancel</a>
    </div>
  </form>
</div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
