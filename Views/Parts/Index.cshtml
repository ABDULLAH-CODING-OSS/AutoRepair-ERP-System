@model IEnumerable<AutoRepairERD.Models.Part>
@{ ViewData["Title"] = "Parts Inventory"; ViewData["ActiveNav"] = "parts"; }

@section TopbarActions {
  <a asp-action="Create" class="btn-gold btn-sm">+ Add Part</a>
  <a href="/LowStockAlerts" class="btn-outline btn-sm" style="color:var(--red)">⚠ Low Stock</a>
}

<div class="card">
  <div class="card-header"><span class="card-title">Parts Inventory (@Model.Count())</span>
    <form method="get" style="margin-left:auto;display:flex;gap:8px;align-items:center">
      <input type="search" name="q" value="@(ViewBag.SearchQuery ?? "")" placeholder="Search part, SKU, category, supplier" class="form-control" style="width:320px;padding:8px 10px">
      <button type="submit" class="btn-outline btn-sm">Search</button>
    </form>
  </div>
  <div class="table-wrap"><table class="erp-table">
    <thead><tr><th>Part Name</th><th>SKU</th><th>Category</th><th>Supplier</th><th>Cost</th><th>Sale Price</th><th>Stock</th><th>Status</th><th></th></tr></thead>
    <tbody>
      @if (!Model.Any()) { <tr><td colspan="9" class="td-muted" style="text-align:center;padding:24px">No parts in inventory yet.</td></tr> }
      @foreach (var p in Model)
      {
          var lowStock = (p.ReorderLevel.HasValue && p.CurrentStock.HasValue && p.CurrentStock <= p.ReorderLevel);
          <tr onclick="carTransition('/Parts/Details/@p.PartId','PART DETAIL')">
            <td class="td-gold">@p.PartName</td>
            <td class="td-muted">@p.Sku</td>
            <td>@p.Category?.CategoryName</td>
            <td>@p.Supplier?.SupplierName</td>
            <td>PKR @p.CostPrice.ToString("N0")</td>
            <td>PKR @p.SalePrice.ToString("N0")</td>
            <td>
                @if (lowStock)
                {
                    <span class="badge badge-low">@p.CurrentStock</span>
                }
                else
                {
                    <span class="badge badge-ok">@p.CurrentStock</span>
                }
            </td>
            <td><span class="badge @BadgeHelper.Css(p.IsActive)">@BadgeHelper.Text(p.IsActive)</span></td>
            <td style="white-space:nowrap">
              <a asp-action="Edit" asp-route-id="@p.PartId" class="btn-outline btn-sm">Edit</a>
              <a asp-action="Details" asp-route-id="@p.PartId" class="btn-outline btn-sm">View</a>
              <a asp-action="Delete" asp-route-id="@p.PartId" class="btn-outline btn-sm" style="color:var(--red)">Delete</a>
            </td>
          </tr>
      }
    </tbody>
  </table></div>
</div>
