@model IEnumerable<AutoRepairERD.Models.Part>

@{
    ViewData["Title"] = "Parts";
}

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Parts</h1>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
  </div>

  <div class="card">
    <div class="card-body p-0">
      <table class="table table-striped table-hover table-responsive mb-0">
        <thead class="table-light">
          <tr>
            <th>Category</th>
            <th>Supplier</th>
            <th>Part Code</th>
            <th>Part Name</th>
            <th>Description</th>
            <th class="text-center">Cost Price</th>
            <th class="text-center">Sale Price</th>
            <th class="text-center">Current Stock</th>
            <th class="text-center">Reorder Level</th>
            <th>Unit</th>
            <th>Rack Location</th>
            <th class="text-center">Status</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
@foreach (var item in Model) {
          <tr>
            <td>@(item.Category?.CategoryName ?? item.CategoryId.ToString())</td>
                            <td>@(item.Supplier?.CompanyName ?? item.SupplierId.ToString())</td>
            <td>@Html.DisplayFor(_ => item.Sku)</td>
            <td>@Html.DisplayFor(_ => item.PartName)</td>
            <td>@Html.DisplayFor(_ => item.Description)</td>
            <td class="text-center">@String.Format("{0:C}", item.CostPrice)</td>
            <td class="text-center">@String.Format("{0:C}", item.SalePrice)</td>
            <td class="text-center">@Html.DisplayFor(_ => item.CurrentStock)</td>
            <td class="text-center">@Html.DisplayFor(_ => item.ReorderLevel)</td>
            <td>@Html.DisplayFor(_ => item.Unit)</td>
            <td>@Html.DisplayFor(_ => item.RackLocation)</td>
            <td class="text-center">
              @if (item.IsActive == true) {
                <span class="badge bg-success">Active</span>
              } else {
                <span class="badge bg-secondary">Inactive</span>
              }
            </td>
            <td class="text-end">
              <a asp-action="Edit" asp-route-id="@item.PartId" class="btn btn-sm btn-outline-primary me-1">Edit</a>
              <a asp-action="Details" asp-route-id="@item.PartId" class="btn btn-sm btn-outline-secondary me-1">Details</a>
              <a asp-action="Delete" asp-route-id="@item.PartId" class="btn btn-sm btn-outline-danger">Delete</a>
            </td>
          </tr>
}
        </tbody>
      </table>
    </div>
  </div>
</div>
