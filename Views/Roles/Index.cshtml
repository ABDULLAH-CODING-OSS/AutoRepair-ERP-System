@model IEnumerable<AutoRepairERD.Models.RoleListItem>
@{ ViewData["Title"] = "Roles"; ViewData["ActiveNav"] = "roles"; }

@section TopbarActions { <a asp-controller="UserRoles" asp-action="Index" class="btn-outline btn-sm" style="margin-right:8px">Assign Roles</a> <a asp-action="Create" class="btn-gold btn-sm">+ Add Role</a> }

<div class="card">
  <div class="card-header"><span class="card-title">System Roles (@Model.Count())</span></div>
  <div class="table-wrap"><table class="erp-table">
    <thead><tr><th>Role Name</th><th>Description</th><th>Users</th><th></th></tr></thead>
    <tbody>
      @if (!Model.Any()) { <tr><td colspan="4" class="td-muted" style="text-align:center;padding:24px">No roles configured.</td></tr> }
      @foreach (var r in Model)
      {
          <tr>
            <td class="td-gold">@r.RoleName</td>
            <td class="td-muted">@r.Description</td>
            <td><span class="badge badge-neutral">@r.AssignedCount</span></td>
            <td style="white-space:nowrap">
              <a asp-action="Edit" asp-route-id="@r.RoleId" class="btn-outline btn-sm">Edit</a>
              <a asp-action="Delete" asp-route-id="@r.RoleId" class="btn-outline btn-sm" style="color:var(--red)">Delete</a>
            </td>
          </tr>
      }
    </tbody>
  </table></div>
</div>
