@model IEnumerable<AutoRepairERD.Models.RoleListItem>

@{
    ViewData["Title"] = "Roles";
}

<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="card-title mb-0">Roles</h3>
            <div>
                <form asp-action="Index" method="get" class="d-flex">
                    <input type="search" name="search" value="@(ViewBag.Search ?? "")" class="form-control form-control-sm me-2" placeholder="Search role name" />
                    <button class="btn btn-outline-secondary btn-sm me-2" type="submit">Search</button>
                    <a class="btn btn-primary btn-sm" asp-action="Create">New Role</a>
                </form>
            </div>
        </div>

        @if (TempData["Toast"] != null)
        {
            var toastType = (TempData["ToastType"] ?? "info").ToString();
            <div class="alert alert-@toastType alert-dismissible fade show" role="alert">
                @TempData["Toast"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="table-responsive">
            <table class="table table-striped table-sm">
                <thead>
                    <tr>
                        <th>Role Name</th>
                        <th>Description</th>
                        <th class="text-end">Users</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.RoleName</td>
                            <td>@item.Description</td>
                            <td class="text-end">@item.AssignedCount</td>
                            <td>
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.RoleId">Edit</a>
                                <a class="btn btn-sm btn-outline-secondary ms-1" asp-action="Details" asp-route-id="@item.RoleId">Details</a>
                                <a class="btn btn-sm btn-outline-danger ms-1" asp-action="Delete" asp-route-id="@item.RoleId">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
