@model AutoRepairERD.Models.Role

@{
    ViewData["Title"] = "Role Details";
}

<div class="card">
    <div style="padding:4px 0">
        <h4 class="card-title">@Model.RoleName</h4>
        <div class="text-muted mb-3">@Model.Description</div>

        <dl class="row">
            <dt class="col-sm-3">Assigned Users</dt>
            <dd class="col-sm-9">@(ViewBag.AssignedCount ?? Model.UserRoles?.Count() ?? 0)</dd>
        </dl>

        <div style="display:flex">
            <a asp-action="Edit" asp-route-id="@Model.RoleId" class="btn-gold btn-sm">Edit</a>
            <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
        </div>
    </div>
</div>
