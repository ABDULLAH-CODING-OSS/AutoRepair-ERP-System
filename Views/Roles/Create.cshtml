@model AutoRepairERD.Models.Role

@{
    ViewData["Title"] = "Create Role";
}

<div class="card">
    <div style="padding:4px 0">
        <h4 class="card-title">Create Role</h4>
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div style="margin-bottom:12px">
                <label asp-for="RoleName" class="form-label"></label>
                <input asp-for="RoleName" class="form-control" />
                <span asp-validation-for="RoleName" style="color:var(--red)"></span>
            </div>

            <div style="margin-bottom:12px">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" style="color:var(--red)"></span>
            </div>

            @* IsActive removed from schema; status managed elsewhere *@

            <div style="display:flex">
                <button type="submit" class="btn-gold btn-sm">Create Role</button>
                <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
            </div>
        </form>
    </div>
</div>
