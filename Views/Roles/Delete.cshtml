@model AutoRepairERD.Models.Role

@{
    ViewData["Title"] = "Delete Role";
}

<div class="card">
    <div class="card-body">
        <h4 class="card-title">Delete Role</h4>
        <p>Are you sure you want to delete this role?</p>

        <dl class="row">
            <dt class="col-sm-3">Role Name</dt>
            <dd class="col-sm-9">@Model.RoleName</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@Model.Description</dd>

            <dt class="col-sm-3">Assigned Users</dt>
            <dd class="col-sm-9">@(ViewBag.AssignedCount ?? 0)</dd>
        </dl>

        @if ((ViewBag.AssignedCount ?? 0) > 0)
        {
            <div class="alert alert-warning">This role is assigned to users and cannot be deleted.</div>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        }
        else
        {
            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="RoleId" />
                <button type="submit" class="btn btn-danger">Delete Role</button>
                <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
            </form>
        }
    </div>
</div>
