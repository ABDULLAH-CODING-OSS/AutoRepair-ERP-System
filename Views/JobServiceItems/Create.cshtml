@model AutoRepairERD.Models.JobServiceItem

@{
    ViewData["Title"] = "Add Service to Job";
}

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Add Service</h5>
    </div>
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label class="form-label">Job Order <span class="text-danger">*</span></label>
                <select asp-for="JobOrderId" class="form-select" asp-items="ViewBag.JobOrders"></select>
                <span asp-validation-for="JobOrderId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Service <span class="text-danger">*</span></label>
                <select asp-for="ServiceId" class="form-select" asp-items="ViewBag.Services"></select>
                <span asp-validation-for="ServiceId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Mechanic</label>
                <select asp-for="MechanicId" class="form-select" asp-items="ViewBag.Mechanics"></select>
                <span asp-validation-for="MechanicId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="HoursWorked" class="form-label">Hours Worked</label>
                <input asp-for="HoursWorked" class="form-control" placeholder="e.g. 1.5" />
                <span asp-validation-for="HoursWorked" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Notes" class="form-label">Notes</label>
                <input asp-for="Notes" class="form-control" placeholder="Optional notes" />
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>

            <div>
                <button type="submit" class="btn btn-primary">Add Service</button>
                <a class="btn btn-secondary ms-2" asp-action="Index">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
