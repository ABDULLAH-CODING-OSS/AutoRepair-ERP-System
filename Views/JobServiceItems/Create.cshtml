@model AutoRepairERD.Models.JobServiceItem

@{
    ViewData["Title"] = "Add Service to Job";
}

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Add Service</h5>
    </div>
    <div style="padding:4px 0">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div style="margin-bottom:12px">
                <label class="form-label">Job Order <span style="color:var(--red)">*</span></label>
        <select asp-for="JobOrderId" id="jobOrderSelect" class="form-control" asp-items="ViewBag.JobOrders"></select>
                <span asp-validation-for="JobOrderId" style="color:var(--red)"></span>
            </div>

            <div style="margin-bottom:12px">
                <label class="form-label">Service <span style="color:var(--red)">*</span></label>
                <select asp-for="ServiceId" class="form-control" asp-items="ViewBag.Services"></select>
                <span asp-validation-for="ServiceId" style="color:var(--red)"></span>
            </div>

            @* <div style="margin-bottom:12px">
                <label class="form-label">Mechanic</label>
                @if (ViewBag.ReadonlyMechanic == true)
                {
                    <div class="form-control-plaintext">@(ViewBag.ReadonlyMechanicText ?? "Assigned")</div>
                    <input type="hidden" asp-for="MechanicId" />
                }
                else
                {
                    <select asp-for="MechanicId" class="form-control" asp-items="ViewBag.Mechanics" id="mechanicSelect"></select>
                }
                <span asp-validation-for="MechanicId" style="color:var(--red)"></span>
            </div> *@

            <div style="margin-bottom:12px">
                <label asp-for="HoursWorked" class="form-label">Hours Worked</label>
                <input asp-for="HoursWorked" class="form-control" placeholder="e.g. 1.5" />
                <span asp-validation-for="HoursWorked" style="color:var(--red)"></span>
            </div>

            <div style="margin-bottom:12px">
                <label asp-for="Notes" class="form-label">Notes</label>
                <input asp-for="Notes" class="form-control" placeholder="Optional notes" />
                <span asp-validation-for="Notes" style="color:var(--red)"></span>
            </div>

            <div>
                <button type="submit" class="btn-gold btn-sm">Add Service</button>
                <a class="btn btn-secondary ms-2" asp-action="Index">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        (function () {
            function checkJobMechanic(jobId) {
                if (!jobId) return;
                fetch('/JobOrders/GetJobMechanic?jobId=' + jobId)
                    .then(r => r.json())
                    .then(data => {
                        var mechSelect = document.getElementById('mechanicSelect');
                        if (data && data.mechanicId) {
                            if (mechSelect) {
                                mechSelect.value = data.mechanicId;
                                mechSelect.disabled = true;
                            } else {
                                // if select isn't present (server rendered readonly), set hidden input
                                var hidden = document.querySelector('input[name="MechanicId"]');
                                if (hidden) hidden.value = data.mechanicId;
                            }
                        } else {
                            if (mechSelect) mechSelect.disabled = false;
                        }
                    });
            }

            // On initial load: if a default mechanic id is provided from the server,
            // set the mechanic select and make it readonly (disabled).
            var defaultMech = '@(ViewBag.DefaultMechanicId ?? "")';
            var mechSelect = document.getElementById('mechanicSelect');
            if (mechSelect && defaultMech) {
                mechSelect.value = defaultMech;
                mechSelect.disabled = true;
            }

            // Update mechanic selection when job order changes.
            var jobOrderSelect = document.getElementById('jobOrderSelect');
            if (jobOrderSelect) {
                jobOrderSelect.addEventListener('change', function () {
                    checkJobMechanic(this.value);
                });
            }

            // On load, if a job is already selected, check its mechanic.
            var selectedJob = jobOrderSelect ? jobOrderSelect.value : '';
            if (selectedJob) {
                checkJobMechanic(selectedJob);
            }
        })();
    </script>
}
