@model AutoRepairERD.Models.JobServiceItem

@{
    ViewData["Title"] = "Delete Service Item";
}

<div class="card border-warning">
    <div class="card-header bg-warning text-dark">
        <h5 class="mb-0">Confirm Delete</h5>
    </div>
    <div class="card-body">
        <p>Are you sure you want to delete the following service item?</p>
        <div class="row">
            <div class="col-md-8">
                <p><strong>Job:</strong> @(Model?.JobOrder?.JobNumber ?? Model?.JobOrderId.ToString())</p>
                <p><strong>Service:</strong> @(Model?.Service?.ServiceName ?? "-")</p>
                <p><strong>Mechanic:</strong> @(Model?.Mechanic != null ? Model.Mechanic.FirstName + " " + Model.Mechanic.LastName : "-")</p>
            </div>
            <div class="col-md-4 text-end">
                <p><strong>Hours:</strong> @(Model?.HoursWorked?.ToString() ?? "-")</p>
                <p><strong>Price:</strong> @((Model != null && Model.ServicePrice.HasValue) ? Model.ServicePrice.Value.ToString("C") : "-")</p>
            </div>
        </div>
    </div>
    <div class="card-footer">
        <form asp-action="Delete" method="post" class="d-inline">
            <input type="hidden" asp-for="JobServiceItemId" />
            <button type="submit" class="btn btn-danger">Delete</button>
        </form>
        <a class="btn btn-secondary ms-2" asp-action="Index">Cancel</a>
    </div>
</div>
