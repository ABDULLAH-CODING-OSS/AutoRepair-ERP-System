@model IEnumerable<AutoRepairERD.Models.JobServiceItem>

@{
    ViewData["Title"] = "Job Service Items";
}

<div class="card-header">
    <h1 class="h3">Job Service Items</h1>
    <a class="btn-gold btn-sm" asp-action="Create">Create</a>
</div>

<div class="table-wrap">
    <table class="erp-table">
        <thead >
            <tr>
                <th>Job #</th>
                <th>Service</th>
                <th>Mechanic</th>
                <th>Hours</th>
                <th style="text-align:right">Rate</th>
                <th style="text-align:right">Price</th>
                <th>Notes</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@(item.JobOrder?.JobNumber ?? item.JobOrderId.ToString())</td>
                <td>
                    @if (item.Service != null)
                    {
                        <span class="badge badge-ordered">@item.Service.ServiceName</span>
                    }
                    else
                    {
                        @item.ServiceId
                    }
                </td>
                <td>@(item.Mechanic != null ? item.Mechanic.FirstName + " " + item.Mechanic.LastName : "-")</td>
                <td>@(item.HoursWorked?.ToString() ?? "-")</td>
                <td style="text-align:right">@((item.HourlyRate.HasValue) ? item.HourlyRate.Value.ToString("C") : "-")</td>
                <td style="text-align:right">@((item.ServicePrice.HasValue) ? item.ServicePrice.Value.ToString("C") : "-")</td>
                <td>@item.Notes</td>
                <td>
                    <a class="btn-gold btn-sm" asp-action="Edit" asp-route-id="@item.JobServiceItemId">Edit</a>
                    <a class="btn btn-sm btn-info text-white" asp-action="Details" asp-route-id="@item.JobServiceItemId">Details</a>
                    <a class="btn-danger btn-sm" asp-action="Delete" asp-route-id="@item.JobServiceItemId">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
