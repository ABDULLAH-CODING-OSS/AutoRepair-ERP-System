@model IEnumerable<AutoRepairERD.Models.JobServiceItem>

@{
    ViewData["Title"] = "Job Service Items";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">Job Service Items</h1>
    <a class="btn btn-success" asp-action="Create">Create</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-light">
            <tr>
                <th>Job #</th>
                <th>Service</th>
                <th>Mechanic</th>
                <th>Hours</th>
                <th class="text-end">Rate</th>
                <th class="text-end">Price</th>
                <th>Notes</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@(item.JobOrder?.JobNumber ?? item.JobOrderId.ToString())</td>
                <td>
                    @if (item.Service != null)
                    {
                        <span class="badge bg-primary">@item.Service.ServiceName</span>
                    }
                    else
                    {
                        @item.ServiceId
                    }
                </td>
                <td>@(item.Mechanic != null ? item.Mechanic.FirstName + " " + item.Mechanic.LastName : "-")</td>
                <td>@(item.HoursWorked?.ToString() ?? "-")</td>
                <td class="text-end">@((item.HourlyRate.HasValue) ? item.HourlyRate.Value.ToString("C") : "-")</td>
                <td class="text-end">@((item.ServicePrice.HasValue) ? item.ServicePrice.Value.ToString("C") : "-")</td>
                <td>@item.Notes</td>
                <td>
                    <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@item.JobServiceItemId">Edit</a>
                    <a class="btn btn-sm btn-info text-white" asp-action="Details" asp-route-id="@item.JobServiceItemId">Details</a>
                    <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.JobServiceItemId">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
