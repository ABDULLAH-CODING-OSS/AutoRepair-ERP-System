@model AutoRepairERD.Models.JobServiceItem

@{
    ViewData["Title"] = "Edit Service Item";
}

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Edit Service</h5>
    </div>
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="JobServiceItemId" />

            <div class="mb-3">
                <label class="form-label">Job Order</label>
                <div class="form-control-plaintext">@((Model?.JobOrder != null) ? Model.JobOrder.JobNumber : Model?.JobOrderId.ToString())</div>
                <input type="hidden" asp-for="JobOrderId" />
            </div>

            <div class="mb-3">
                <label class="form-label">Service <span class="text-danger">*</span></label>
                <select asp-for="ServiceId" class="form-select" asp-items="ViewBag.Services"></select>
                <span asp-validation-for="ServiceId" class="text-danger"></span>
            </div>

            @* <div class="mb-3">
                <label class="form-label">Mechanic</label>
                @if (ViewBag.ReadonlyMechanic == true)
                {
                    <div class="form-control-plaintext">@((Model?.Mechanic != null) ? Model.Mechanic.FirstName + " " + Model.Mechanic.LastName : "-" )</div>
                    <input type="hidden" asp-for="MechanicId" />
                }
                else
                {
                    <select asp-for="MechanicId" class="form-select" asp-items="ViewBag.Mechanics"></select>
                }
            </div> *@

            <div class="mb-3">
                <label asp-for="HoursWorked" class="form-label">Hours Worked</label>
                <input asp-for="HoursWorked" class="form-control" placeholder="e.g. 1.5" />
                <span asp-validation-for="HoursWorked" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Notes</label>
                <input asp-for="Notes" class="form-control" />
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Hourly Rate</label>
                <div class="form-control-plaintext">@((Model != null && Model.HourlyRate.HasValue) ? Model.HourlyRate.Value.ToString("C") : "-")</div>
            </div>

            <div class="mb-3">
                <label class="form-label">Service Price</label>
                <div class="form-control-plaintext">@((Model != null && Model.ServicePrice.HasValue) ? Model.ServicePrice.Value.ToString("C") : "-")</div>
            </div>

            <div>
                <button type="submit" class="btn btn-primary">Save</button>
                <a class="btn btn-secondary ms-2" asp-action="Index">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
