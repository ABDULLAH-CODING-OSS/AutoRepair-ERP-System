@model IEnumerable<AutoRepairERD.Models.Category>
@{ ViewData["Title"] = "Categories"; ViewData["ActiveNav"] = "categories"; }

@section TopbarActions { <a asp-action="Create" class="btn-gold btn-sm">+ Add Category</a> }

<div class="card">
  <div class="card-header"><span class="card-title">Part Categories (@Model.Count())</span></div>
  <div class="table-wrap"><table class="erp-table">
    <thead><tr><th>Category Name</th><th>Description</th><th>Parts</th><th></th></tr></thead>
    <tbody>
      @if (!Model.Any()) { <tr><td colspan="4" class="td-muted" style="text-align:center;padding:24px">No categories yet.</td></tr> }
      @foreach (var c in Model)
      {
          <tr>
            <td class="td-gold">@c.CategoryName</td>
            <td class="td-muted">@c.Description</td>
            <td><span class="badge badge-neutral">@c.Parts.Count</span></td>
            <td style="white-space:nowrap">
              <a asp-action="Edit" asp-route-id="@c.CategoryId" class="btn-outline btn-sm">Edit</a>
              <a asp-action="Delete" asp-route-id="@c.CategoryId" class="btn-outline btn-sm" style="color:var(--red)">Delete</a>
            </td>
          </tr>
      }
    </tbody>
  </table></div>
</div>
