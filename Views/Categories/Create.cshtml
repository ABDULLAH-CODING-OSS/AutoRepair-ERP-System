@model AutoRepairERD.Models.Category

@{
    ViewData["Title"] = "Create Category";
}

<div class="container py-4">
  <div class="card">
    <div class="card-header">
      <h2>Create Category</h2>
    </div>
    <div class="card-body">
      <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
          <label asp-for="CategoryName" class="form-label"></label>
          <input asp-for="CategoryName" class="form-control" />
          <div class="text-danger"><span asp-validation-for="CategoryName"></span></div>
        </div>

        <div class="mb-3">
          <label asp-for="Description" class="form-label"></label>
          <textarea asp-for="Description" class="form-control" rows="3"></textarea>
          <div class="text-danger"><span asp-validation-for="Description"></span></div>
        </div>

        <!-- Navigation/collection fields removed from the form: Parts is a navigation property (ICollection<Part>) and should not be edited here. -->

        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-primary">Create</button>
          <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
      </form>
    </div>
  </div>
</div>
