@model AutoRepairERD.Models.Category

@{
    ViewData["Title"] = "Delete Category";
}

<div class="container py-4">
  <div class="card">
    <div class="card-header">
      <h2>Delete Category</h2>
    </div>
    <div class="card-body">
      <p class="text-danger">Are you sure you want to delete this category?</p>

      <dl class="row mb-3">
        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.CategoryName)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.CategoryName)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Description)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.Description)</dd>
      </dl>

      <!-- Navigation/collection display removed: Parts is a navigation property and is not shown here. -->

      <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="CategoryId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
      </form>
    </div>
  </div>
</div>
