@model AutoRepairERD.Models.PurchaseOrderItem

@{
    ViewData["Title"] = "Delete Purchase Order Item";
}

<div class="card">
    <div class="card-body">
        <h4 class="card-title">Delete Purchase Order Item</h4>

        @* If the parent purchase order is received, block delete and show only that message. *@
        @if (Model.PurchaseOrder?.Status == "Received")
        {
            <div class="alert alert-warning">This purchase order has already been received. Items can no longer be deleted.</div>
            <div class="mb-3">
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        }
        else
        {
            <div class="mb-3">
                <h5>Purchase Order Item Summary</h5>
                <dl class="row">
                    <dt class="col-sm-3">Purchase Order</dt>
                    <dd class="col-sm-9">@("PO-" + (Model.PurchaseOrder?.PurchaseOrderId.ToString() ?? "-"))</dd>

                    <dt class="col-sm-3">Part</dt>
                    <dd class="col-sm-9">@Model.Part?.PartName</dd>

                    <dt class="col-sm-3">Quantity</dt>
                    <dd class="col-sm-9">@Model.Quantity</dd>

                    <dt class="col-sm-3">Unit Cost</dt>
                    <dd class="col-sm-9">@String.Format("{0:C}", Model.UnitCost ?? 0m)</dd>

                    <dt class="col-sm-3">Line Total</dt>
                    <dd class="col-sm-9">@String.Format("{0:C}", Model.TotalCost ?? 0m)</dd>
                </dl>
            </div>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="PoitemId" />
                <div class="d-flex">
                    <button type="submit" class="btn btn-danger">Delete Item</button>
                    <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
                </div>
            </form>
        }
    </div>
</div>
