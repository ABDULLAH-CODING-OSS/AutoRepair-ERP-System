@model AutoRepairERD.Models.PurchaseOrderItem

@{
    ViewData["Title"] = "Edit Purchase Order Item";
}

<div class="card">
    <div class="card-body">
        <h4 class="card-title">Edit Item</h4>

        <form asp-action="Edit" asp-route-id="@Model.PoitemId" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            @if (ViewBag.Locked != null && (bool)ViewBag.Locked)
            {
                <div class="alert alert-warning">This purchase order has been received and items cannot be modified.</div>
            }
            <input type="hidden" asp-for="PoitemId" />

            <div class="mb-3">
                <label class="form-label">Purchase Order</label>
                <select asp-for="PurchaseOrderId" class="form-select" asp-items="ViewBag.PurchaseOrders"></select>
                <span asp-validation-for="PurchaseOrderId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Part</label>
                <select asp-for="PartId" class="form-select" asp-items="ViewBag.Parts"></select>
                <span asp-validation-for="PartId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Quantity" class="form-label"></label>
                <input asp-for="Quantity" class="form-control" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Unit Cost</label>
                <input class="form-control" value="@String.Format("{0:C}", Model.UnitCost ?? 0m)" readonly />
            </div>

            <div class="mb-3">
                <label class="form-label">Line Total</label>
                <input class="form-control" value="@String.Format("{0:C}", Model.TotalCost ?? 0m)" readonly />
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary" @(ViewBag.Locked != null && (bool)ViewBag.Locked ? "disabled" : "")>Save</button>
                <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
