@model IEnumerable<AutoRepairERD.Models.PurchaseOrderItem>

@{
    ViewData["Title"] = "Purchase Order Items";
}

<div class="card">
    <div class="card-body">
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="card-title mb-0">Purchase Order Items</h3>
            <a class="btn btn-primary" asp-action="Create">Add Item</a>
        </div>

        <div class="table-responsive">
            <table class="table table-sm table-striped">
                <thead>
                    <tr>
                        <th>Purchase Order</th>
                        <th>Part</th>
                        <th class="text-end">Quantity</th>
                        <th class="text-end">Unit Cost</th>
                        <th class="text-end">Line Total</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@("PO-" + (item.PurchaseOrder?.PurchaseOrderId.ToString() ?? "-"))</td>
                            <td>@(item.Part?.PartName ?? "-")</td>
                            <td class="text-end">@item.Quantity</td>
                            <td class="text-end">@String.Format("{0:C}", item.UnitCost ?? 0m)</td>
                            <td class="text-end">@String.Format("{0:C}", item.TotalCost ?? 0m)</td>
                            <td>
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.PoitemId">Edit</a>
                                <a class="btn btn-sm btn-outline-secondary ms-1" asp-action="Details" asp-route-id="@item.PoitemId">Details</a>
                                <a class="btn btn-sm btn-outline-danger ms-1" asp-action="Delete" asp-route-id="@item.PoitemId">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
