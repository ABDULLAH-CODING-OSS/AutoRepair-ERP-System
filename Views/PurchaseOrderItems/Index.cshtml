@model IEnumerable<AutoRepairERD.Models.PurchaseOrderItem>

@{
    ViewData["Title"] = "Purchase Order Items";
}

<div class="card">
    <div style="padding:4px 0">
        @if (TempData["Error"] != null)
        {
            <div style="background:var(--red-dim);border:1px solid rgba(240,79,79,0.3);border-radius:8px;padding:12px;color:var(--red);font-size:13px;margin-bottom:12px">@TempData["Error"]</div>
        }
        <div class="card-header">
            <h3 class="card-title mb-0">Purchase Order Items</h3>
            <a class="btn-gold btn-sm" asp-action="Create">Add Item</a>
        </div>

        <div class="table-wrap">
            <table class="table table-sm table-striped">
                <thead>
                    <tr>
                        <th>Purchase Order</th>
                        <th>Part</th>
                        <th style="text-align:right">Quantity</th>
                        <th style="text-align:right">Unit Cost</th>
                        <th style="text-align:right">Line Total</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@("PO-" + (item.PurchaseOrder?.PurchaseOrderId.ToString() ?? "-"))</td>
                            <td>@(item.Part?.PartName ?? "-")</td>
                            <td style="text-align:right">@item.Quantity</td>
                            <td style="text-align:right">@String.Format("{0:C}", item.UnitCost ?? 0m)</td>
                            <td style="text-align:right">@String.Format("{0:C}", item.TotalCost ?? 0m)</td>
                            <td>
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.PoitemId">Edit</a>
                                <a class="btn btn-sm btn-outline-secondary ms-1" asp-action="Details" asp-route-id="@item.PoitemId">Details</a>
                                <a class="btn btn-sm btn-outline-danger ms-1" asp-action="Delete" asp-route-id="@item.PoitemId">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
