@model AutoRepairERD.Models.PurchaseOrderItem

@{
    ViewData["Title"] = "Add Purchase Order Item";
}

<div class="card">
    <div class="card-body">
        <h4 class="card-title">Add Item</h4>

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label class="form-label">Purchase Order</label>
                <select asp-for="PurchaseOrderId" class="form-select" asp-items="ViewBag.PurchaseOrders">
                    <option value="">-- Select Purchase Order --</option>
                </select>
                <span asp-validation-for="PurchaseOrderId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Part</label>
                <select asp-for="PartId" class="form-select" asp-items="ViewBag.Parts">
                    <option value="">-- Select Part --</option>
                </select>
                <span asp-validation-for="PartId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Quantity" class="form-label"></label>
                <input asp-for="Quantity" class="form-control" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>

            @* Unit cost and line total are calculated on the server and are not shown on the create form. *@

            <div class="mb-3">
                <input type="submit" value="Add Item" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
