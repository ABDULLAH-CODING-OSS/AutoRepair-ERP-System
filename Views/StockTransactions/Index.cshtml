@model IEnumerable<AutoRepairERD.Models.StockTransaction>
@{ ViewData["Title"] = "Stock Transactions"; ViewData["ActiveNav"] = "stock-transactions"; }

@section TopbarActions { <a asp-action="Create" class="btn-gold btn-sm">+ New Transaction</a> }

<div class="card">
  <div class="card-header"><span class="card-title">Stock Transactions (@Model.Count())</span></div>
  <div class="table-wrap"><table class="erp-table">
    <thead><tr><th>Date</th><th>Part</th><th>Type</th><th>Qty</th><th>Before</th><th>After</th><th>Reference</th><th>Remarks</th></tr></thead>
    <tbody>
      @if (!Model.Any()) { <tr><td colspan="8" class="td-muted" style="text-align:center;padding:24px">No stock transactions recorded.</td></tr> }
      @foreach (var t in Model)
      {
          <tr>
            <td class="td-muted">@(t.TransactionDate?.ToString("MMM d, yyyy"))</td>
            <td class="td-gold">@t.Part?.PartName</td>
            <td><span class="badge @BadgeHelper.Css(t.TransactionType)">@t.TransactionType</span></td>
            <td><strong>@t.Quantity</strong></td>
            <td>@t.PreviousStock</td>
            <td>@t.NewStock</td>
            <td class="td-muted" style="font-size:12px">@t.ReferenceNumber</td>
            <td class="td-muted" style="font-size:12px">@t.Remarks</td>
          </tr>
      }
    </tbody>
  </table></div>
</div>
