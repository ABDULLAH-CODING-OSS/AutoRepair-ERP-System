@model AutoRepairERD.Models.StockTransaction

@{
    ViewData["Title"] = "Edit Transaction";
}

<div class="card">
    <div class="card-body">
        <h4 class="card-title">Edit Transaction</h4>

        @if ((bool?)ViewBag.IsSystemGenerated == true)
        {
            <div class="alert alert-warning">This transaction is system-generated and cannot be modified. You may view details below.</div>

            <dl class="row mb-3">
                <dt class="col-sm-3">Part</dt>
                <dd class="col-sm-9">@Model.Part?.PartName</dd>

                <dt class="col-sm-3">Transaction Type</dt>
                <dd class="col-sm-9">@Model.TransactionType</dd>

                <dt class="col-sm-3">Quantity</dt>
                <dd class="col-sm-9">@Model.Quantity</dd>

                <dt class="col-sm-3">Previous Stock</dt>
                <dd class="col-sm-9">@Model.PreviousStock</dd>

                <dt class="col-sm-3">New Stock</dt>
                <dd class="col-sm-9">@Model.NewStock</dd>

                <dt class="col-sm-3">Reference</dt>
                <dd class="col-sm-9">@Model.ReferenceNumber</dd>

                <dt class="col-sm-3">Remarks</dt>
                <dd class="col-sm-9">@Model.Remarks</dd>

                <dt class="col-sm-3">Date</dt>
                <dd class="col-sm-9">@(Model.TransactionDate?.ToString("dd-MMM-yyyy"))</dd>
            </dl>

            <a asp-action="Index" class="btn btn-secondary">Back</a>
            <a asp-action="Delete" asp-route-transactionid="@Model.TransactionId" class="btn btn-danger">Delete</a>
        }
        else
        {
            <div class="alert alert-info">Note: Part selection is not editable. Only Quantity and Remarks may be updated.</div>

            <form asp-action="EditConfirmed" asp-route-transactionid="@Model.TransactionId" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <input type="hidden" asp-for="TransactionId" />

                <div class="mb-3 row">
                    <label class="col-sm-3 col-form-label">Part</label>
                    <div class="col-sm-9">
                        <p class="form-control-plaintext">@Model.Part?.PartName</p>
                    </div>
                </div>

                <div class="mb-3 row">
                    <label class="col-sm-3 col-form-label">Transaction Type</label>
                    <div class="col-sm-9">
                        <p class="form-control-plaintext">@Model.TransactionType</p>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Quantity" class="form-label"></label>
                    <input asp-for="Quantity" class="form-control" />
                    <span asp-validation-for="Quantity" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Remarks" class="form-label"></label>
                    <input asp-for="Remarks" class="form-control" />
                    <span asp-validation-for="Remarks" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        }
    </div>
</div>
