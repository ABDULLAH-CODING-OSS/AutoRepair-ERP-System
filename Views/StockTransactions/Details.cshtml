@model AutoRepairERD.Models.StockTransaction

@{
    ViewData["Title"] = "Transaction Details";
}

<div class="card">
    <div style="padding:4px 0">
        <h4 class="card-title">Transaction Details</h4>
        <dl class="row">
            <dt class="col-sm-3">Date</dt>
            <dd class="col-sm-9">@(Model.TransactionDate?.ToString("dd-MMM-yyyy"))</dd>

            <dt class="col-sm-3">Part</dt>
            <dd class="col-sm-9">@Model.Part?.PartName</dd>

            <dt class="col-sm-3">Transaction Type</dt>
            <dd class="col-sm-9">@Model.TransactionType</dd>

            <dt class="col-sm-3">Quantity</dt>
            <dd class="col-sm-9">@Model.Quantity</dd>

            <dt class="col-sm-3">Remarks</dt>
            <dd class="col-sm-9">@Model.Remarks</dd>
        </dl>

        <a asp-action="Edit" asp-route-transactionid="@Model?.TransactionId" class="btn-gold btn-sm">Edit</a>
        <a asp-action="Index" class="btn-outline btn-sm">Back</a>
        @{
            var isSystem = !string.IsNullOrWhiteSpace(Model?.ReferenceNumber) && (Model.ReferenceNumber.StartsWith("PO-") || Model.ReferenceNumber.StartsWith("JOB-"));
        }
        @if (!isSystem)
        {
            <a asp-action="Delete" asp-route-transactionid="@Model?.TransactionId" class="btn btn-danger ms-2">Delete</a>
        }
        else
        {
            <button type="button" class="btn btn-danger ms-2 disabled" aria-disabled="true" title="System-generated transactions cannot be deleted">Delete</button>
        }
    </div>
</div>
