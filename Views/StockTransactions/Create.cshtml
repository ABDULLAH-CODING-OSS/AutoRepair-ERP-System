@model AutoRepairERD.Models.StockTransaction

@{
    ViewData["Title"] = "Create Transaction";
}

<div class="card">
    <div class="card-body">
        <h4 class="card-title">New Stock Transaction</h4>
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="PartId" class="form-label"></label>
                <select asp-for="PartId" class="form-select" asp-items="ViewBag.Parts">
                    <option value="">-- Select part --</option>
                </select>
                <span asp-validation-for="PartId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TransactionType" class="form-label"></label>
                <select asp-for="TransactionType" class="form-select">
                    <option value="">-- Select transaction type --</option>
                    @foreach (var t in (string[])ViewBag.TransactionTypes)
                    {
                        <option value="@t">@t</option>
                    }
                </select>
                <span asp-validation-for="TransactionType" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Quantity" class="form-label"></label>
                <input asp-for="Quantity" class="form-control" placeholder="Enter quantity" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Remarks" class="form-label"></label>
                <input asp-for="Remarks" class="form-control" placeholder="Optional remarks" />
                <span asp-validation-for="Remarks" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Create</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
