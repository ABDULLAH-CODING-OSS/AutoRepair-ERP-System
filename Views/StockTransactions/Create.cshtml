@model AutoRepairERD.Models.StockTransaction

@{
    ViewData["Title"] = "Create Transaction";
}

<div class="card">
    <div style="padding:4px 0">
        <h4 class="card-title">New Stock Transaction</h4>
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div style="margin-bottom:12px">
                <label asp-for="PartId" class="form-label"></label>
                <select asp-for="PartId" class="form-control" asp-items="ViewBag.Parts">
                    <option value="">-- Select part --</option>
                </select>
                <span asp-validation-for="PartId" style="color:var(--red)"></span>
            </div>

            <div style="margin-bottom:12px">
                <label asp-for="TransactionType" class="form-label"></label>
                <select asp-for="TransactionType" class="form-control">
                    <option value="">-- Select transaction type --</option>
                    @foreach (var t in (string[])ViewBag.TransactionTypes)
                    {
                        <option value="@t">@t</option>
                    }
                </select>
                <span asp-validation-for="TransactionType" style="color:var(--red)"></span>
            </div>

            <div style="margin-bottom:12px">
                <label asp-for="Quantity" class="form-label"></label>
                <input asp-for="Quantity" class="form-control" placeholder="Enter quantity" />
                <span asp-validation-for="Quantity" style="color:var(--red)"></span>
            </div>

            <div style="margin-bottom:12px">
                <label asp-for="Remarks" class="form-label"></label>
                <input asp-for="Remarks" class="form-control" placeholder="Optional remarks" />
                <span asp-validation-for="Remarks" style="color:var(--red)"></span>
            </div>

            <div style="display:flex;gap:8px;flex-wrap:wrap">
                <button type="submit" class="btn-gold btn-sm">Create</button>
                <a asp-action="Index" class="btn-outline btn-sm">Cancel</a>
            </div>
        </form>
    </div>
</div>
