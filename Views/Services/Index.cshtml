@model IEnumerable<AutoRepairERD.Models.Service>
@{ ViewData["Title"] = "Labour Catalog"; ViewData["ActiveNav"] = "labour"; }

@section TopbarActions { <a asp-action="Create" class="btn-gold btn-sm">+ Add Service</a> }

<div class="card">
  <div class="card-header"><span class="card-title">Labour / Service Catalog (@Model.Count())</span>
    <form method="get" style="margin-left:auto;display:flex;gap:8px;align-items:center">
      <input type="search" name="q" value="@(ViewBag.SearchQuery ?? "")" placeholder="Search service or description" class="form-control" style="width:320px;padding:8px 10px">
      <button type="submit" class="btn-outline btn-sm">Search</button>
    </form>
  </div>
  <div class="table-wrap"><table class="erp-table">
    <thead><tr><th>Service Name</th><th>Description</th><th>Std Hours</th><th>Fixed Price</th><th>Status</th><th></th></tr></thead>
    <tbody>
      @if (!Model.Any()) { <tr><td colspan="6" class="td-muted" style="text-align:center;padding:24px">No services in catalog.</td></tr> }
      @foreach (var s in Model)
      {
          <tr>
            <td class="td-gold">@s.ServiceName</td>
            <td class="td-muted">@s.Description</td>
            <td>@(s.StandardHours?.ToString("0.##") ?? "—")h</td>
            <td>@(s.FixedPrice.HasValue ? $"PKR {s.FixedPrice:N0}" : "Variable")</td>
            <td><span class="badge @BadgeHelper.Css(s.IsActive)">@BadgeHelper.Text(s.IsActive)</span></td>
            <td style="white-space:nowrap">
              <a asp-action="Edit" asp-route-id="@s.ServiceId" class="btn-outline btn-sm">Edit</a>
              <a asp-action="Delete" asp-route-id="@s.ServiceId" class="btn-outline btn-sm" style="color:var(--red)">Delete</a>
            </td>
          </tr>
      }
    </tbody>
  </table></div>
</div>
