@model AutoRepairERD.Models.Service

@{
    ViewData["Title"] = "Service Details";
}

<div style="max-width:960px">
  <div class="card">
    <div class="card-header">
      <h2>Service Details</h2>
    </div>
    <div style="padding:4px 0">
      <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.ServiceName)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.ServiceName)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Description)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.Description)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.StandardHours)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.StandardHours)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.FixedPrice)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.FixedPrice)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.IsActive)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.IsActive)</dd>
      </dl>

      <!-- Navigation/collection display removed: JobServiceItems is a navigation property and is not shown here. -->

      <div style="margin-top:12px">
        <a asp-action="Edit" asp-route-id="@Model?.ServiceId" class="btn-gold btn-sm">Edit</a>
        <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
      </div>
    </div>
  </div>
</div>
