@model AutoRepairERD.Models.User

@{
    ViewData["Title"] = "Edit User";
}

<div class="card">
    <div class="card-body">
        <h5 class="card-title">Edit User</h5>
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <input type="hidden" asp-for="UserId" />

            <div class="mb-3">
                <label class="form-label">Username</label>
                <input class="form-control" value="@Model.Username" readonly />
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label">Active</label>
            </div>

            <div class="mb-3">
                <label class="form-label">Employee</label>
                <input class="form-control" value="@(Model.Employees != null && Model.Employees.Any() ? string.Join(", ", Model.Employees.Select(e => (e.FirstName + " " + (e.LastName ?? "")).Trim())) : "-")" readonly />
            </div>

            <div class="mb-3">
                <label class="form-label">Roles</label>
                <input class="form-control" value="@(Model.UserRoles != null && Model.UserRoles.Any() ? string.Join(", ", Model.UserRoles.Select(ur => ur.Role?.RoleName ?? "")) : "-")" readonly />
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
