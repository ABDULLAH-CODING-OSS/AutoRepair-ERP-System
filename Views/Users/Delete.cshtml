@model AutoRepairERD.Models.User

@{
    ViewData["Title"] = "Delete User";
}

<div class="card">
    <div style="padding:4px 0">
        <h5 class="card-title">Confirm Delete</h5>
        <p>Are you sure you want to delete this user?</p>
        <dl class="row">
            <dt class="col-sm-3">Username</dt>
            <dd class="col-sm-9">@Model.Username</dd>

            <dt class="col-sm-3">Employee</dt>
            <dd class="col-sm-9">@(Model.Employees != null && Model.Employees.Any() ? string.Join(", ", Model.Employees.Select(e => (e.FirstName + " " + (e.LastName ?? "")).Trim())) : "-")</dd>

            <dt class="col-sm-3">Roles</dt>
            <dd class="col-sm-9">@(Model.UserRoles != null && Model.UserRoles.Any() ? string.Join(", ", Model.UserRoles.Select(ur => ur.Role?.RoleName ?? "")) : "-")</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@(Model.IsActive == true ? "Active" : "Inactive")</dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="UserId" />
            <button type="submit" class="btn-danger btn-sm">Delete</button>
            <a asp-action="Index" class="btn-outline btn-sm">Back to List</a>
        </form>
    </div>
</div>
