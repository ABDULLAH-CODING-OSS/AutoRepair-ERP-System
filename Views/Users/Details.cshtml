@model AutoRepairERD.Models.User

@{
    ViewData["Title"] = "User Details";
}

<div class="card">
    <div class="card-body">
        <h5 class="card-title">User Details</h5>
        <dl class="row">
            <dt class="col-sm-3">Username</dt>
            <dd class="col-sm-9">@Model.Username</dd>

            <dt class="col-sm-3">Employee</dt>
            <dd class="col-sm-9">@(Model.Employees != null && Model.Employees.Any() ? string.Join(", ", Model.Employees.Select(e => (e.FirstName + " " + (e.LastName ?? "")).Trim())) : "-")</dd>

            <dt class="col-sm-3">Roles</dt>
            <dd class="col-sm-9">@(Model.UserRoles != null && Model.UserRoles.Any() ? string.Join(", ", Model.UserRoles.Select(ur => ur.Role?.RoleName ?? "")) : "-")</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                @if (Model.IsActive == true)
                {
                    <span class="badge bg-success">Active</span>
                }
                else
                {
                    <span class="badge bg-secondary">Inactive</span>
                }
            </dd>

            <dt class="col-sm-3">Created</dt>
            <dd class="col-sm-9">@Model.CreatedAt?.ToString("yyyy-MM-dd")</dd>
        </dl>
        <div class="mt-3">
            <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model?.UserId">Edit</a>
            <a class="btn btn-secondary" asp-action="Index">Back to List</a>
        </div>
    </div>
</div>
