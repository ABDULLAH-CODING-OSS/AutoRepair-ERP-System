@model IEnumerable<AutoRepairERD.Models.User>
@{ ViewData["Title"] = "User Management"; ViewData["ActiveNav"] = "users"; }

@section TopbarActions { <a asp-controller="Employees" asp-action="Create" class="btn-gold btn-sm">+ Add User</a> }

<div class="card">
  <div class="card-header"><span class="card-title">System Users (@Model.Count())</span></div>
  <div class="table-wrap"><table class="erp-table">
    <thead><tr><th>Username</th><th>Full Name</th><th>Email</th><th>Phone</th><th>Registered</th><th>Status</th><th></th></tr></thead>
    <tbody>
      @if (!Model.Any()) { <tr><td colspan="7" class="td-muted" style="text-align:center;padding:24px">No users registered.</td></tr> }
      @foreach (var u in Model)
      {
          <tr onclick="carTransition('/Users/Details/@u.UserId','USER DETAIL')">
            <td class="td-gold">@u.Username</td>
            <td>@u.FullName</td>
            <td class="td-muted">@u.Email</td>
            <td>@u.Phone</td>
            <td class="td-muted">@(u.CreatedAt?.ToString("MMM d, yyyy"))</td>
            <td><span class="badge @BadgeHelper.Css(u.IsActive)">@BadgeHelper.Text(u.IsActive)</span></td>
            <td style="white-space:nowrap">
              <a asp-action="Details" asp-route-id="@u.UserId" class="btn-outline btn-sm">View</a>
              <a asp-action="Edit" asp-route-id="@u.UserId" class="btn-outline btn-sm">Edit</a>
              <a asp-action="Deactivate" asp-route-id="@u.UserId" class="btn-outline btn-sm" style="color:var(--red)">Deactivate</a>
            </td>
          </tr>
      }
    </tbody>
  </table></div>
</div>
