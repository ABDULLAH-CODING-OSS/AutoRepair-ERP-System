@model AutoRepairERD.Models.JobOrder

@{
    ViewData["Title"] = "Edit Job Order";
}

<div class="card">
    <div style="padding:4px 0">
        <h5 class="card-title">Edit Job Order</h5>
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="JobOrderId" />
            <div style="display:flex;gap:16px;flex-wrap:wrap">
                <div style="flex:1;min-width:240px">
                    <label class="form-label">Customer</label>
                    <select asp-for="CustomerId" class="form-control" asp-items="ViewBag.Customers" disabled="disabled"></select>
                    <input type="hidden" asp-for="CustomerId" />
                </div>
                <div style="flex:1;min-width:240px">
                    <label class="form-label">Vehicle</label>
                    <select asp-for="VehicleId" class="form-control" asp-items="ViewBag.Vehicles" disabled="disabled"></select>
                    <input type="hidden" asp-for="VehicleId" />
                </div>
                <div style="flex:1;min-width:240px">
                    <label asp-for="AdvisorId" class="form-label">Service Advisor</label>
                    @if (ViewBag.IsMechanic == true)
                    {
                        <select class="form-control" disabled>
                            <option>@(Model.Advisor != null ? Model.Advisor.FirstName + " " + Model.Advisor.LastName : "-")</option>
                        </select>
                        <input type="hidden" asp-for="AdvisorId" />
                    }
                    else
                    {
                        <select asp-for="AdvisorId" class="form-control" asp-items="ViewBag.Advisors"></select>
                    }
                    <span asp-validation-for="AdvisorId" style="color:var(--red)"></span>
                </div>
                <div style="flex:1;min-width:240px">
                    <label asp-for="MechanicId" class="form-label">Mechanic</label>
                    @if (ViewBag.IsMechanic == true)
                    {
                        <select class="form-control" disabled>
                            <option>@(Model.Mechanic != null ? Model.Mechanic.FirstName + " " + Model.Mechanic.LastName : "-")</option>
                        </select>
                        <input type="hidden" asp-for="MechanicId" />
                    }
                    else
                    {
                        <select asp-for="MechanicId" class="form-control" asp-items="ViewBag.Mechanics"></select>
                    }
                    <span asp-validation-for="MechanicId" style="color:var(--red)"></span>
                </div>
            @* <div class="form-group">
                <label asp-for="CreatedByUserId" class="control-label"></label>
                <input asp-for="CreatedByUserId" class="form-control" />
                <span asp-validation-for="CreatedByUserId" style="color:var(--red)"></span>
            </div> *@
            @* <div class="form-group">
                <label asp-for="JobNumber" class="control-label"></label>
                <input asp-for="JobNumber" class="form-control" />
                <span asp-validation-for="JobNumber" style="color:var(--red)"></span>
            </div> *@
                <div style="flex:1;min-width:200px">
                    <label asp-for="ComplaintDescription" class="form-label">Complaint <span style="color:var(--red)">*</span></label>
                    <input asp-for="ComplaintDescription" class="form-control" />
                    <span asp-validation-for="ComplaintDescription" style="color:var(--red)"></span>
                </div>

                <div style="flex:1;min-width:200px">
                    <label asp-for="DiagnosisNotes" class="form-label">Diagnosis Notes</label>
                    <input asp-for="DiagnosisNotes" class="form-control" />
                    <span asp-validation-for="DiagnosisNotes" style="color:var(--red)"></span>
                </div>

                <div style="flex:1;min-width:240px">
                    <label asp-for="StartDate" class="form-label">Start Date</label>
                    <input asp-for="StartDate" type="date" class="form-control" />
                    <span asp-validation-for="StartDate" style="color:var(--red)"></span>
                </div>

                <div style="flex:1;min-width:240px">
                    <label asp-for="EstimatedCompletionDate" class="form-label">Estimated Completion</label>
                    <input asp-for="EstimatedCompletionDate" type="date" class="form-control" />
                    <span asp-validation-for="EstimatedCompletionDate" style="color:var(--red)"></span>
                </div>

                <div style="flex:1;min-width:240px">
                    <label class="form-label">Completion Date</label>
                    @if (Model?.Status == "Completed")
                    {
                        <input class="form-control" value="@(Model.CompletionDate.HasValue ? Model.CompletionDate.Value.ToString("yyyy-MM-dd") : "")" readonly />
                    }
                    else
                    {
                        <input class="form-control" value="Pending Completion" readonly />
                    }
                </div>

                <div style="flex:1;min-width:240px">
                    <label asp-for="Status" class="form-label">Status</label>
                    <select asp-for="Status" class="form-control">
                        <option value="Pending">Pending</option>
                        <option value="In Progress">In Progress</option>
                        <option value="Completed">Completed</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                    <span asp-validation-for="Status" style="color:var(--red)"></span>
                </div>

                <div style="flex:1;min-width:240px">
                    <label asp-for="EstimatedCost" class="form-label">Estimated Cost</label>
                    <input asp-for="EstimatedCost" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="EstimatedCost" style="color:var(--red)"></span>
                </div>

                <div style="flex:1;min-width:240px">
                    <label class="form-label">Final Cost</label>
                    @if (ViewBag.IsMechanic == true)
                    {
                        @if (Model?.FinalCost != null)
                        {
                            <input class="form-control" value="@(Model.FinalCost.HasValue ? Model.FinalCost.Value.ToString("F2") : "")" readonly />
                        }
                        else
                        {
                            <input class="form-control" value="Not Generated" readonly />
                        }
                    }
                    else
                    {
                        @if (Model?.Invoices != null && Model.Invoices.Any())
                        {
                            <input class="form-control" value="@(Model.FinalCost.HasValue ? Model.FinalCost.Value.ToString("F2") : "")" readonly />
                        }
                        else
                        {
                            <input class="form-control" value="Not Generated" readonly />
                        }
                    }
                </div>

                <div class="col-12 mt-2">
                    <button type="submit" class="btn-gold btn-sm">Save</button>
                    <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
                </div>
            </div>
        </form>
    </div>
</div>

<div style="margin-top:12px">
    <a asp-action="Index" class="btn btn-link">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
