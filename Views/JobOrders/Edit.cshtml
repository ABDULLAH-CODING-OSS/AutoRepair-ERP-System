@model AutoRepairERD.Models.JobOrder

@{
    ViewData["Title"] = "Edit Job Order";
}

<div class="card">
    <div class="card-body">
        <h5 class="card-title">Edit Job Order</h5>
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="JobOrderId" />
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Customer</label>
                    <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.Customers" disabled="disabled"></select>
                    <input type="hidden" asp-for="CustomerId" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Vehicle</label>
                    <select asp-for="VehicleId" class="form-select" asp-items="ViewBag.Vehicles" disabled="disabled"></select>
                    <input type="hidden" asp-for="VehicleId" />
                </div>
                <div class="col-md-6">
                    <label asp-for="AdvisorId" class="form-label">Service Advisor</label>
                    <select asp-for="AdvisorId" class="form-select" asp-items="ViewBag.Advisors"></select>
                    <span asp-validation-for="AdvisorId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="MechanicId" class="form-label">Mechanic</label>
                    <select asp-for="MechanicId" class="form-select" asp-items="ViewBag.Mechanics"></select>
                    <span asp-validation-for="MechanicId" class="text-danger"></span>
                </div>
            @* <div class="form-group">
                <label asp-for="CreatedByUserId" class="control-label"></label>
                <input asp-for="CreatedByUserId" class="form-control" />
                <span asp-validation-for="CreatedByUserId" class="text-danger"></span>
            </div> *@
            @* <div class="form-group">
                <label asp-for="JobNumber" class="control-label"></label>
                <input asp-for="JobNumber" class="form-control" />
                <span asp-validation-for="JobNumber" class="text-danger"></span>
            </div> *@
                <div class="col-12">
                    <label asp-for="ComplaintDescription" class="form-label">Complaint <span class="text-danger">*</span></label>
                    <input asp-for="ComplaintDescription" class="form-control" />
                    <span asp-validation-for="ComplaintDescription" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="DiagnosisNotes" class="form-label">Diagnosis Notes</label>
                    <input asp-for="DiagnosisNotes" class="form-control" />
                    <span asp-validation-for="DiagnosisNotes" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="StartDate" class="form-label">Start Date</label>
                    <input asp-for="StartDate" type="date" class="form-control" />
                    <span asp-validation-for="StartDate" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="EstimatedCompletionDate" class="form-label">Estimated Completion</label>
                    <input asp-for="EstimatedCompletionDate" type="date" class="form-control" />
                    <span asp-validation-for="EstimatedCompletionDate" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Completion Date</label>
                    @if (Model?.Status == "Completed")
                    {
                        <input class="form-control" value="@(Model.CompletionDate.HasValue ? Model.CompletionDate.Value.ToString("yyyy-MM-dd") : "")" readonly />
                    }
                    else
                    {
                        <input class="form-control" value="Pending Completion" readonly />
                    }
                </div>

                <div class="col-md-6">
                    <label asp-for="Status" class="form-label">Status</label>
                    <select asp-for="Status" class="form-select">
                        <option value="Pending">Pending</option>
                        <option value="In Progress">In Progress</option>
                        <option value="Completed">Completed</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="EstimatedCost" class="form-label">Estimated Cost</label>
                    <input asp-for="EstimatedCost" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="EstimatedCost" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Final Cost</label>
                    @if (Model?.Invoices != null && Model.Invoices.Any())
                    {
                        <input class="form-control" value="@(Model.FinalCost.HasValue ? Model.FinalCost.Value.ToString("F2") : "")" readonly />
                    }
                    else
                    {
                        <input class="form-control" value="Not Generated" readonly />
                    }
                </div>

                <div class="col-12 mt-2">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-link">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
