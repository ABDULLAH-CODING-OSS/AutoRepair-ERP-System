@model AutoRepairERD.Models.JobOrder

@{
    ViewData["Title"] = "Create Job Order";
}

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger">@Html.Raw(ViewBag.ErrorMessage)</div>
}

<div class="card">
    <div class="card-body">
        <h5 class="card-title">Create Job Order</h5>
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="CustomerId" class="form-label">Customer <span class="text-danger">*</span></label>
                    <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.Customers">
                        <option value="">-- Select Customer --</option>
                    </select>
                    <span asp-validation-for="CustomerId" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="VehicleId" class="form-label">Vehicle <span class="text-danger">*</span></label>
                    @* <select asp-for="VehicleId" class="form-select" asp-items="ViewBag.Vehicles">
                        <option value="">-- Select Vehicle --</option>
                    </select> *@
                    <select asp-for="VehicleId"
                            class="form-select"
                            asp-items="ViewBag.Vehicles">
                        <option value="">-- Select Customer First --</option>
                    </select>
                    <span asp-validation-for="VehicleId" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="AdvisorId" class="form-label">Service Advisor</label>
                    @if (ViewBag.DefaultAdvisorId != null)
                    {
                        <input type="hidden" asp-for="AdvisorId" value="@ViewBag.DefaultAdvisorId" />
                        var advisors = ViewBag.Advisors as List<SelectListItem>;
                        var advisorText = "";
                        if (advisors != null && ViewBag.DefaultAdvisorId != null)
                        {
                            foreach (var a in advisors)
                            {
                                if (a.Value == ViewBag.DefaultAdvisorId.ToString()) { advisorText = a.Text; break; }
                            }
                        }
                        <input class="form-control" value="@advisorText" readonly />
                    }
                    else
                    {
                        <select asp-for="AdvisorId" class="form-select" asp-items="ViewBag.Advisors">
                            <option value="">-- Select Advisor --</option>
                        </select>
                    }
                    <span asp-validation-for="AdvisorId" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="MechanicId" class="form-label">Mechanic</label>
                    <select asp-for="MechanicId" class="form-select" asp-items="ViewBag.Mechanics">
                        <option value="">-- Select Mechanic --</option>
                    </select>
                    <span asp-validation-for="MechanicId" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Priority</label>
                    <select name="Priority" class="form-select">
                        <option value="">Normal</option>
                        <option value="High">High</option>
                        <option value="Medium">Medium</option>
                        <option value="Low">Low</option>
                    </select>
                </div>
            @* <div class="form-group">
                <label asp-for="CreatedByUserId" class="control-label"></label>
                <input asp-for="CreatedByUserId" class="form-control" />
                <span asp-validation-for="CreatedByUserId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="JobNumber" class="control-label"></label>
                <input asp-for="JobNumber" class="form-control" />
                <span asp-validation-for="JobNumber" class="text-danger"></span>
            </div> *@

                <div class="col-12">
                    <label asp-for="ComplaintDescription" class="form-label">Complaint <span class="text-danger">*</span></label>
                    <input asp-for="ComplaintDescription" class="form-control" placeholder="Describe the customer's complaint" />
                    <span asp-validation-for="ComplaintDescription" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="DiagnosisNotes" class="form-label">Diagnosis Notes</label>
                    <input asp-for="DiagnosisNotes" class="form-control" placeholder="Optional diagnostic notes" />
                    <span asp-validation-for="DiagnosisNotes" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="StartDate" class="form-label">Start Date</label>
                    <input asp-for="StartDate" type="date" class="form-control" />
                    <span asp-validation-for="StartDate" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="EstimatedCompletionDate" class="form-label">Estimated Completion</label>
                    <input asp-for="EstimatedCompletionDate" type="date" class="form-control" />
                    <span asp-validation-for="EstimatedCompletionDate" class="text-danger"></span>
                </div>

                @* CompletionDate removed from Create form - set automatically when job completed *@

                <div class="col-md-6">
                    <label asp-for="EstimatedCost" class="form-label">Estimated Cost</label>
                    <input asp-for="EstimatedCost" type="number" step="0.01" class="form-control" placeholder="0.00" />
                    <span asp-validation-for="EstimatedCost" class="text-danger"></span>
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Create</button>
                <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-link">Back to List</a>
</div>
@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const customerDropdown =
                document.getElementById("CustomerId");

            const vehicleDropdown =
                document.getElementById("VehicleId");

            customerDropdown.addEventListener("change", function () {

                let customerId = this.value;

                vehicleDropdown.innerHTML =
                    '<option value="">Loading...</option>';

                if (!customerId)
                {
                    vehicleDropdown.innerHTML =
                        '<option value="">-- Select Customer First --</option>';

                    return;
                }

                fetch('/JobOrders/GetVehiclesByCustomer?customerId='
                    + customerId)

                    .then(response => response.json())

                    .then(data => {

                        vehicleDropdown.innerHTML =
                            '<option value="">-- Select Vehicle --</option>';

                        data.forEach(vehicle => {

                            let option =
                                document.createElement("option");

                            option.value =
                                vehicle.vehicleId;

                            option.text =
                                vehicle.text;

                            vehicleDropdown.appendChild(option);

                        });

                    })

                    .catch(error => {

                        console.error(error);

                        vehicleDropdown.innerHTML =
                            '<option value="">Error loading vehicles</option>';

                    });

            });

        });
    </script>
}