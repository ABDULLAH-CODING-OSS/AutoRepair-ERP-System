@model IEnumerable<AutoRepairERD.Models.JobOrder>

@{
    ViewData["Title"] = "Job Orders";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">Job Orders</h1>
    <a class="btn btn-success" asp-action="Create">Create Job Order</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-light">
            <tr>
                <th>Job #</th>
                <th>Customer</th>
                <th>Vehicle</th>
                <th>Advisor</th>
                <th>Mechanic</th>
                <th>Start</th>
                <th>Est. Complete</th>
                <th>Status</th>
                <th class="text-end">Est. Cost</th>
                <th class="text-end">Final Cost</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.JobNumber</td>
                <td>@(item.Customer != null ? item.Customer.FirstName + " " + item.Customer.LastName : "-")</td>
                <td>@(item.Vehicle != null ? item.Vehicle.Make + " " + item.Vehicle.Model + " (" + item.Vehicle.LicensePlate + ")" : "-")</td>
                <td>@(item.Advisor != null ? item.Advisor.FirstName + " " + item.Advisor.LastName : "-")</td>
                <td>@(item.Mechanic != null ? item.Mechanic.FirstName + " " + item.Mechanic.LastName : "-")</td>
                <td>@(item.StartDate.HasValue ? item.StartDate.Value.ToString("yyyy-MM-dd") : "-")</td>
                <td>@(item.EstimatedCompletionDate.HasValue ? item.EstimatedCompletionDate.Value.ToString("yyyy-MM-dd") : "-")</td>
                <td>
                    @if (!string.IsNullOrEmpty(item.Status))
                    {
                        var badgeClass = item.Status == "Completed" ? "bg-success" : item.Status == "In Progress" ? "bg-primary" : item.Status == "Cancelled" ? "bg-danger" : "bg-secondary";
                        <span class="badge @badgeClass">@item.Status</span>
                    }
                </td>
                <td class="text-end">@((item.EstimatedCost.HasValue) ? item.EstimatedCost.Value.ToString("C") : "-")</td>
                <td class="text-end">@((item.FinalCost.HasValue) ? item.FinalCost.Value.ToString("C") : "-")</td>
                <td>
                    <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@item.JobOrderId">Edit</a>
                    <a class="btn btn-sm btn-info text-white" asp-action="Details" asp-route-id="@item.JobOrderId">Details</a>
                    <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.JobOrderId">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
