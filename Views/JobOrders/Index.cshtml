@model IEnumerable<AutoRepairERD.Models.JobOrder>
@{ ViewData["Title"] = "Job Orders"; ViewData["ActiveNav"] = "joborders"; }

@section TopbarActions { <a asp-action="Create" class="btn-gold btn-sm">+ New Job Order</a> }

<div class="card">
  <div class="card-header"><span class="card-title">All Job Orders (@Model.Count())</span></div>
  <div class="table-wrap"><table class="erp-table">
    <thead><tr><th>Job #</th><th>Customer</th><th>Vehicle</th><th>Advisor</th><th>Mechanic</th><th>Status</th><th>Final Cost</th><th>Date</th><th></th></tr></thead>
    <tbody>
      @if (!Model.Any()) { <tr><td colspan="9" class="td-muted" style="text-align:center;padding:24px">No job orders yet.</td></tr> }
      @foreach (var j in Model)
      {
          <tr onclick="carTransition('/JobOrders/Details/@j.JobOrderId','JOB DETAIL')">
            <td class="td-gold">@j.JobNumber</td>
            <td>@j.Customer?.FirstName @j.Customer?.LastName</td>
            <td>@j.Vehicle?.Make @j.Vehicle?.Model</td>
            <td class="td-muted">@j.Advisor?.FirstName</td>
            <td class="td-muted">@j.Mechanic?.FirstName</td>
            <td><span class="badge @BadgeHelper.Css(j.Status)">@j.Status</span></td>
            <td>PKR @((j.FinalCost ?? j.EstimatedCost ?? 0).ToString("N0"))</td>
            <td class="td-muted">@(j.CreatedAt?.ToString("MMM d"))</td>
            <td style="white-space:nowrap">
              <a asp-action="Details" asp-route-id="@j.JobOrderId" class="btn-outline btn-sm">View</a>
              <a asp-action="Edit" asp-route-id="@j.JobOrderId" class="btn-outline btn-sm">Edit</a>
            </td>
          </tr>
      }
    </tbody>
  </table></div>
</div>
