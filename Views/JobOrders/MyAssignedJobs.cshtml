@model IEnumerable<AutoRepairERD.Models.ViewModels.AssignedJobViewModel>

@{
    ViewData["Title"] = "My Assigned Jobs";
    var q = ViewBag.SearchQuery as string ?? "";
    var filter = ViewBag.FilterStatus as string ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">My Assigned Jobs</h1>
    <form method="get" class="d-flex">
        <input name="q" value="@q" class="form-control form-control-sm me-2" placeholder="Search job #, customer, plate" />
        <select name="status" class="form-select form-select-sm me-2">
            <option value="" selected="@(string.IsNullOrEmpty(filter) ? "selected" : null)">All Statuses</option>
            <option value="Pending" selected="@(filter=="Pending" ? "selected" : null)">Pending</option>
            <option value="In Progress" selected="@(filter=="In Progress" ? "selected" : null)">In Progress</option>
            <option value="Completed" selected="@(filter=="Completed" ? "selected" : null)">Completed</option>
        </select>
        <button class="btn btn-sm btn-primary">Filter</button>
    </form>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Job #</th>
                        <th>Customer</th>
                        <th>Vehicle</th>
                        <th>Service Advisor</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th>Priority</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Job.JobNumber</td>
                        <td>@(item.Job.Customer != null ? item.Job.Customer.FirstName + " " + item.Job.Customer.LastName : "-")</td>
                        <td>@(item.Job.Vehicle != null ? item.Job.Vehicle.Make + " " + item.Job.Vehicle.Model + " (" + item.Job.Vehicle.LicensePlate + ")" : "-")</td>
                        <td>@(item.Job.Advisor != null ? item.Job.Advisor.FirstName + " " + item.Job.Advisor.LastName : "-")</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.Job.Status))
                            {
                                var badgeClass = item.Job.Status == "Completed" ? "bg-success" : item.Job.Status == "In Progress" ? "bg-primary" : item.Job.Status == "Cancelled" ? "bg-danger" : "bg-secondary";
                                <span class="badge @badgeClass">@item.Job.Status</span>
                            }
                        </td>
                        <td>@(item.Job.CreatedAt.HasValue ? item.Job.CreatedAt.Value.ToString("yyyy-MM-dd") : "-")</td>
                        <td>@(item.Priority ?? "-")</td>
                        <td>@(item.Job.FinalCost.HasValue ? item.Job.FinalCost.Value.ToString("C") : "-")</td>
                        <td>
                            <a class="btn btn-sm btn-info text-white" asp-action="Details" asp-route-id="@item.Job.JobOrderId">Details</a>
                            <a class="btn btn-sm btn-primary ms-1" asp-action="Edit" asp-route-id="@item.Job.JobOrderId">Update Status</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

