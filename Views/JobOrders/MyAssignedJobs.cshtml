@model IEnumerable<AutoRepairERD.Models.ViewModels.AssignedJobViewModel>
@{ ViewData["Title"] = "My Assigned Jobs"; ViewData["ActiveNav"] = "myjobs"; }

<div class="card">
  <div class="card-header"><span class="card-title">My Assigned Jobs (@Model.Count())</span></div>
  <div class="table-wrap"><table class="erp-table">
    <thead><tr><th>Job #</th><th>Customer</th><th>Vehicle</th><th>Status</th><th>Complaint</th><th>Est. Completion</th><th></th></tr></thead>
    <tbody>
      @if (!Model.Any()) { <tr><td colspan="7" class="td-muted" style="text-align:center;padding:24px">No jobs assigned to you right now. 🛠</td></tr> }
      @foreach (var vm in Model)
      {
          var j = vm.Job;
          <tr onclick="carTransition('/JobOrders/Details/@j.JobOrderId','JOB DETAIL')">
            <td class="td-gold">@j.JobNumber</td>
            <td>@j.Customer?.FirstName @j.Customer?.LastName</td>
            <td>@j.Vehicle?.Make @j.Vehicle?.Model</td>
            <td><span class="badge @BadgeHelper.Css(j.Status)">@j.Status</span></td>
            <td style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" class="td-muted">@j.ComplaintDescription</td>
            <td class="td-muted">@(j.EstimatedCompletionDate?.ToString("MMM d, yyyy"))</td>
            <td><a asp-action="Details" asp-route-id="@j.JobOrderId" class="btn-outline btn-sm">Open</a></td>
          </tr>
      }
    </tbody>
  </table></div>
</div>
