@model AutoRepairERD.Models.JobOrder

@{
    ViewData["Title"] = "Job Order Details";
    var job = Model;
    var jobNumber = job?.JobNumber ?? "-";
    var customer = job?.Customer != null ? job.Customer.FirstName + " " + job.Customer.LastName : "-";
    var vehicle = job?.Vehicle != null ? job.Vehicle.Make + " " + job.Vehicle.Model + " (" + job.Vehicle.LicensePlate + ")" : "-";
    var createdAt = (job != null && job.CreatedAt.HasValue) ? job.CreatedAt.Value.ToString("yyyy-MM-dd HH:mm") : "-";
    var advisor = job?.Advisor != null ? job.Advisor.FirstName + " " + job.Advisor.LastName : "-";
    var mechanic = job?.Mechanic != null ? job.Mechanic.FirstName + " " + job.Mechanic.LastName : "-";
    var status = job?.Status ?? "-";
    var statusClass = status == "Completed" ? "bg-success" : status == "In Progress" ? "bg-primary" : status == "Cancelled" ? "bg-danger" : "bg-secondary";
    var startDate = (job != null && job.StartDate.HasValue) ? job.StartDate.Value.ToString("yyyy-MM-dd") : "-";
    var estComplete = (job != null && job.EstimatedCompletionDate.HasValue) ? job.EstimatedCompletionDate.Value.ToString("yyyy-MM-dd") : "-";
    var completionDate = (job != null && job.CompletionDate.HasValue) ? job.CompletionDate.Value.ToString("yyyy-MM-dd") : "-";
    var estCost = (job != null && job.EstimatedCost.HasValue) ? job.EstimatedCost.Value.ToString("C") : "-";
    var finalCost = (job != null && job.FinalCost.HasValue) ? job.FinalCost.Value.ToString("C") : "-";
}

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Job Order: @jobNumber</h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <h6>Customer & Vehicle</h6>
                <p class="mb-1"><strong>Customer:</strong> @customer</p>
                <p class="mb-1"><strong>Vehicle:</strong> @vehicle</p>
                <p class="mb-1"><strong>Created At:</strong> @createdAt</p>
            </div>
            <div class="col-md-6">
                <h6>Assignment & Status</h6>
                <p class="mb-1"><strong>Advisor:</strong> @advisor</p>
                <p class="mb-1"><strong>Mechanic:</strong> @mechanic</p>
                <p class="mb-1"><strong>Status:</strong> <span class="badge @statusClass">@status</span></p>
            </div>
        </div>

        <hr />

        <h6>Schedule & Costs</h6>
        <p class="mb-1"><strong>Start Date:</strong> @startDate</p>
        <p class="mb-1"><strong>Estimated Completion:</strong> @estComplete</p>
        <p class="mb-1"><strong>Completion Date:</strong> @completionDate</p>
        <p class="mb-1"><strong>Estimated Cost:</strong> @estCost</p>
        <p class="mb-1"><strong>Final Cost:</strong> @finalCost</p>

        <hr />

        <h6>Notes</h6>
        <p><strong>Complaint:</strong> @job?.ComplaintDescription</p>
        <p><strong>Diagnosis:</strong> @job?.DiagnosisNotes</p>
    </div>
    <div class="card-footer">
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@job?.JobOrderId">Edit</a>
        <a class="btn btn-secondary ms-2" asp-action="Index">Back to List</a>
    </div>
</div>
