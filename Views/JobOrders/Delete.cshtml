            <dt class="col-sm-3">Vehicle</dt>
            <dd class="col-sm-9">@(Model?.Vehicle != null ? Model.Vehicle.Make + " " + Model.Vehicle.Model + " (" + Model.Vehicle.LicensePlate + ")" : "-")</dd>
