@model IEnumerable<AutoRepairERD.Models.Payroll>

@{
    ViewData["Title"] = "Index";
}

<h1>Payrolls</h1>

<p>
    <a asp-action="Generate" class="btn btn-primary">Generate Payroll</a>
</p>

<table class="table table-striped table-responsive">
    <thead>
        <tr>
            <th>Payroll Number</th>
            <th>Employee Code</th>
            <th>Employee Name</th>
            <th>Period</th>
            <th class="text-end">Gross</th>
            <th class="text-end">Net</th>
            <th>Status</th>
            <th>Payment Date</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.PayrollNumber</td>
            <td>@(item.Employee?.EmployeeCode ?? "")</td>
            <td>@(item.Employee != null ? (item.Employee.FirstName + " " + (item.Employee.LastName ?? "")).Trim() : "Unknown")</td>
            <td>@(System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(item.PayrollMonth ?? 0) + " " + (item.PayrollYear?.ToString() ?? ""))</td>
            <td class="text-end">@String.Format("{0:C}", item.GrossSalary)</td>
            <td class="text-end">@String.Format("{0:C}", item.NetSalary)</td>
            <td>@item.PayrollStatus</td>
            <td>@(item.PaymentDate.HasValue ? item.PaymentDate.Value.ToString("d") : "")</td>
            <td>
                <a asp-action="Edit" asp-route-payrollid="@item.PayrollId">Edit</a> |
                <a asp-action="Details" asp-route-payrollid="@item.PayrollId">Details</a> |
                <a asp-action="Delete" asp-route-payrollid="@item.PayrollId">Cancel</a>
            </td>
        </tr>
}
    </tbody>
</table>
