@model IEnumerable<AutoRepairERD.Models.Payroll>
@{ ViewData["Title"] = "Payrolls"; ViewData["ActiveNav"] = "payrolls"; }

@section TopbarActions {
  <a asp-action="Generate" class="btn-gold btn-sm">⚙ Generate Payroll</a>
}

<div class="card">
  <div class="card-header"><span class="card-title">Payroll Records (@Model.Count())</span></div>
  <div class="table-wrap"><table class="erp-table">
    <thead><tr><th>Payroll #</th><th>Employee</th><th>Period</th><th>Present Days</th><th>Net Salary</th><th>Status</th><th></th></tr></thead>
    <tbody>
      @if (!Model.Any()) { <tr><td colspan="7" class="td-muted" style="text-align:center;padding:24px">No payroll records yet. Use ⚙ Generate Payroll to create one.</td></tr> }
      @foreach (var p in Model)
      {
          @* <tr onclick="carTransition('/Payrolls/Details/@p.PayrollId','PAYROLL DETAIL')"> *@
              <tr onclick="carTransition('/Payrolls/Details?payrollid=@p.PayrollId','PAYROLL DETAIL')">
            <td class="td-gold">@p.PayrollNumber</td>
            <td>@p.Employee?.FirstName @p.Employee?.LastName</td>
            <td>@(new System.Globalization.CultureInfo("en-US").DateTimeFormat.GetAbbreviatedMonthName(p.PayrollMonth ?? 1)) @p.PayrollYear</td>
            <td>@p.TotalPresentDays / @p.TotalWorkingDays days</td>
            <td><strong>PKR @(p.NetSalary?.ToString("N0") ?? "—")</strong></td>
            <td><span class="badge @BadgeHelper.Css(p.PayrollStatus)">@(p.PayrollStatus ?? "Generated")</span></td>
            <td style="white-space:nowrap">
              <a asp-action="Details" asp-route-payrollid="@p.PayrollId" class="btn-outline btn-sm">View</a>
              @* <a asp-action="MarkPaid" asp-route-payrollid="@p.PayrollId" class="btn-gold btn-sm" style="@(p.PayrollStatus == "Paid" ? "display:none" : "")">Mark Paid</a> *@
              @if (p.PayrollStatus != "Paid")
{
    <form asp-action="MarkPaid"
          asp-route-payrollid="@p.PayrollId"
          method="post"
          style="display:inline;"
          onclick="event.stopPropagation();">

        @Html.AntiForgeryToken()

        <button type="submit"
                class="btn-gold btn-sm"
                onclick="event.stopPropagation();">
            Mark Paid
        </button>

    </form>
}
            </td>
          </tr>
      }
    </tbody>
  </table></div>
</div>
