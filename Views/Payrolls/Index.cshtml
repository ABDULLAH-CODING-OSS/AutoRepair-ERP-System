@model IEnumerable<AutoRepairERD.Models.Payroll>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.EmployeeId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PayrollMonth)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PayrollYear)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TotalWorkingDays)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TotalPresentDays)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OvertimeHours)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BonusAmount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DeductionAmount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GrossSalary)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NetSalary)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PaymentDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PayrollStatus)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Employee)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SalaryAdjustments)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.EmployeeId)
            </td>
            <td>
                @Html.DisplayFor(model => item.PayrollMonth)
            </td>
            <td>
                @Html.DisplayFor(model => item.PayrollYear)
            </td>
            <td>
                @Html.DisplayFor(model => item.TotalWorkingDays)
            </td>
            <td>
                @Html.DisplayFor(model => item.TotalPresentDays)
            </td>
            <td>
                @Html.DisplayFor(model => item.OvertimeHours)
            </td>
            <td>
                @Html.DisplayFor(model => item.BonusAmount)
            </td>
            <td>
                @Html.DisplayFor(model => item.DeductionAmount)
            </td>
            <td>
                @Html.DisplayFor(model => item.GrossSalary)
            </td>
            <td>
                @Html.DisplayFor(model => item.NetSalary)
            </td>
            <td>
                @Html.DisplayFor(model => item.PaymentDate)
            </td>
            <td>
                @Html.DisplayFor(model => item.PayrollStatus)
            </td>
            <td>
                @Html.DisplayFor(model => item.Employee)
            </td>
            <td>
                @Html.DisplayFor(model => item.SalaryAdjustments)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.PayrollId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.PayrollId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.PayrollId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
