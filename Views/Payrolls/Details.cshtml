@model AutoRepairERD.Models.Payroll

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Payroll</h4>
    <hr />
    <div class="row">
        <div class="col-md-4">
            <div class="card mb-3">
                <div class="card-header">Employee Information</div>
                <div class="card-body">
                    <p><strong>Code:</strong> @(Model.Employee?.EmployeeCode ?? "")</p>
                    <p><strong>Name:</strong> @((Model.Employee != null) ? (Model.Employee.FirstName + " " + (Model.Employee.LastName ?? "")).Trim() : "Unknown")</p>
                    <p><strong>Designation:</strong> @(Model.Employee?.Designation ?? "")</p>
                    <p><strong>Basic Salary:</strong> @String.Format("{0:C}", Model.Employee?.BasicSalary ?? 0m)</p>
                    <p><strong>Hourly Rate:</strong> @String.Format("{0:C}", Model.Employee?.HourlyRate ?? 0m)</p>
                </div>
            </div>
            <div class="card">
                <div class="card-header">Payroll Information</div>
                <div class="card-body">
                    <p><strong>Payroll Number:</strong> @Model.PayrollNumber</p>
                    <p><strong>Period:</strong> @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(Model.PayrollMonth ?? 0) @Model.PayrollYear</p>
                    <p><strong>Status:</strong> <span class="badge bg-secondary">@Model.PayrollStatus</span></p>
                    <p><strong>Payment Date:</strong> @(Model.PaymentDate.HasValue ? Model.PaymentDate.Value.ToString("d") : "-")</p>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card mb-3">
                <div class="card-header">Attendance Summary</div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-sm-6"><strong>Total Working Days</strong><div>@Model.TotalWorkingDays</div></div>
                        <div class="col-sm-6"><strong>Present Days</strong><div>@Model.TotalPresentDays</div></div>
                    </div>
                    <div class="row mt-2">
                        <div class="col-sm-6"><strong>Absent Days</strong><div>@( (Model.TotalWorkingDays ?? 0) - (Model.TotalPresentDays ?? 0) )</div></div>
                        <div class="col-sm-6"><strong>Overtime Hours</strong><div>@Model.OvertimeHours</div></div>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">Salary Breakdown</div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-sm-6">Basic Salary</div>
                        <div class="col-sm-6 text-end">@String.Format("{0:C}", Model.Employee?.BasicSalary ?? 0m)</div>
                    </div>
                    <div class="row">
                        <div class="col-sm-6">Job Bonus</div>
                        <div class="col-sm-6 text-end">@String.Format("{0:C}", Model.BonusAmount)</div>
                    </div>
                    <div class="row">
                        <div class="col-sm-6">Overtime Pay</div>
                        <div class="col-sm-6 text-end">@String.Format("{0:C}", (Model.OvertimeHours ?? 0) * (Model.Employee?.HourlyRate ?? 0m))</div>
                    </div>
                    <div class="row">
                        <div class="col-sm-6">Salary Adjustments</div>
                        <div class="col-sm-6 text-end">@String.Format("{0:C}", Model.SalaryAdjustments?.Sum(sa => sa.Amount ?? 0m) ?? 0m)</div>
                    </div>
                    <div class="row">
                        <div class="col-sm-6">Attendance Deductions</div>
                        <div class="col-sm-6 text-end">@String.Format("{0:C}", Model.DeductionAmount)</div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h4 class="text-end">Gross: <span class="badge bg-info">@String.Format("{0:C}", Model.GrossSalary)</span></h4>
                    <h3 class="text-end">Net: <span class="badge bg-success">@String.Format("{0:C}", Model.NetSalary)</span></h3>
                </div>
            </div>
        </div>
    </div>
</div>
<div>
    @if (Model.PayrollStatus != "Paid")
    {
        <text>
            <a asp-action="Edit" asp-route-payrollid="@Model?.PayrollId">Edit</a> |
            <form asp-action="Delete" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="payrollid" value="@Model.PayrollId" />
                <button type="submit" class="btn btn-link p-0">Cancel</button>
            </form>
        </text>
    }
    <a asp-action="Index">Back to List</a>
</div>
