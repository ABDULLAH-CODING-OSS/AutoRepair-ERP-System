@model AutoRepairERD.Models.Payroll

@{
    ViewData["Title"] = "Delete";
}

<h1>Cancel Payroll</h1>

<h3>Are you sure you want to cancel this payroll? This will remove the payroll record so it can be regenerated.</h3>
<div>
    <div class="card">
        <div style="padding:4px 0">
            <h5 class="card-title">Payroll</h5>
            <dl class="row mb-0">
                <dt class="col-sm-3">Employee</dt>
                <dd class="col-sm-9">@((Model.Employee != null) ? (Model.Employee.EmployeeCode + " - " + Model.Employee.FirstName + " " + (Model.Employee.LastName ?? "")).Trim() : "Unknown")</dd>

                <dt class="col-sm-3">Payroll Number</dt>
                <dd class="col-sm-9">@Model.PayrollNumber</dd>

                <dt class="col-sm-3">Payroll Period</dt>
                <dd class="col-sm-9">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(Model.PayrollMonth ?? 0) @Model.PayrollYear</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@Model.PayrollStatus</dd>

                <dt class="col-sm-3">Net Salary</dt>
                <dd class="col-sm-9">@String.Format("{0:C}", Model.NetSalary)</dd>
            </dl>
        </div>
    </div>

    <form asp-action="Delete" method="post" style="margin-top:12px">
        @Html.AntiForgeryToken()
        <input type="hidden" name="payrollid" value="@Model.PayrollId" />
        <input type="submit" value="Cancel Payroll" class="btn-danger btn-sm" /> |
        <a asp-action="Index" class="btn btn-link">Back to List</a>
    </form>
</div>
