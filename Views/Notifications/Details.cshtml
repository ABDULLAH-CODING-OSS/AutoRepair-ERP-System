@model AutoRepairERD.Models.Notification

@{
    ViewData["Title"] = "Notification Details";
}

<div class="card">
    <div class="card-body">
        <h5 class="card-title">@Model.Title</h5>
        <p class="text-muted">Type: <span class="badge bg-secondary">@Model.NotificationType</span></p>
        <p>@Model.Message</p>
        <dl class="row">
            <dt class="col-sm-3">Recipient</dt>
            <dd class="col-sm-9">@(Model.User != null ? Model.User.FullName ?? Model.User.Username : "System")</dd>

            <dt class="col-sm-3">Created On</dt>
            <dd class="col-sm-9">@Model.CreatedAt?.ToString("yyyy-MM-dd HH:mm")</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                @if (Model.IsRead == true)
                {
                    <span class="badge bg-secondary">Read</span>
                }
                else
                {
                    <span class="badge bg-primary">Unread</span>
                }
            </dd>
        </dl>

        <div class="mt-3">
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </div>
</div>
