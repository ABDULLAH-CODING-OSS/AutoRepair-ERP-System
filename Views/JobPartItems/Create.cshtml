@model AutoRepairERD.Models.JobPartItem

@{
    ViewData["Title"] = "Add Part to Job";
}

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Add Part</h5>
    </div>
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label class="form-label">Job Order <span class="text-danger">*</span></label>
                <select asp-for="JobOrderId" class="form-select" asp-items="ViewBag.JobOrders">
                    <option value="">-- Select Job Order --</option>
                </select>
                <span asp-validation-for="JobOrderId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Part <span class="text-danger">*</span></label>
                <select asp-for="PartId" class="form-select" asp-items="ViewBag.Parts">
                    <option value="">-- Select Part --</option>
                </select>
                <span asp-validation-for="PartId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Quantity" class="form-label">Quantity <span class="text-danger">*</span></label>
                <input asp-for="Quantity" class="form-control" placeholder="Enter quantity" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>

            <div>
                <button type="submit" class="btn btn-primary">Add Part</button>
                <a class="btn btn-secondary ms-2" asp-action="Index">Back to List</a>
            </div>
        </form>
    </div>
</div>
