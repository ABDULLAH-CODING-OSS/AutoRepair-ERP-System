@model AutoRepairERD.Models.JobPartItem

@{
    ViewData["Title"] = "Add Part to Job";
}

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Add Part</h5>
    </div>
    <div style="padding:4px 0">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div style="margin-bottom:12px">
                <label class="form-label">Job Order <span style="color:var(--red)">*</span></label>
                <select asp-for="JobOrderId" class="form-control" asp-items="ViewBag.JobOrders">
                    <option value="">-- Select Job Order --</option>
                </select>
                <span asp-validation-for="JobOrderId" style="color:var(--red)"></span>
            </div>

            <div style="margin-bottom:12px">
                <label class="form-label">Part <span style="color:var(--red)">*</span></label>
                <select asp-for="PartId" class="form-control" asp-items="ViewBag.Parts">
                    <option value="">-- Select Part --</option>
                </select>
                <span asp-validation-for="PartId" style="color:var(--red)"></span>
            </div>

            <div style="margin-bottom:12px">
                <label asp-for="Quantity" class="form-label">Quantity <span style="color:var(--red)">*</span></label>
                <input asp-for="Quantity" class="form-control" placeholder="Enter quantity" />
                <span asp-validation-for="Quantity" style="color:var(--red)"></span>
            </div>

            <div>
                <button type="submit" class="btn-gold btn-sm">Add Part</button>
                <a class="btn btn-secondary ms-2" asp-action="Index">Back to List</a>
            </div>
        </form>
    </div>
</div>
