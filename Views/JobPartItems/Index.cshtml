@model IEnumerable<AutoRepairERD.Models.JobPartItem>

@{
    ViewData["Title"] = "Job Parts";
}

<div class="card-header">
    <h1 class="h3">Job Parts</h1>
    <a class="btn-gold btn-sm" asp-action="Create">Add Part</a>
</div>

<div class="table-wrap">
    <table class="erp-table">
        <thead >
            <tr>
                <th>Job #</th>
                <th>Part</th>
                <th>Quantity</th>
                <th style="text-align:right">Unit Price</th>
                <th style="text-align:right">Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@(item.JobOrder?.JobNumber ?? item.JobOrderId.ToString())</td>
                <td>
                    @if (item.Part != null)
                    {
                        <span class="badge badge-active">@item.Part.PartName</span>
                    }
                    else
                    {
                        @item.PartId
                    }
                </td>
                <td>@item.Quantity</td>
                <td style="text-align:right">@((item.UnitPrice.HasValue) ? item.UnitPrice.Value.ToString("C") : "-")</td>
                <td style="text-align:right">@((item.TotalPrice.HasValue) ? item.TotalPrice.Value.ToString("C") : "-")</td>
                <td>
                    <a class="btn-gold btn-sm" asp-action="Edit" asp-route-id="@item.JobPartItemId">Edit</a>
                    <a class="btn btn-sm btn-info text-white" asp-action="Details" asp-route-id="@item.JobPartItemId">Details</a>
                    <a class="btn-danger btn-sm" asp-action="Delete" asp-route-id="@item.JobPartItemId">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
