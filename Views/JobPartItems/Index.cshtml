@model IEnumerable<AutoRepairERD.Models.JobPartItem>

@{
    ViewData["Title"] = "Job Parts";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">Job Parts</h1>
    <a class="btn btn-success" asp-action="Create">Add Part</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-light">
            <tr>
                <th>Job #</th>
                <th>Part</th>
                <th>Quantity</th>
                <th class="text-end">Unit Price</th>
                <th class="text-end">Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@(item.JobOrder?.JobNumber ?? item.JobOrderId.ToString())</td>
                <td>
                    @if (item.Part != null)
                    {
                        <span class="badge bg-success">@item.Part.PartName</span>
                    }
                    else
                    {
                        @item.PartId
                    }
                </td>
                <td>@item.Quantity</td>
                <td class="text-end">@((item.UnitPrice.HasValue) ? item.UnitPrice.Value.ToString("C") : "-")</td>
                <td class="text-end">@((item.TotalPrice.HasValue) ? item.TotalPrice.Value.ToString("C") : "-")</td>
                <td>
                    <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@item.JobPartItemId">Edit</a>
                    <a class="btn btn-sm btn-info text-white" asp-action="Details" asp-route-id="@item.JobPartItemId">Details</a>
                    <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.JobPartItemId">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
