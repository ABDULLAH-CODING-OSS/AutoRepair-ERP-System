@model IEnumerable<AutoRepairERD.Models.JobPartItem>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.JobOrderId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PartId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Quantity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UnitPrice)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TotalPrice)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.JobOrder)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Part)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.JobOrderId)
            </td>
            <td>
                @Html.DisplayFor(model => item.PartId)
            </td>
            <td>
                @Html.DisplayFor(model => item.Quantity)
            </td>
            <td>
                @Html.DisplayFor(model => item.UnitPrice)
            </td>
            <td>
                @Html.DisplayFor(model => item.TotalPrice)
            </td>
            <td>
                @Html.DisplayFor(model => item.JobOrder)
            </td>
            <td>
                @Html.DisplayFor(model => item.Part)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.JobPartItemId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.JobPartItemId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.JobPartItemId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
