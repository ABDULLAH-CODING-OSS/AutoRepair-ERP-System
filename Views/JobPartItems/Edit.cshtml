@model AutoRepairERD.Models.JobPartItem

@{
    ViewData["Title"] = "Edit Part Item";
}

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Edit Part</h5>
    </div>
    <div style="padding:4px 0">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="JobPartItemId" />

            <div style="margin-bottom:12px">
                <label class="form-label">Job Order</label>
                <div class="form-control-plaintext">@((Model?.JobOrder != null) ? Model.JobOrder.JobNumber : Model?.JobOrderId.ToString())</div>
                <input type="hidden" asp-for="JobOrderId" />
            </div>

            <div style="margin-bottom:12px">
                <label class="form-label">Part <span style="color:var(--red)">*</span></label>
                <select asp-for="PartId" class="form-control" asp-items="ViewBag.Parts"></select>
                <span asp-validation-for="PartId" style="color:var(--red)"></span>
            </div>

            <div style="margin-bottom:12px">
                <label asp-for="Quantity" class="form-label">Quantity <span style="color:var(--red)">*</span></label>
                <input asp-for="Quantity" class="form-control" />
                <span asp-validation-for="Quantity" style="color:var(--red)"></span>
            </div>

            <div style="margin-bottom:12px">
                <label class="form-label">Unit Price</label>
                <div class="form-control-plaintext">@((Model != null && Model.UnitPrice.HasValue) ? Model.UnitPrice.Value.ToString("C") : "-")</div>
            </div>

            <div style="margin-bottom:12px">
                <label class="form-label">Total Price</label>
                <div class="form-control-plaintext">@((Model != null && Model.TotalPrice.HasValue) ? Model.TotalPrice.Value.ToString("C") : "-")</div>
            </div>

            <div>
                <button type="submit" class="btn-gold btn-sm">Save</button>
                <a class="btn btn-secondary ms-2" asp-action="Index">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
