@model AutoRepairERD.ViewModels.EmployeeRegistrationViewModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Employee</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Username"></label>
                <input asp-for="Username" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="Password"></label>
                @* <input asp-for="Password" class="form-control" /> *@
                <input asp-for="Password"
                       type="password"
                       class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" />
            </div>

            <div class="form-group">
                <label>Role</label>
                @* <select asp-for="RoleId"
                        asp-items="ViewBag.Roles"
                        class="form-control">
                </select> *@
                <select asp-for="RoleId"
                        asp-items="ViewBag.Roles"
                        class="form-control">
                    <option value="">-- Select Role --</option>
                </select>
            </div>

            <hr />

            <div class="form-group">
                <label asp-for="EmployeeCode"></label>
                <input asp-for="EmployeeCode" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="FirstName"></label>
                <input asp-for="FirstName" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="LastName"></label>
                <input asp-for="LastName" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="Cnic"></label>
                <input asp-for="Cnic" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="Phone"></label>
                <input asp-for="Phone" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="Address"></label>
                <input asp-for="Address" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="Designation"></label>
                <input asp-for="Designation" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="BasicSalary"></label>
                <input asp-for="BasicSalary" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="HourlyRate"></label>
                <input asp-for="HourlyRate" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="HireDate"></label>
                @* <input asp-for="HireDate" class="form-control" /> *@
                <input asp-for="HireDate"
                       type="date"
                       class="form-control" />
            </div>

            <br />

            <div class="form-group">
                <input type="submit"
                       value="Create Employee"
                       class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
