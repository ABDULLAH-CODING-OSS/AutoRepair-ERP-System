@model AutoRepairERD.Models.Employee

@{
    ViewData["Title"] = "Employee Profile";
}

<div class="card mb-3">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <h4 class="card-title">@Model.FirstName @Model.LastName</h4>
                <div class="text-muted">Employee Code: @Model.EmployeeCode</div>
            </div>
            <div>
                @if (Model.IsActive == true)
                {
                    <span class="badge bg-success">Active</span>
                }
                else
                {
                    <span class="badge bg-secondary">Inactive</span>
                }
            </div>
        </div>

        <hr />

        <div class="row">
            <div class="col-md-6">
                <dl class="row">
                    <dt class="col-sm-4">CNIC</dt>
                    <dd class="col-sm-8">@Model.Cnic</dd>

                    <dt class="col-sm-4">Phone</dt>
                    <dd class="col-sm-8">@Model.Phone</dd>

                    <dt class="col-sm-4">Address</dt>
                    <dd class="col-sm-8">@Model.Address</dd>

                    <dt class="col-sm-4">Hire Date</dt>
                    <dd class="col-sm-8">@(Model.HireDate?.ToString("dd-MMM-yyyy") ?? "-")</dd>

                    <dt class="col-sm-4">Designation</dt>
                    <dd class="col-sm-8">@Model.Designation</dd>
                </dl>
            </div>
            <div class="col-md-6">
                <dl class="row">
                    <dt class="col-sm-5">Basic Salary</dt>
                    <dd class="col-sm-7">@String.Format("{0:C}", Model.BasicSalary ?? 0m)</dd>

                    <dt class="col-sm-5">Hourly Rate</dt>
                    <dd class="col-sm-7">@String.Format("{0:C}", Model.HourlyRate ?? 0m)</dd>

                    <dt class="col-sm-5">User Account</dt>
                    <dd class="col-sm-7">@Model.User?.Username</dd>
                </dl>
            </div>
        </div>

        <div class="mt-3 d-flex">
            <a asp-action="Edit" asp-route-id="@Model.EmployeeId" class="btn btn-primary">Edit</a>
            @if (Model.IsActive != true)
            {
                <form asp-action="Activate" method="post" class="ms-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.EmployeeId" />
                    <button type="submit" class="btn btn-success">Activate</button>
                </form>
            }
            <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="card text-center mb-3">
            <div class="card-body">
                <h6>Total Attendance</h6>
                <h3>@(ViewBag.TotalAttendances ?? 0)</h3>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card text-center mb-3">
            <div class="card-body">
                <h6>Present</h6>
                <h4>@(ViewBag.PresentDays ?? 0)</h4>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card text-center mb-3">
            <div class="card-body">
                <h6>Absent</h6>
                <h4>@(ViewBag.AbsentDays ?? 0)</h4>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card text-center mb-3">
            <div class="card-body">
                <h6>Sick</h6>
                <h4>@(ViewBag.SickDays ?? 0)</h4>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <h5 class="card-title">Recent Attendance</h5>
        <div class="table-responsive">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Attendances?.OrderByDescending(x => x.AttendanceDate).Take(10) ?? new List<AutoRepairERD.Models.Attendance>())
                    {
                        <tr>
                            <td>@(a.AttendanceDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                            <td>@a.Status</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
