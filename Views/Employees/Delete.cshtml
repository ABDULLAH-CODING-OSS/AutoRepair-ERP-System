@model AutoRepairERD.Models.Employee

@{
    ViewData["Title"] = "Deactivate Employee";
}

<div class="card">
    <div style="padding:4px 0">
        <h4 class="card-title">Deactivate Employee</h4>

        <p>Are you sure you want to deactivate this employee?</p>

        <dl class="row">
            <dt class="col-sm-3">Employee Code</dt>
            <dd class="col-sm-9">@Model.EmployeeCode</dd>

            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.FirstName @Model.LastName</dd>

            <dt class="col-sm-3">Designation</dt>
            <dd class="col-sm-9">@Model.Designation</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                @if (Model.IsActive == true)
                {
                    <span class="badge badge-active">Active</span>
                }
                else
                {
                    <span class="badge badge-neutral">Inactive</span>
                }
            </dd>
        </dl>

        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="EmployeeId" />
            <div style="display:flex">
                <button type="submit" class="btn-gold btn-sm">Deactivate Employee</button>
                <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
            </div>
        </form>
    </div>
</div>
