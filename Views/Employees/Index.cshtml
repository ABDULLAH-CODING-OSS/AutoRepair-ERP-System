@model IEnumerable<AutoRepairERD.Models.Employee>

@{
    ViewData["Title"] = "Employees";
}

<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="card-title mb-0">Employees</h3>
            <div>
                <a class="btn btn-outline-secondary me-2 @(ViewBag.Filter == "all" ? "active" : "")" asp-action="Index" asp-route-filter="all">All</a>
                <a class="btn btn-outline-secondary me-2 @(ViewBag.Filter == "active" ? "active" : "")" asp-action="Index" asp-route-filter="active">Active</a>
                <a class="btn btn-outline-secondary me-2 @(ViewBag.Filter == "inactive" ? "active" : "")" asp-action="Index" asp-route-filter="inactive">Inactive</a>
                <a class="btn btn-primary" asp-action="Create">New Employee</a>
            </div>
        </div>

        @if (TempData["Toast"] != null)
        {
            var toastType = (TempData["ToastType"] ?? "info").ToString();
            <div class="alert alert-@toastType alert-dismissible fade show" role="alert" id="actionToast">
                @TempData["Toast"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
            <script>
                setTimeout(function(){ var t = document.getElementById('actionToast'); if(t) t.classList.remove('show'); }, 3000);
            </script>
        }

        <div class="table-responsive">
            <table class="table table-striped table-sm">
                <thead>
                    <tr>
                        <th>Employee Code</th>
                        <th>Employee Name</th>
                        <th>CNIC</th>
                        <th>Phone</th>
                        <th>Designation</th>
                        <th class="text-end">Basic Salary</th>
                        <th class="text-end">Hourly Rate</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.EmployeeCode</td>
                            <td>@(item.FirstName + " " + (item.LastName ?? ""))</td>
                            <td>@item.Cnic</td>
                            <td>@item.Phone</td>
                            <td>@item.Designation</td>
                            <td class="text-end">@String.Format("{0:C}", item.BasicSalary ?? 0m)</td>
                            <td class="text-end">@String.Format("{0:C}", item.HourlyRate ?? 0m)</td>
                            <td>
                                @if (item.IsActive == true)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td>
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.EmployeeId">Edit</a>
                                <a class="btn btn-sm btn-outline-secondary ms-1" asp-action="Details" asp-route-id="@item.EmployeeId">Details</a>
                                @if (item.IsActive == true)
                                {
                                    <a class="btn btn-sm btn-outline-danger ms-1" asp-action="Delete" asp-route-id="@item.EmployeeId">Deactivate</a>
                                }
                                else
                                {
                                    <form asp-action="Activate" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.EmployeeId" />
                                        <button type="submit" class="btn btn-sm btn-success ms-1">Activate</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
