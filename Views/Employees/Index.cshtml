@model IEnumerable<AutoRepairERD.Models.Employee>
@{ ViewData["Title"] = "Employees"; ViewData["ActiveNav"] = "employees"; }

@section TopbarActions { <a asp-action="Create" class="btn-gold btn-sm">+ Add Employee</a> }

<div class="card">
  <div class="card-header">
    <span class="card-title">All Employees (@Model.Count())</span>
    <form method="get" style="margin-left:auto;display:flex;gap:8px;align-items:center">
      <select name="filter" class="form-control" style="padding:7px 10px">
        @if (((string)ViewBag.Filter ?? "all") == "all") { <text><option value="all" selected>All</option></text> } else { <text><option value="all">All</option></text> }
        @if (((string)ViewBag.Filter ?? "all") == "active") { <text><option value="active" selected>Active</option></text> } else { <text><option value="active">Active</option></text> }
        @if (((string)ViewBag.Filter ?? "all") == "inactive") { <text><option value="inactive" selected>Inactive</option></text> } else { <text><option value="inactive">Inactive</option></text> }
      </select>
      <button type="submit" class="btn-outline btn-sm">Filter</button>
    </form>
  </div>
  <div class="table-wrap"><table class="erp-table">
    <thead><tr><th>Code</th><th>Name</th><th>Designation</th><th>Phone</th><th>Hired</th><th>Salary</th><th>Status</th><th></th></tr></thead>
    <tbody>
      @if (!Model.Any()) { <tr><td colspan="8" class="td-muted" style="text-align:center;padding:24px">No employees yet.</td></tr> }
      @foreach (var e in Model)
      {
          <tr onclick="carTransition('/Employees/Details/@e.EmployeeId','EMPLOYEE DETAIL')">
            <td class="td-gold">@e.EmployeeCode</td>
            <td>@e.FirstName @e.LastName</td>
            <td>@e.Designation</td>
            <td>@e.Phone</td>
            <td class="td-muted">@(e.HireDate?.ToString("MMM d, yyyy"))</td>
            <td>PKR @(e.BasicSalary?.ToString("N0") ?? "—")</td>
            <td><span class="badge @BadgeHelper.Css(e.IsActive == true)">@BadgeHelper.Text(e.IsActive == true)</span></td>
            <td style="white-space:nowrap">
              <a asp-action="Details" asp-route-id="@e.EmployeeId" class="btn-outline btn-sm">View</a>
              <a asp-action="Edit" asp-route-id="@e.EmployeeId" class="btn-outline btn-sm">Edit</a>
              @if (e.IsActive == true)
              {
                  <a asp-action="Delete" asp-route-id="@e.EmployeeId" class="btn-outline btn-sm" style="color:var(--red)">Deactivate Employee</a>
              }
              else
              {
                  <form asp-action="Activate" method="post" style="display:inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@e.EmployeeId" />
                    <button type="submit" class="btn-gold btn-sm">Activate Employee</button>
                  </form>
              }
            </td>
          </tr>
      }
    </tbody>
  </table></div>
</div>
