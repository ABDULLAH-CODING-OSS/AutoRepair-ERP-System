@model AutoRepairERD.Models.Employee

@{
    ViewData["Title"] = "Edit Employee";
}

<div class="card">
    <div style="padding:4px 0">
        <h4 class="card-title">Edit Employee</h4>
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="EmployeeId" />

            <div style="margin-bottom:12px">
                <label asp-for="EmployeeCode" class="form-label"></label>
                <input asp-for="EmployeeCode" class="form-control" readonly />
                <span style="font-size:12px;color:var(--text3)">Employee Code cannot be changed</span>
            </div>

            <div style="margin-bottom:12px">
                <label asp-for="FirstName" class="form-label"></label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" style="color:var(--red)"></span>
            </div>

            <div style="margin-bottom:12px">
                <label asp-for="LastName" class="form-label"></label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" style="color:var(--red)"></span>
            </div>

            <div style="margin-bottom:12px">
                <label asp-for="Cnic" class="form-label"></label>
                <input asp-for="Cnic" class="form-control" />
                <span asp-validation-for="Cnic" style="color:var(--red)"></span>
            </div>

            <div style="margin-bottom:12px">
                <label asp-for="Phone" class="form-label"></label>
                <input asp-for="Phone" class="form-control" />
                <span asp-validation-for="Phone" style="color:var(--red)"></span>
            </div>

            <div style="margin-bottom:12px">
                <label asp-for="Address" class="form-label"></label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" style="color:var(--red)"></span>
            </div>

            <div style="margin-bottom:12px">
                <label asp-for="HireDate" class="form-label"></label>
                <input asp-for="HireDate" type="date" class="form-control" />
                <span asp-validation-for="HireDate" style="color:var(--red)"></span>
            </div>

            <div style="margin-bottom:12px">
                <label asp-for="Designation" class="form-label"></label>
                <input asp-for="Designation" class="form-control" />
                <span asp-validation-for="Designation" style="color:var(--red)"></span>
            </div>

            <div style="margin-bottom:12px">
                <label asp-for="BasicSalary" class="form-label"></label>
                <input asp-for="BasicSalary" class="form-control" />
                <span asp-validation-for="BasicSalary" style="color:var(--red)"></span>
            </div>

            <div style="margin-bottom:12px">
                <label asp-for="HourlyRate" class="form-label"></label>
                <input asp-for="HourlyRate" class="form-control" />
                <span asp-validation-for="HourlyRate" style="color:var(--red)"></span>
            </div>

            <div class="form-check mb-3">
                <input type="checkbox" asp-for="IsActive" style="accent-color:var(--gold)" />
                <label asp-for="IsActive" class="form-label">Active Employee</label>
            </div>

            <div style="display:flex">
                <button type="submit" class="btn-gold btn-sm">Save</button>
                <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
